<UserControl x:Class="LogScope.App.Logs.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:logs="clr-namespace:LogScope.App.Logs"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" MinWidth="230" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- ================= 왼쪽: IO 목록과 그룹 ================= -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel DataContext="{Binding List}">

                <!-- 검색과 필터. 진짜 컨트롤이라 그래프를 다시 그려도
                     깜빡이지 않습니다. (요구사항 3번) -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="IO 목록" Style="{StaticResource H2}"
                                       VerticalAlignment="Center" Margin="2,0,10,0" />
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" />
                        </WrapPanel>


                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="검색 지우기" Margin="4,3,0,3"
                                    Click="OnClearSearch" />
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                     ToolTip="IO 이름으로 찾습니다." />
                        </DockPanel>

                        <WrapPanel Margin="0,4,0,0">
                            <ComboBox MinWidth="118" SelectedIndex="{Binding KindFilter, Mode=TwoWay}">
                                <ComboBoxItem Content="전체 타입" />
                                <ComboBoxItem Content="디지털" />
                                <ComboBoxItem Content="아날로그" />
                                <ComboBoxItem Content="상태" />
                            </ComboBox>
                            <ComboBox MinWidth="130" SelectedIndex="{Binding ScopeFilter, Mode=TwoWay}">
                                <ComboBoxItem Content="모든 IO" />
                                <ComboBoxItem Content="고른 IO만" />
                                <ComboBoxItem Content="달라진 IO만" />
                            </ComboBox>
                        </WrapPanel>

                        <WrapPanel Margin="0,2,0,0">
                            <Button Content="전체 선택" Click="OnSelectAll" />
                            <Button Content="전체 해제" Click="OnClearAll" />
                        </WrapPanel>

                        <!--
                          그릴 로그. 두 선이 거의 같은 자리에 겹쳐 있으면 뒤에
                          그려진 쪽이 앞의 쪽을 덮습니다. 한쪽을 끄면 가려졌던
                          선이 그대로 보입니다.

                          <b>도구 줄이 아니라 여기</b>입니다. "무엇을 그릴까" 는
                          IO 를 고르는 일과 같은 종류라 이 칸이 제자리이고,
                          위 도구 줄은 두 줄을 넘지 않아야 합니다.

                          이 블록의 DataContext 는 List(IO 목록)이라, 그래프
                          뷰모델의 값은 UserControl 을 거쳐 찾습니다.

                          차이 눈금에서는 선이 하나뿐이고 두 로그가 다 필요한
                          값이라 뜻이 없습니다. 그때는 꺼져 보입니다.
                        -->
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="그릴 로그" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Margin="2,0,8,0" />
                            <CheckBox Content="이전" Margin="0,0,10,0" VerticalAlignment="Center"
                                      IsChecked="{Binding DataContext.ShowBefore,
                                                  RelativeSource={RelativeSource AncestorType=UserControl},
                                                  Mode=TwoWay}"
                                      IsEnabled="{Binding DataContext.ScaleRaw,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      ToolTip="이전 로그의 선을 그립니다.&#x0a;끄면 세로 눈금도 켜 둔 쪽에만 맞춰집니다." />
                            <CheckBox Content="이후" VerticalAlignment="Center"
                                      IsChecked="{Binding DataContext.ShowAfter,
                                                  RelativeSource={RelativeSource AncestorType=UserControl},
                                                  Mode=TwoWay}"
                                      IsEnabled="{Binding DataContext.ScaleRaw,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      ToolTip="이후 로그의 선을 그립니다.&#x0a;끄면 세로 눈금도 켜 둔 쪽에만 맞춰집니다." />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 그룹 관리. 버튼마다 무슨 기능인지 글자로 적혀 있습니다. -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.PanelAlt}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                        Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="{Binding ActiveGroupText}" Style="{StaticResource Muted}"
                                   Margin="2,0,0,4" />
                        <WrapPanel>
                            <Button Content="새 그룹 만들기" Click="OnAddGroup" />
                            <Button Content="이름 바꾸기" Click="OnRenameGroup" />
                            <Button Content="위로 옮기기" Click="OnMoveGroupUp" />
                            <Button Content="아래로 옮기기" Click="OnMoveGroupDown" />
                            <Button Content="고른 IO를 이 그룹에 담기" Click="OnPutSelected" />
                            <Button Content="그룹 삭제" Click="OnDeleteGroup" />
                            <Button Content="groups.txt 글 복사" Click="OnCopyGroupFile"
                                    ToolTip="지금 묶어 둔 그룹을 groups.txt 꼴로 클립보드에 담습니다.&#x0a;저장소의 groups.txt 에 붙여넣고 빌드하면 그 그룹으로 켜집니다." />
                        </WrapPanel>

                        <!-- 그룹이 groups.txt 로 정해져 있을 때만 나옵니다. -->
                        <TextBlock Text="{Binding GroupSourceNote}" Style="{StaticResource Muted}"
                                   FontSize="10" TextWrapping="Wrap" Margin="2,5,2,0"
                                   Visibility="{Binding GroupSourceNote,
                                                Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- 목록 본체. 줄이 수천 개여도 보이는 만큼만 만들어집니다. -->
                <ListBox x:Name="RowList" ItemsSource="{Binding Rows}"
                         ItemContainerStyle="{StaticResource PlainRow}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.Resources>

                        <!-- 그룹 이름 줄 -->
                        <DataTemplate DataType="{x:Type logs:GroupRowVm}">
                            <Border x:Name="Row" Background="{DynamicResource Brush.PanelAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                                    Padding="6,4" AllowDrop="True"
                                    MouseLeftButtonDown="OnGroupRowDown"
                                    DragOver="OnGroupDragOver"
                                    DragLeave="OnGroupDragLeave"
                                    Drop="OnGroupDrop"
                                    ToolTip="누르면 접혔다 펴집니다. IO 를 끌어다 놓으면 이 그룹에 들어갑니다.">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Path x:Name="Arrow" Grid.Column="0" VerticalAlignment="Center"
                                          Margin="2,0,7,0" Width="9" Height="9"
                                          Fill="{DynamicResource Brush.Muted}"
                                          Data="M 0 0 L 9 0 L 4.5 6 Z" />

                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0,0,7,0"
                                              IsChecked="{Binding IsAllSelected, Mode=OneWay}"
                                              Click="OnGroupCheck"
                                              ToolTip="이 그룹의 IO 를 모두 켜거나 끕니다." />

                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="3" Text="{Binding MemberText}" FontSize="11"
                                               VerticalAlignment="Center" Margin="6,0,2,0"
                                               Foreground="{DynamicResource Brush.Muted}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                    <Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 6 4.5 L 0 9 Z" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                    <Setter TargetName="Row" Property="Background"
                                            Value="{DynamicResource Brush.DropTarget}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>

                        <!-- IO 한 줄 -->
                        <DataTemplate DataType="{x:Type logs:IoRowVm}">
                            <Border x:Name="Row" Background="Transparent" Padding="22,3,6,3"
                                    MouseLeftButtonDown="OnIoRowDown"
                                    MouseMove="OnIoRowMove">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,7,0"
                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Click="OnIoCheck" />

                                    <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.Text}" />

                                    <TextBlock Grid.Column="2" Text="{Binding SideNote}" FontSize="11"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               Foreground="{DynamicResource Brush.Muted}" />

                                    <TextBlock Grid.Column="3" Text="{Binding KindText}" FontSize="11"
                                               VerticalAlignment="Center" Margin="8,0,2,0"
                                               Foreground="{DynamicResource Brush.Muted}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Row" Property="Background"
                                            Value="{DynamicResource Brush.AccentSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static logs:IoRowVm.StatusChanged}">
                                    <Setter TargetName="NameText" Property="Foreground"
                                            Value="{DynamicResource Brush.Warn}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static logs:IoRowVm.StatusOnlyBefore}">
                                    <Setter TargetName="NameText" Property="Foreground"
                                            Value="{DynamicResource Brush.Bad}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static logs:IoRowVm.StatusOnlyAfter}">
                                    <Setter TargetName="NameText" Property="Foreground"
                                            Value="{DynamicResource Brush.Good}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>

                    </ListBox.Resources>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="Transparent" />

        <!-- ================= 오른쪽: 도구 줄 + 그래프 ================= -->
        <DockPanel Grid.Column="2">

            <!--
              도구 줄.

              <b>두 줄을 넘지 않습니다.</b> WrapPanel 은 좁아지면 저절로 줄을
              바꾸는데, 단추가 많으면 다섯 줄 여섯 줄로 자라서 정작 그래프가
              들어갈 자리가 없어집니다. 그래서 세 가지를 했습니다.

                1. 글자를 줄였습니다. 무슨 뜻인지는 풍선 도움말에 적습니다.
                2. 한 번 정해 놓고 쓰는 것들(시간 맞추기)은 접어서
                   팝업으로 넘겼습니다.
                3. "무엇을 그릴까" (그릴 로그)는 <b>왼쪽 IO 칸</b>으로 옮겼습니다.
                   IO 를 고르는 일과 같은 종류라 그쪽이 제자리이고, 도구 줄은
                   그만큼 짧아집니다.

              그래도 창이 아주 좁으면 더 접힐 수 있어서, 높이 상한을 걸고
              넘치면 세로로 굴리게 했습니다. 줄 하나가 42 (단추 28 + 위아래
              여백 6 + 묶음 테두리 2) 라 두 줄이면 84 입니다. 여기에 글꼴
              차이만큼 몇 px 만 얹습니다 — 넉넉히 주면 세 번째 줄이 반쯤
              보여서 상한을 건 뜻이 없어집니다. 바깥 Border 의 안쪽 여백은
              이 상한 밖이라 더하지 않습니다.
            -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                    Padding="8,4">
                <ScrollViewer MaxHeight="88" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <WrapPanel>

                    <!--
                      무엇을 어떻게 늘어놓을지. IO 를 하나만 골랐을 때는 둘이
                      같은 그림이라, 묶음 이름에 "여러 IO 선택시" 를 적어 둡니다.
                    -->
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolGroupCaption}" Text="보기 (여러 IO 선택시)" />
                            <RadioButton GroupName="viewmode" Style="{StaticResource SegmentButton}"
                                         Content="Lane" IsChecked="{Binding LaneMode, Mode=TwoWay}"
                                         ToolTip="IO 마다 한 줄씩 따로 그립니다. 줄마다 세로 눈금이 따로라 값 크기가 달라도 각각 꽉 차게 보입니다." />
                            <RadioButton GroupName="viewmode" Style="{StaticResource SegmentButton}"
                                         Content="Overlay" IsChecked="{Binding OverlayMode, Mode=TwoWay}"
                                         ToolTip="한 판에 겹쳐 그리고 세로 눈금을 같이 씁니다. 값 크기가 비슷한 IO 끼리 견줄 때 씁니다." />
                        </StackPanel>
                    </Border>

                    <!-- 세로축을 무엇으로 읽을지 -->
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolGroupCaption}" Text="세로 눈금" />
                            <RadioButton GroupName="scale" Style="{StaticResource SegmentButton}"
                                         Content="기존 값" IsChecked="{Binding ScaleRaw, Mode=TwoWay}"
                                         ToolTip="이전 로그와 이후 로그를 각각 그립니다. 로그에 적힌 값 그대로." />
                            <RadioButton GroupName="scale" Style="{StaticResource SegmentButton}"
                                         Content="차이" IsChecked="{Binding ScaleDelta, Mode=TwoWay}"
                                         ToolTip="두 로그의 차이를 선 하나로 그립니다.&#x0a;같으면 0, 이후가 1 크면 +1, 1 작으면 -1.&#x0a;상태 채널은 이름이 같으면 0, 다르면 1 입니다.&#x0a;한쪽에만 있는 IO 는 견줄 상대가 없어 비어 있습니다." />
                        </StackPanel>
                    </Border>

                    <!--
                      가로(시간) 축.

                      + / − 는 글자가 아니라 기호라 폭이 항상 같습니다. "확대"
                      와 "축소" 처럼 글자 수가 다른 것을 나란히 두면 단추 폭이
                      들쭉날쭉해서 두 묶음이 서로 어긋나 보입니다.
                    -->
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolGroupCaption}" Text="Time Scale" />
                            <Button Content="+" Width="30" Click="OnZoomTimeIn"
                                    ToolTip="시간축 확대. 휠로도 됩니다." />
                            <Button Content="−" Width="30" Click="OnZoomTimeOut"
                                    ToolTip="시간축 축소. 휠로도 됩니다." />
                            <Button Content="초기화" Click="OnResetTime"
                                    ToolTip="전체 구간으로 되돌립니다 (Home)." />
                        </StackPanel>
                    </Border>

                    <!-- 세로(값) 축 -->
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolGroupCaption}" Text="Value Scale" />
                            <Button Content="+" Width="30" Click="OnZoomValueIn"
                                    ToolTip="값 축 확대. Shift+휠로도 됩니다." />
                            <Button Content="−" Width="30" Click="OnZoomValueOut"
                                    ToolTip="값 축 축소. Shift+휠로도 됩니다." />
                            <Button Content="초기화" Click="OnResetValueZoom"
                                    ToolTip="값 배율을 처음으로 되돌립니다." />
                            <Button Content="구간 맞춤" Click="OnFitValueOnce"
                                    ToolTip="지금 보이는 시간 구간에 세로 눈금을 한 번 맞춥니다. 그 뒤로는 그대로 둡니다." />
                            <ToggleButton Style="{StaticResource ToolToggle}" Content="계속 맞춤"
                                          IsChecked="{Binding FitVisible, Mode=TwoWay}"
                                          ToolTip="켜 두면 시간축을 밀 때마다 세로 눈금을 다시 맞춥니다. 위아래 움직임이 심하면 끄고 쓰세요." />
                        </StackPanel>
                    </Border>

                    <!-- 이전 로그와 이후 로그를 견주는 것들 -->
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolGroupCaption}" Text="비교" />
                            <!--
                              둘은 <b>같이 켜지지 않습니다.</b> 하나를 켜면 다른
                              하나가 꺼집니다 (뷰모델에서 막습니다). 벌려 놓고
                              그 사이를 칠하면, 칠해진 넓이가 "값 차이" 가 아니라
                              "값 차이 + 벌린 간격" 이 되어 눈금을 거짓말하게
                              만들기 때문입니다.

                              둘 다 끌 수는 있습니다. 켜져 있는 것을 다시 누르면
                              꺼집니다.
                            -->
                            <ToggleButton Style="{StaticResource ToolToggle}" Content="차이 영역 표시"
                                          IsChecked="{Binding ShadeDifference, Mode=TwoWay}"
                                          ToolTip="허용 오차를 넘은 구간을 칠합니다.&#x0a;[파형 분리 보기] 와 같이 켤 수 없습니다." />
                            <ToggleButton Style="{StaticResource ToolToggle}" Content="파형 분리 보기"
                                          IsChecked="{Binding SeparateTraces, Mode=TwoWay}"
                                          ToolTip="이전과 이후를 위아래로 조금 벌려 그립니다. 두 선이 겹쳐 하나로 보일 때 씁니다.&#x0a;[차이 영역 표시] 와 같이 켤 수 없습니다." />
                            <TextBlock Style="{StaticResource ToolGroupCaption}" Text="허용 오차" Margin="10,0,6,0" />
                            <TextBox Width="52"
                                     Text="{Binding RelativeTolerancePercentText, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="{Binding ToleranceHintDetail}" />
                            <TextBlock Style="{StaticResource ToolGroupCaption}" Text="%" Margin="5,0,2,0"
                                       ToolTip="{Binding ToleranceHintDetail}" />
                        </StackPanel>
                    </Border>

                    <!--
                      ================= 단계 =================

                      단계를 고르면 그 단계만 보이고, 두 로그는 그 단계의
                      <b>시작끼리</b> 맞춰집니다. 단계마다 기준 IO·값·몇 번째
                      사건을 손으로 맞출 일이 없습니다.

                      단계가 없으면 이 묶음은 아예 사라집니다 (Collapsed) —
                      눌러도 아무 일이 없는 칸이 떠 있으면 고장으로 보입니다.
                      단계를 넣는 법은 설정 [비교] 의 "단계 IO" 칸입니다.

                      [◀] [▶] 는 단계를 훑어볼 때 씁니다. 끝에서 멈춥니다 —
                      돌아가면 마지막 단계에서 [▶] 를 누른 사람이 첫 단계를
                      보게 됩니다.
                    -->
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolGroupCaption}" Text="단계" />

                            <!--
                              [?]. 단추 이름만으로는 무엇을 하는 것인지 알 수
                              없다는 말을 두 번 들었습니다. 설명이 대화나
                              README 에만 있으면 쓰는 자리에서는 못 봅니다 —
                              이 단추가 그 자리에서 답합니다.
                            -->
                            <Button Content="?" Width="22" Margin="0,0,6,0"
                                    Click="OnStepHelp"
                                    ToolTip="이 칸의 단추들이 무엇을 하는지 설명합니다." />

                            <!--
                              단계가 없어도 묶음을 숨기지 않습니다. 숨기면 이
                              기능이 있다는 것 자체를 알 수 없습니다 — 0.92 에
                              "단계 묶는 기능이 UI 에 없는 것 같다" 는 말을
                              들은 까닭입니다. 대신 단추를 잠그고 무엇을 하면
                              켜지는지 적습니다.
                            -->
                            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                                       Margin="0,0,6,0" Text="{Binding Step.NoStepText}"
                                       Visibility="{Binding Step.NoStepText, Converter={StaticResource TextToVisibility}}" />
                            <!--
                              나눠 보기. 가로가 한 줄 시간이 아니라 단계 칸
                              여러 개가 됩니다. 켜면 아래 "한 단계만 고르기"
                              는 뜻이 없어져서 잠깁니다 (모든 칸이 다 보입니다).
                            -->
                            <ToggleButton Style="{StaticResource ToolToggle}" Content="단계마다 칸으로"
                                          IsChecked="{Binding Step.SplitByStep, Mode=TwoWay}"
                                          IsEnabled="{Binding Step.HasSteps}"
                                          ToolTip="가로를 단계 칸 여러 개로 쪼개 나란히 놓습니다 — 1 단계로 맞춘 칸, 2 단계로 맞춘 칸 … 이렇게.&#x0a;칸마다 그 단계의 시작끼리 맞추므로, 공정이 중간에 늘어진 로그도 단계마다 맞아 보입니다.&#x0a;칸 폭은 단계 길이에 비례합니다. 휠을 칸 위에 올리면 그 칸만 확대됩니다." />

                            <Button Content="◀" Width="26" Click="OnStepPrev"
                                    IsEnabled="{Binding Step.CanPickNow}" ToolTip="앞 단계" />
                            <ComboBox MinWidth="150" Margin="3,0,3,0"
                                      ItemsSource="{Binding Step.Choices}"
                                      SelectedIndex="{Binding Step.PickIndex, Mode=TwoWay}"
                                      IsEnabled="{Binding Step.CanPickNow}"
                                      ToolTip="한 단계만 골라 그 구간만 봅니다. 두 로그는 그 단계의 시작끼리 맞춥니다.&#x0a;짝이 없는 단계(한쪽 로그에만 있는 단계)는 목록에 없습니다.&#x0a;[단계마다 칸으로] 를 켜면 모든 칸이 다 보이므로 잠깁니다." />
                            <Button Content="▶" Width="26" Click="OnStepNext"
                                    IsEnabled="{Binding Step.CanPickNow}" ToolTip="다음 단계" />
                            <ToggleButton Style="{StaticResource ToolToggle}" Content="눈금 0 = 단계 시작"
                                          Margin="6,0,0,0"
                                          IsChecked="{Binding Step.ZeroAtStart, Mode=TwoWay}"
                                          IsEnabled="{Binding Step.CanZeroNow}"
                                          ToolTip="한 단계를 골라 볼 때, 가로축 눈금을 그 단계 시작부터 셉니다 (0, +1초 …).&#x0a;단계를 바꿔 가며 봐도 눈금이 늘 0 에서 시작해 서로 견주기 쉽습니다.&#x0a;그림은 안 옮기고 눈금 글자만 바뀝니다.&#x0a;[단계마다 칸으로] 에서는 칸마다 이미 그 단계 시작에서 시작합니다." />
                        </StackPanel>
                    </Border>

                    <!--
                      시간 맞추기. 콤보 두 개와 입력 칸을 도구 줄에
                      펴면 그것만으로 한 줄을 다 먹습니다. 한 번 정해 놓고
                      계속 쓰는 값들이라 팝업으로 접어 둡니다.
                    -->
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel x:Name="AlignAnchor" Orientation="Horizontal">
                            <!--
                              토글이 아니라 그냥 단추입니다. 토글로 두면
                              팝업이 열린 채 그 단추를 눌렀을 때 팝업이 먼저
                              닫히면서 단추는 다시 켜져, 눌러도 안 닫히는
                              것처럼 보입니다. 열기만 맡기고 닫기는 바깥
                              누름과 [닫기] 에 맡깁니다.

                              글자 폭을 고정합니다. 상태에 따라 글이 바뀌는데
                              폭까지 바뀌면 그때마다 도구 줄이 다시 접혀
                              줄 수가 달라집니다.
                            -->
                            <Button Content="{Binding Align.Summary}" Width="146"
                                    Click="OnAlignOpen"
                                    ToolTip="특정 IO 가 어떤 값이 되는 순간으로 두 로그의 시간을 맞춥니다." />
                            <Popup x:Name="AlignPopup" PlacementTarget="{Binding ElementName=AlignAnchor}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                   Closed="OnAlignPopupClosed">
                                <logs:AlignPanel DataContext="{Binding Align}"
                                                  CloseRequested="OnAlignPanelClose" />
                            </Popup>
                        </StackPanel>
                    </Border>

                </WrapPanel>
                </ScrollViewer>
            </Border>

            <!-- 아래 띠: 커서 값과 보이는 구간 -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                    Padding="12,5">
                <StackPanel>
                    <TextBlock Text="{Binding ReadoutText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text}" />
                    <!-- 시간 맞추기 결과. 안 쓰면 줄 자체가 사라집니다. -->
                    <TextBlock Text="{Binding Align.Note}" TextWrapping="Wrap"
                               Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"
                               Visibility="{Binding Align.Note, Converter={StaticResource TextToVisibility}}" />
                    <!-- 메인 화면에서 그룹을 눌러 넘어왔을 때. 안 눌렀으면 줄이 사라집니다. -->
                    <TextBlock Text="{Binding FocusText}" TextWrapping="Wrap"
                               Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"
                               Visibility="{Binding FocusText, Converter={StaticResource TextToVisibility}}" />
                    <!-- 단계로 맞춘 결과. 안 고르면 줄 자체가 사라집니다. -->
                    <TextBlock Text="{Binding Step.Note}" TextWrapping="Wrap"
                               Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"
                               Visibility="{Binding Step.Note, Converter={StaticResource TextToVisibility}}" />
                    <!-- 마우스 쓰는 법. 도구 줄에 있던 것을 여기로 내렸습니다 —
                         거기 두면 도구 줄 한 줄을 통째로 먹었습니다. -->
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"
                               Text="휠 = 시간 확대,  Shift+휠 = 값 확대,  끌기 = 이동,  오른쪽 끌기 = 그 네모만큼 확대,  누르기 = 커서 A,  Shift+누르기 = 커서 B&#x0a;두 선이 겹쳐 보이면 왼쪽 IO 칸의 [그릴 로그] 에서 한쪽을 끄고 보세요." />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <logs:GraphCanvas x:Name="Plot" Grid.Column="0" />

                <ScrollBar Grid.Column="1" Orientation="Vertical" Minimum="0"
                           SmallChange="40" LargeChange="200"
                           Maximum="{Binding ScrollMaximum, ElementName=Plot, Mode=OneWay}"
                           ViewportSize="{Binding ScrollViewport, ElementName=Plot, Mode=OneWay}"
                           Value="{Binding VerticalOffset, ElementName=Plot, Mode=TwoWay}"
                           ToolTip="레인이 많을 때 위아래로 굴립니다." />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
