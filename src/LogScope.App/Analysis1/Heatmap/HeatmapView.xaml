<UserControl x:Class="LogScope.App.Analysis1.Heatmap.HeatmapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:common="clr-namespace:LogScope.App.Common"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="760"
             d:DataContext="{x:Static common:DesignData.Heatmap}"
             xmlns:t="clr-namespace:LogScope.App.Analysis1.Heatmap"
             xmlns:align="clr-namespace:LogScope.App.Analysis1.Align"
             xmlns:heat="clr-namespace:LogScope.App.Analysis1.Heatmap"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <DockPanel>

        <!-- 도구 줄. 좁아지면 저절로 줄바꿈됩니다. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="8,4">
            <WrapPanel>
                <TextBlock Text="{x:Static t:HeatmapTexts.Heading}" Style="{StaticResource H2}" VerticalAlignment="Center"
                           Margin="2,0,14,0" />

                <Button Content="{x:Static t:HeatmapTexts.Recalculate}" Style="{StaticResource PrimaryButton}"
                        Click="OnRecalculate" />

                <!--
                  가로를 단계로. 칸 하나가 단계 하나가 됩니다 (시간 폭 대신).
                  단계가 없으면 눌릴 수 없습니다 — 눌러도 아무 일이 없는
                  단추는 고장으로 보입니다. 왜 없는지는 옆의 ToolTip 과
                  아래 안내 줄에 적힙니다.
                -->
                <ToggleButton Style="{StaticResource ToolToggle}" Content="{x:Static t:HeatmapTexts.ByStep}"
                              Margin="12,3,3,3" Click="OnRecalculate"
                              IsChecked="{Binding ByStep, Mode=TwoWay}"
                              IsEnabled="{Binding HasSteps}"
                              ToolTip="{Binding StepHint}" />

                <TextBlock Text="{x:Static t:HeatmapTexts.BucketIndexLabel}" Style="{StaticResource FieldLabel}" Margin="12,0,8,0" />
                <ComboBox MinWidth="150" ItemsSource="{Binding BucketChoices}"
                          SelectedIndex="{Binding BucketIndex, Mode=TwoWay}"
                          IsEnabled="{Binding CanChooseSpan}" />

                <TextBlock Text="{x:Static t:HeatmapTexts.RelativeTolerancePercentLabel}" Style="{StaticResource FieldLabel}"
                           Margin="12,0,8,0" />
                <TextBox Width="64" Margin="0,3,3,3"
                         Text="{Binding RelativeTolerancePercent, UpdateSourceTrigger=LostFocus}"
                         ToolTip="{x:Static t:HeatmapTexts.RelativeTolerancePercentTip}" />

                <!-- 누르면 바로 다시 셉니다 (1.17). 전에는 켜 두고 [히트맵 다시
                     계산] 을 눌러야 반영돼서, 눌러도 아무 일이 없는 단추로 보였습니다. -->
                <ToggleButton Style="{StaticResource ToolToggle}" Content="{x:Static t:HeatmapTexts.IncludeUnchanged}"
                              IsChecked="{Binding IncludeUnchanged, Mode=TwoWay}" Margin="12,3,3,3"
                              Click="OnIncludeUnchanged" />

                <!-- 칸에 적을 숫자를 값으로 볼지 퍼센트로 볼지 -->
                <TextBlock Text="{x:Static t:HeatmapTexts.ShowValueLabel}" Style="{StaticResource FieldLabel}" Margin="12,0,10,0" />
                <RadioButton GroupName="heatunit" Style="{StaticResource SegmentButton}"
                             Content="{x:Static t:HeatmapTexts.ShowValue}" Checked="OnUnitChanged"
                             IsChecked="{Binding ShowValue, Mode=TwoWay}"
                             ToolTip="{x:Static t:HeatmapTexts.ShowValueTip}" />
                <RadioButton GroupName="heatunit" Style="{StaticResource SegmentButton}"
                             Content="{x:Static t:HeatmapTexts.ShowPercent}" Checked="OnUnitChanged"
                             IsChecked="{Binding ShowPercent, Mode=TwoWay}"
                             ToolTip="{x:Static t:HeatmapTexts.ShowPercentTip}" />

                <!--
                  시간 맞추기. 그래프 화면과 <b>같은 판</b>을 띄웁니다.
                  히트맵도 두 로그를 겹쳐 견주는 화면이라, 시간이 어긋나 있으면
                  칸 하나하나가 전부 엉뚱한 구간을 가리킵니다.
                -->
                <Button x:Name="AlignAnchor" Content="{Binding Align.Summary}" Width="146"
                        Margin="12,3,3,3" Click="OnAlignOpen"
                        ToolTip="{x:Static t:HeatmapTexts.AlignOpenTip}" />
                <Popup x:Name="AlignPopup" PlacementTarget="{Binding ElementName=AlignAnchor}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       Closed="OnAlignPopupClosed">
                    <align:AlignPanel DataContext="{Binding Align}"
                                      CloseRequested="OnAlignPanelClose" />
                </Popup>

                <TextBlock Text="{x:Static t:HeatmapTexts.WiderLabel}" Style="{StaticResource FieldLabel}" Margin="12,0,8,0" />
                <Button Content="{x:Static t:HeatmapTexts.Wider}" Click="OnWider" />
                <Button Content="{x:Static t:HeatmapTexts.Narrower}" Click="OnNarrower" />
                <Button Content="{x:Static t:HeatmapTexts.Taller}" Click="OnTaller" />
                <Button Content="{x:Static t:HeatmapTexts.Shorter}" Click="OnShorter" />
            </WrapPanel>
        </Border>

        <!-- 요약 + 색 설명 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Window}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="12,6">
            <StackPanel>
                <!-- 허용 오차를 바꾸고 아직 다시 계산하지 않았을 때만 나옵니다. -->
                <Border Background="{DynamicResource Brush.PanelAlt}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        Padding="8,4" Margin="0,0,0,6"
                        Visibility="{Binding StaleText, Converter={StaticResource TextToVisibility}}">
                    <TextBlock Text="{Binding StaleText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text}" />
                </Border>

                <!-- 한 그룹만 보고 있을 때. 그렇다고 말해 주지 않으면
                     "IO 가 왜 이것밖에 없지" 가 됩니다. -->
                <Border Background="{DynamicResource Brush.AccentSoft}"
                        BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                        CornerRadius="3" Padding="10,5" Margin="0,0,0,6"
                        Visibility="{Binding HasFocus, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding FocusText}" TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text}" />
                        <Button Grid.Column="1" Content="{x:Static t:HeatmapTexts.ClearFocus}" Click="OnClearFocus"
                                Margin="10,0,0,0" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Text}" />
                <WrapPanel Margin="0,6,0,0">
                    <Border Width="16" Height="12" Margin="0,0,6,0"
                            Background="{DynamicResource Brush.Bad}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                    <TextBlock Text="{Binding LegendText}"
                               Style="{StaticResource Muted}" Margin="0,0,18,0" />

                    <Border Width="16" Height="12" Margin="0,0,6,0"
                            Background="{DynamicResource Brush.Good}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                    <TextBlock Text="{x:Static t:HeatmapTexts.Note}" Style="{StaticResource Muted}" Margin="0,0,18,0" />

                    <Border Width="16" Height="12" Margin="0,0,6,0"
                            Background="{DynamicResource Brush.PanelAlt}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                    <TextBlock Text="{x:Static t:HeatmapTexts.Note2}" Style="{StaticResource Muted}" Margin="0,0,18,0" />

                    <!-- 쓰는 법 글("칸을 누르면 …, Ctrl+휠 = …")은 1.10 에서
                         뺐습니다. README 의 단축키 표에 그대로 있습니다. -->
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 아래 띠: 마우스가 올라간 칸의 자세한 값 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="12,5" MinHeight="28">
            <TextBlock Text="{Binding HoverText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text}" />
        </Border>

        <!--
          IO 검색 — <b>IO 이름 칸 바로 위</b> (1.10, 1.07 에는 도구 줄에 있었음).
          그래프 화면처럼 목록 바로 위에 있어야 "이 목록을 거른다" 로 읽힙니다.
          폭은 판의 이름 칸(HeatmapCanvas.NameW = 196)과 같습니다.

          그래프 IO 목록 검색과 같은 규칙 — 이름에 그 글자가 들면 (대소문자
          안 가림). 다시 계산하지 않아서 치는 대로 바로 걸러집니다.
        -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="0,3">
            <DockPanel Width="196" HorizontalAlignment="Left">
                <TextBlock DockPanel.Dock="Left" Text="{x:Static t:HeatmapTexts.Note3}" Style="{StaticResource Muted}"
                           FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0" />
                <Button DockPanel.Dock="Right" Content="{x:Static t:HeatmapTexts.ClearSearch}" Padding="6,0" Margin="2,0,4,0"
                        Click="OnClearSearch" ToolTip="{x:Static t:HeatmapTexts.ClearSearchTip}" />
                <TextBox VerticalContentAlignment="Center"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                         ToolTip="{x:Static t:HeatmapTexts.SearchTip}" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <heat:HeatmapCanvas x:Name="Map" Grid.Row="0" Grid.Column="0" />

            <ScrollBar Grid.Row="0" Grid.Column="1" Orientation="Vertical" Minimum="0"
                       SmallChange="26" LargeChange="200"
                       Maximum="{Binding VerticalMaximum, ElementName=Map, Mode=OneWay}"
                       ViewportSize="{Binding VerticalViewport, ElementName=Map, Mode=OneWay}"
                       Value="{Binding VerticalOffset, ElementName=Map, Mode=TwoWay}" />

            <ScrollBar Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Minimum="0"
                       SmallChange="58" LargeChange="400"
                       Maximum="{Binding HorizontalMaximum, ElementName=Map, Mode=OneWay}"
                       ViewportSize="{Binding HorizontalViewport, ElementName=Map, Mode=OneWay}"
                       Value="{Binding HorizontalOffset, ElementName=Map, Mode=TwoWay}" />
        </Grid>
    </DockPanel>
</UserControl>
