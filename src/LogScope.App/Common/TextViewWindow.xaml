<Window x:Class="LogScope.App.Common.TextViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:LogScope.App.Texts"
        Title="{x:Static t:CommonTexts.TextViewWindowTitle}" Width="900" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="12">
    <DockPanel Margin="12">
        <TextBlock x:Name="HeadText" DockPanel.Dock="Top" Style="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{x:Static t:CommonTexts.TextViewCopy}" MinWidth="96" Click="OnCopy" Margin="0,0,6,0" />
            <Button Content="{x:Static t:CommonTexts.TextViewSave}" MinWidth="110" Click="OnSave" Margin="0,0,6,0" />
            <Button Content="{x:Static t:CommonTexts.TextViewButton}" MinWidth="92" IsCancel="True" IsDefault="True" />
        </StackPanel>

        <!--
          읽기 전용이지만 TextBox 입니다. 글을 골라 복사할 수 있어야 합니다 —
          보여 주기만 되고 복사가 안 되면 번거롭습니다.
        -->
        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <TextBox x:Name="Body" IsReadOnly="True" FontFamily="Consolas"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent"
                     Padding="8,6" />
        </Border>
    </DockPanel>
</Window>
