<!-- 어두운 테마. 키 이름은 Light.xaml 과 하나도 빠짐없이 같아야 합니다. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Window"       Color="#FF171A1F" />
    <SolidColorBrush x:Key="Brush.Panel"        Color="#FF1F232A" />
    <SolidColorBrush x:Key="Brush.PanelAlt"     Color="#FF272C34" />
    <SolidColorBrush x:Key="Brush.Field"        Color="#FF272C34" />
    <SolidColorBrush x:Key="Brush.Border"       Color="#FF353C45" />
    <SolidColorBrush x:Key="Brush.Text"         Color="#FFE6E9ED" />
    <SolidColorBrush x:Key="Brush.Muted"        Color="#FF96A0AC" />
    <SolidColorBrush x:Key="Brush.Accent"       Color="#FF539DF5" />
    <SolidColorBrush x:Key="Brush.AccentSoft"   Color="#FF213145" />
    <SolidColorBrush x:Key="Brush.AccentText"   Color="#FF0B1522" />

    <SolidColorBrush x:Key="Brush.TopBar"       Color="#FF0C2444" />
    <SolidColorBrush x:Key="Brush.TopBarText"   Color="#FFECF1F8" />
    <SolidColorBrush x:Key="Brush.TopBarMuted"  Color="#FF8FA6C4" />
    <SolidColorBrush x:Key="Brush.TopBarActive" Color="#FF1B4E91" />
    <SolidColorBrush x:Key="Brush.TopBarHover"  Color="#FF16386A" />

    <SolidColorBrush x:Key="Brush.Good"         Color="#FF54C176" />
    <SolidColorBrush x:Key="Brush.Warn"         Color="#FFE8B339" />
    <SolidColorBrush x:Key="Brush.Bad"          Color="#FFF06A5B" />

    <SolidColorBrush x:Key="Brush.Before"       Color="#FF5AA6FF" />
    <SolidColorBrush x:Key="Brush.After"        Color="#FFFFA044" />

    <SolidColorBrush x:Key="Brush.RowHover"     Color="#FF232830" />
    <SolidColorBrush x:Key="Brush.DropTarget"   Color="#FF23405F" />
</ResourceDictionary>
