<Window x:Class="LogScope.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:common="clr-namespace:LogScope.App.Common"
        mc:Ignorable="d"
        d:DataContext="{x:Static common:DesignData.Settings}"
        xmlns:t="clr-namespace:LogScope.App.Settings"
        xmlns:settings="clr-namespace:LogScope.App.Settings"
        Title="{x:Static t:SettingsTexts.WindowTitle}" Width="760" Height="560" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="12">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="10,8">
            <Button Content="{x:Static t:SettingsTexts.Close}" HorizontalAlignment="Right" MinWidth="100" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="OnClose" />
        </Border>

        <TabControl>

            <!-- ===================== 폴더 ===================== -->
            <TabItem Header="{x:Static t:SettingsTexts.TabHeader}">
                <DockPanel Margin="14">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="{x:Static t:SettingsTexts.Note}" />

                    <Grid VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static t:SettingsTexts.BeforeFolderLabel}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                                 Text="{Binding BeforeFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="1" Grid.Column="2" Content="{x:Static t:SettingsTexts.PickBeforeFolder}" Click="OnPickBeforeFolder" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static t:SettingsTexts.AfterFolderLabel}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3"
                                 Text="{Binding AfterFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="2" Grid.Column="2" Content="{x:Static t:SettingsTexts.PickAfterFolder}" Click="OnPickAfterFolder" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static t:SettingsTexts.BeforeFileLabel}"
                                   Style="{StaticResource FieldLabel}" Margin="0,12,10,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                   Text="{Binding BeforeFile}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static t:SettingsTexts.AfterFileLabel}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                   Text="{Binding AfterFile}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                        <Button Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Content="{x:Static t:SettingsTexts.ForgetFiles}" Click="OnForgetFiles" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ===================== 표시 ===================== -->
            <TabItem Header="{x:Static t:SettingsTexts.TabHeader2}">
                <StackPanel Margin="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Static t:SettingsTexts.ThemeIndexLabel}" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeNames}"
                                  SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0"
                               Text="{x:Static t:SettingsTexts.Note2}" />
                </StackPanel>
            </TabItem>

            <!-- ===================== 비교 ===================== -->
            <TabItem Header="{x:Static t:SettingsTexts.TabHeader3}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static t:SettingsTexts.RelativeTolerancePercentTextLabel}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3"
                                 Text="{Binding RelativeTolerancePercentText, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="{x:Static t:SettingsTexts.RelativeTolerancePercentTextTip}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static t:SettingsTexts.Note3}"
                                   Style="{StaticResource Muted}" Margin="10,0,0,0" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static t:SettingsTexts.AbsoluteToleranceTextLabel}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                                 Text="{Binding AbsoluteToleranceText, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="{x:Static t:SettingsTexts.AbsoluteToleranceTextTip}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Static t:SettingsTexts.Note4}"
                                   Style="{StaticResource Muted}" Margin="10,0,0,0" />

                        <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"
                                Content="{x:Static t:SettingsTexts.ResetTolerance}" Click="OnResetTolerance" />

                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Muted}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="{x:Static t:SettingsTexts.Note5}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static t:SettingsTexts.SortMetricIndexLabel}"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Metrics}"
                                  SelectedIndex="{Binding SortMetricIndex, Mode=TwoWay}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static t:SettingsTexts.AutoAlignLabel}"
                                   Style="{StaticResource FieldLabel}" />
                        <CheckBox Grid.Row="4" Grid.Column="1" Content="{x:Static t:SettingsTexts.AutoAlign}"
                                  IsChecked="{Binding AutoAlign, Mode=TwoWay}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static t:SettingsTexts.ManualShiftTextLabel}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,3"
                                 Text="{Binding ManualShiftText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{x:Static t:SettingsTexts.ManualShiftTextTip}" />

                        <!--
                          단계 IO. 이것만 적으면 히트맵의 가로를 단계로 놓고,
                          그래프에서 단계 하나만 골라 볼 수 있습니다.
                          로그 모양이 달라 IO 하나로 안 되는 경우에는
                          StepRead.Fill 에 직접 넣는 자리가 있습니다.
                        -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{x:Static t:SettingsTexts.StepIoTextLabel}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,3"
                                 Text="{Binding StepIoText, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="{x:Static t:SettingsTexts.StepIoTextTip}" />
                        <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Muted}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="{x:Static t:SettingsTexts.Note6}" />
                    </Grid>

                    <!--
                      ================= IO 별 허용 오차 =================

                      기본값 하나로 다 보는 것이 맞지 않는 경우가 있습니다.
                      온도처럼 원래 조금씩 흔들리는 값과, 밸브 열림처럼 조금도
                      달라지면 안 되는 값에 같은 잣대를 대면 한쪽은 늘 빨갛고
                      다른 쪽은 놓칩니다.

                      칸을 비워 두면 그 자리는 기본값입니다. 0 과 빈 칸은
                      다릅니다 — 절대값 0 은 "절대 오차를 끈다", 퍼센트 0 은
                      "조금이라도 벌어지면 차이" 라는 뜻이라 둘 다 쓰는 값입니다.
                    -->
                    <TextBlock Text="{x:Static t:SettingsTexts.Heading}" Style="{StaticResource H2}" Margin="0,20,0,4" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="{x:Static t:SettingsTexts.Note7}" />

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Static t:SettingsTexts.Label}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Column="1" Text="{x:Static t:SettingsTexts.Label2}" Style="{StaticResource FieldLabel}"
                                   Margin="6,0,0,0" />
                        <TextBlock Grid.Column="2" Text="{x:Static t:SettingsTexts.Label3}" Style="{StaticResource FieldLabel}"
                                   Margin="6,0,0,0" />
                    </Grid>

                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="4" Padding="6"
                            Visibility="{Binding HasTolerances, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Tolerances}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type settings:ToleranceRowVm}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>

                                            <!--
                                              IsEditable: 로그를 안 열었으면 고를 것이
                                              없습니다. 그때도 이름을 적어 둘 수 있어야
                                              규칙을 미리 걸어 둘 수 있습니다.
                                            -->
                                            <ComboBox Grid.Column="0" IsEditable="True"
                                                      ItemsSource="{Binding DataContext.IoNames,
                                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Text="{Binding Io, UpdateSourceTrigger=LostFocus}" />
                                            <TextBox Grid.Column="1" Margin="6,0,0,0"
                                                     Text="{Binding PercentText, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="{x:Static t:SettingsTexts.PercentTextTip}" />
                                            <TextBox Grid.Column="2" Margin="6,0,0,0"
                                                     Text="{Binding AbsoluteText, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="{x:Static t:SettingsTexts.AbsoluteTextTip}" />
                                            <Button Grid.Column="3" Margin="6,0,0,0" Content="{x:Static t:SettingsTexts.RemoveTolerance}"
                                                    Click="OnRemoveTolerance" Tag="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Button HorizontalAlignment="Left" Margin="0,8,0,0" Content="{x:Static t:SettingsTexts.AddTolerance}"
                            Click="OnAddTolerance" />

                    <TextBlock Style="{StaticResource Muted}" Margin="0,16,0,0"
                               Text="{x:Static t:SettingsTexts.Note8}" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- ===================== AI 모듈 ===================== -->
            <!-- ===================== DB 도구 ===================== -->
            <TabItem Header="{x:Static t:SettingsTexts.TabHeader4}">
                <StackPanel Margin="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static t:SettingsTexts.MysqlDumpPathLabel}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3"
                                 Text="{Binding MysqlDumpPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="0" Grid.Column="2" Content="{x:Static t:SettingsTexts.PickMysqlDump}" Click="OnPickMysqlDump" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static t:SettingsTexts.DbDumpBeforeLabel}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                                 Text="{Binding DbDumpBefore, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static t:SettingsTexts.DbDumpAfterLabel}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3"
                                 Text="{Binding DbDumpAfter, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static t:SettingsTexts.Ibd2SdiPathLabel}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3"
                                 Text="{Binding Ibd2SdiPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="3" Grid.Column="2" Content="{x:Static t:SettingsTexts.PickIbd2Sdi}" Click="OnPickIbd2Sdi" />
                    </Grid>

                    <TextBlock Style="{StaticResource Muted}" Margin="0,16,0,0"
                               Text="{x:Static t:SettingsTexts.MysqldumpFrmNote}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{x:Static t:SettingsTexts.TabHeader5}">
                <StackPanel Margin="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static t:SettingsTexts.AiEnabledLabel}"
                                   Style="{StaticResource FieldLabel}" />
                        <CheckBox Grid.Row="0" Grid.Column="1" Content="{x:Static t:SettingsTexts.AiEnabled}"
                                  IsChecked="{Binding AiEnabled, Mode=TwoWay}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static t:SettingsTexts.PythonPathLabel}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                                 Text="{Binding PythonPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="1" Grid.Column="2" Content="{x:Static t:SettingsTexts.PickPython}" Click="OnPickPython" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static t:SettingsTexts.AiScriptPathLabel}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3"
                                 Text="{Binding AiScriptPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="2" Grid.Column="2" Content="{x:Static t:SettingsTexts.PickScript}" Click="OnPickScript" />
                    </Grid>

                    <TextBlock Style="{StaticResource Muted}" Margin="0,16,0,0"
                               Text="{x:Static t:SettingsTexts.Note9}" />
                </StackPanel>
            </TabItem>

            <!-- ===================== 정보 ===================== -->
            <TabItem Header="{x:Static t:SettingsTexts.TabHeader6}">
                <StackPanel Margin="14">
                    <TextBlock Text="{x:Static t:SettingsTexts.LogScopeHeading}" Style="{StaticResource H2}" />

                    <TextBox Margin="0,12,0,0" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Consolas, Courier New" Height="132"
                             Background="{DynamicResource Brush.Panel}"
                             Text="{Binding VersionText, Mode=OneWay}" />

                    <TextBlock Text="{x:Static t:SettingsTexts.Note10}" Style="{StaticResource Muted}" Margin="0,14,0,4" />
                    <TextBox IsReadOnly="True" Background="{DynamicResource Brush.Panel}"
                             Text="{Binding SettingsPath, Mode=OneWay}" />
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
