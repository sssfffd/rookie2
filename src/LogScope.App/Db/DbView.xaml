<UserControl x:Class="LogScope.App.Db.DbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogScope.App.Db"
             xmlns:db="clr-namespace:LogScope.Db;assembly=LogScope.Db"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <!--
          목록 줄. 기본 모양(ListRow)을 그대로 쓰고 마우스 설명만 답니다.
          BasedOn 을 빼면 테마의 줄 모양이 통째로 사라집니다.
          칸이 좁아 잘린 값은 짚어 보지 않으면 읽을 수가 없습니다.
        -->
        <Style x:Key="DiffRow" TargetType="{x:Type ListViewItem}"
               BasedOn="{StaticResource ListRow}">
            <Setter Property="ToolTip" Value="{Binding Tip}" />
            <!--
              줄 색. 어느 색인지는 Core 가 정합니다 (DbDiffLine.Mark) —
              어느 줄을 칠할지는 화면이 정하지 않습니다.
              색 자체는 테마에 있습니다 (밝은/어두운 테마에서 다릅니다).

              마우스 올림과 고름은 ListRow 의 템플릿 트리거가 직접 칠하므로
              이 색보다 앞섭니다 — 칠한 줄도 고르면 고른 표시가 보입니다.
            -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mark}"
                             Value="{x:Static db:DbDiffLine.MarkValue}">
                    <Setter Property="Background" Value="{DynamicResource Brush.BadSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- 위: 어디를 견주는지와 단추들 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="{Binding ScreenTitle}" Style="{StaticResource H2}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="DB 읽기" Click="OnRead" Margin="0,0,6,0"
                            ToolTip="위 두 자리를 읽어 견줍니다." />
                    <Button Content="SQL 문 출력" Click="OnShowScript" Margin="0,0,14,0"
                            ToolTip="지금 차이로 맞추는 SQL 을 만들어 창에 띄웁니다. 그 창에서 복사하거나 파일로 저장할 수 있습니다. 이 프로그램이 돌리지는 않습니다." />

                    <!--
                      맞출 방향(이전 → 이후 / 이후 → 이전) 고르기를 뺐습니다.
                      늘 "이전 → 이후" 입니다 — 이전 DB 를 이후와 같게 만드는
                      글입니다. 만든 글의 머리에 어느 방향인지 적혀 있습니다.
                    -->
                </WrapPanel>

                <!--
                  견줄 DB 두 벌. <b>메인 화면의 로그 칸과 같은 모양</b>입니다 —
                  같은 일(끌어다 놓아 자리를 정하는 것)을 두 화면에서 다르게
                  생기게 둘 이유가 없습니다.

                  칸 안의 TextBox 에 AllowDrop="False" 가 붙어 있어야 합니다.
                  TextBox 는 파일 드롭을 받지도 않고 위로 올려 보내지도 않아서,
                  그게 없으면 칸의 거의 전부가 "놓아도 아무 일 없는" 자리가
                  됩니다 (0.80 에서 겪었습니다). 메인 화면 칸은 안에 TextBox 가
                  없어서 처음부터 됐던 것입니다.
                -->
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                               Style="{StaticResource FieldLabel}" Margin="0,0,0,5"
                               Text="견줄 DB    (칸에 끌어다 놓으면 들어갑니다. 폴더도 파일도 됩니다)" />

                    <Border Grid.Row="1" Grid.Column="0" Tag="before|Brush.Window"
                            Background="{DynamicResource Brush.Window}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="4" Padding="9,7"
                            AllowDrop="True" DragOver="OnPathDragOver"
                            DragLeave="OnPathDragLeave" Drop="OnPathDrop">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{DynamicResource Brush.Before}" Margin="0,0,6,0" />
                                    <TextBlock Text="이전" FontWeight="Bold" FontSize="12"
                                               Foreground="{DynamicResource Brush.Before}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="폴더" Tag="before" Click="OnPickPath"
                                            Padding="8,1" Margin="0,0,4,0"
                                            ToolTip="폴더를 고릅니다 (그 안의 .sql / .csv / .frm 을 하위 폴더까지 읽습니다)." />
                                    <Button Content="파일" Tag="before" Click="OnPickFile"
                                            Padding="8,1"
                                            ToolTip="파일 하나를 고릅니다 (.sql 덤프 · .csv · .frm)." />
                                </StackPanel>
                            </Grid>

                            <TextBox Text="{Binding BeforePath, Mode=TwoWay}" AllowDrop="False"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="11" Margin="0,5,0,0" Padding="0"
                                     ToolTip="{Binding BeforePath}" />

                            <TextBlock Text="{Binding BeforeNote}" Style="{StaticResource Muted}"
                                       FontSize="10" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Tag="after|Brush.Window"
                            Background="{DynamicResource Brush.Window}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="4" Padding="9,7"
                            AllowDrop="True" DragOver="OnPathDragOver"
                            DragLeave="OnPathDragLeave" Drop="OnPathDrop">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{DynamicResource Brush.After}" Margin="0,0,6,0" />
                                    <TextBlock Text="이후" FontWeight="Bold" FontSize="12"
                                               Foreground="{DynamicResource Brush.After}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="폴더" Tag="after" Click="OnPickPath"
                                            Padding="8,1" Margin="0,0,4,0" />
                                    <Button Content="파일" Tag="after" Click="OnPickFile"
                                            Padding="8,1" />
                                </StackPanel>
                            </Grid>

                            <TextBox Text="{Binding AfterPath, Mode=TwoWay}" AllowDrop="False"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="11" Margin="0,5,0,0" Padding="0"
                                     ToolTip="{Binding AfterPath}" />

                            <TextBlock Text="{Binding AfterNote}" Style="{StaticResource Muted}"
                                       FontSize="10" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="{Binding PathText}" Style="{StaticResource Muted}"
                           FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                           Visibility="{Binding PathText, Converter={StaticResource TextToVisibility}}" />
                <TextBlock Text="{Binding Summary}" Margin="0,6,0,0" TextWrapping="Wrap" />

                <!-- 못 읽은 파일 같은 것. 없으면 줄 자체가 사라집니다. -->
                <TextBlock Text="{Binding Notes}" Style="{StaticResource Muted}" FontSize="11"
                           Margin="0,6,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Notes, Converter={StaticResource TextToVisibility}}" />
            </StackPanel>
        </Border>

        <!--
          왼쪽에 있던 표 목록(표 · 상태)을 없앴습니다. 차이 목록이 표
          이름을 칸으로 들고 있어서 같은 것을 두 군데서 보고 있었고,
          목록이 폭을 다 쓰는 쪽이 값을 읽기에 낫습니다.
        -->
            <!--
              차이 목록. 아래에 있던 "맞추는 SQL" 글 칸을 0.80 에서
              없앴습니다 — 목록이 창 높이를 다 쓰는 쪽이 값을 읽기에
              낫습니다. SQL 을 만드는 기능은 그대로 있습니다:
              위의 [SQL 글 저장] 이 지금 차이로 글을 만들어 파일로
              저장합니다 (화면에 띄우지만 않습니다).
            -->
                <!--
                  차이 목록. 칸마다 값 하나입니다.

                  글 한 덩이로 적던 것을 목록으로 바꿨습니다. 값이 바뀐 행은
                  바뀐 열마다 한 줄이라, 같은 열이 몇 군데서 바뀌었는지가
                  보입니다.
                -->
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.PanelAlt}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                            Padding="10,5">
                        <WrapPanel>
                            <TextBlock Text="차이 목록" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding LineText}" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="12,0,12,0" />
                            <CheckBox Content="차이가 발생한 IO만 보기"
                                      IsChecked="{Binding OnlyChanged, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,14,0"
                                      ToolTip="값이 달라진 줄(빨강 · 노랑)만 남깁니다. 생기거나 없어진 줄과 표·열 줄은 감춥니다 — 위의 세 숫자는 감춘 것까지 센 그대로입니다." />

                            <!-- 색이 무슨 뜻인지. 색만 칠해 두고 말을 안 하면 못 읽습니다. -->
                            <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.BadSoft}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                            <TextBlock Text="값이 달라진 줄" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />

                            <Button Content="목록 CSV 저장" Click="OnSaveList"
                                    ToolTip="차이 목록 전체를 칸 그대로 저장합니다 — 걸러 보는 중이어도 감춘 줄과 알림까지 다 나갑니다. 거르고 정렬하는 일은 엑셀이 이 화면보다 훨씬 잘합니다." />
                        </WrapPanel>
                    </Border>

                    <Grid>
                        <ListView x:Name="DiffList" ItemsSource="{Binding Lines}"
                                  ItemContainerStyle="{StaticResource DiffRow}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView>
                                    <!--
                                      칸 이름(머리글)은 여기 적지 않았습니다.
                                      LogScope.Core/Db/DbNames.cs 한 곳에 있고,
                                      out\config.txt 에 "db.col.v1 = 설정값" 을
                                      적으면 빌드 없이 바뀝니다. 아래 줄은
                                      "어떤 칸을 어떤 폭으로 보일지" 만 정합니다.

                                      Binding 이 아니라 x:Static 인 이유: 목록
                                      칸은 화면 나무에 없어서 Binding 이 조용히
                                      실패하고 머리글이 빈 채로 나옵니다.

                                      칸은 셋입니다 — IO명 · 이전 value ·
                                      이후 value. 0.87 에서 v1 · v2 를
                                      뺐고, 표 칸은 0.79 에서 뺐습니다.
                                      열 이름은 줄에 마우스를 올리면 뜨는
                                      글에 그대로 있습니다.
                                    -->
                                    <GridViewColumn Header="{x:Static db:DbNames.Io}" Width="360"
                                                    DisplayMemberBinding="{Binding Io}" />
                                    <GridViewColumn Header="{x:Static db:DbNames.Before}" Width="220"
                                                    DisplayMemberBinding="{Binding Before}" />
                                    <GridViewColumn Header="{x:Static db:DbNames.After}" Width="220"
                                                    DisplayMemberBinding="{Binding After}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- 비었을 때. 왜 비었는지는 그때마다 다릅니다. -->
                        <TextBlock Text="{Binding EmptyText}" Margin="16,40,16,0"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LinesIsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>

    </DockPanel>
</UserControl>
