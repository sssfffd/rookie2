<UserControl x:Class="LogScope.App.Db.DbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogScope.App.Db"
             xmlns:db="clr-namespace:LogScope.Db;assembly=LogScope.Db"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <!--
          목록 줄. 기본 모양(ListRow)을 그대로 쓰고 마우스 설명만 답니다.
          BasedOn 을 빼면 테마의 줄 모양이 통째로 사라집니다.
          칸이 좁아 잘린 값은 짚어 보지 않으면 읽을 수가 없습니다.
        -->
        <Style x:Key="DiffRow" TargetType="{x:Type ListViewItem}"
               BasedOn="{StaticResource ListRow}">
            <Setter Property="ToolTip" Value="{Binding Tip}" />
        </Style>
    </UserControl.Resources>

    <!--
      화면 전체가 끌어다 놓기를 받습니다. 두 칸(이전 · 이후)은 자기
      Drop 을 먼저 받고 e.Handled 로 멈추므로, 여기까지 올라오는 것은
      "칸 밖에 놓은 것" 뿐입니다.
    -->
    <DockPanel AllowDrop="True" DragOver="OnAnyDragOver"
               DragLeave="OnAnyDragLeave" Drop="OnAnyDrop">

        <!-- 위: 어디를 견주는지와 단추들 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="{Binding ScreenTitle}" Style="{StaticResource H2}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="DB 읽기" Click="OnRead" Margin="0,0,6,0"
                            ToolTip="위 두 자리를 읽어 견줍니다." />
                    <Button Content="SQL 글 저장" Click="OnSaveScript" Margin="0,0,14,0"
                            ToolTip="지금 차이로 맞추는 SQL 을 만들어 .sql 파일로 저장합니다. 화면에는 띄우지 않고, 이 프로그램이 돌리지도 않습니다." />

                    <!--
                      맞출 방향(이전 → 이후 / 이후 → 이전) 고르기를 뺐습니다.
                      늘 "이전 → 이후" 입니다 — 이전 DB 를 이후와 같게 만드는
                      글입니다. 만든 글의 머리에 어느 방향인지 적혀 있습니다.
                    -->
                </WrapPanel>

                <!--
                  견줄 두 자리. 정한 자리는 설정 파일에 적혀서 다음에
                  켤 때도 그대로입니다.

                  끌어다 놓기는 <b>화면 아무 데나</b> 됩니다 (0.80) —
                  칸 위에 놓으면 그 쪽, 빈 데 놓으면 비어 있는 쪽,
                  둘을 한꺼번에 놓으면 첫째가 이전 둘째가 이후입니다.
                -->
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="이전" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Before}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <!--
                      칸에 직접 타 넣거나 붙여넣어도 됩니다. 탐색기 주소 칸에서
                      복사해 오는 것이 창을 띄워 찾는 것보다 빠를 때가 많습니다.
                      폴더든 파일이든 됩니다.
                    -->
                    <Border Grid.Row="0" Grid.Column="1" Tag="before|Brush.Window"
                            Background="{DynamicResource Brush.Window}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="3" Padding="2" Margin="0,0,6,0"
                            AllowDrop="True" DragOver="OnPathDragOver"
                            DragLeave="OnPathDragLeave" Drop="OnPathDrop">
                        <!--
                          AllowDrop="False" 가 중요합니다. TextBox 는 기본으로
                          끌어다 놓기를 받고(글자를 받으려고), 파일을 놓으면
                          <b>받지도 않고 위로 올려 보내지도 않습니다.</b> 그러면
                          칸 위에 놓은 파일이 조용히 아무 일도 안 합니다 —
                          칸 넓이가 거의 이 TextBox 라서 "드래그가 안 된다" 가
                          됩니다 (0.80 에서 고쳤습니다).
                          대신 글자를 끌어다 넣는 것은 안 됩니다. 붙여넣기로 됩니다.
                        -->
                        <TextBox Text="{Binding BeforePath, Mode=TwoWay}" AllowDrop="False"
                                 BorderThickness="0" Background="Transparent"
                                 Padding="6,3" ToolTip="{Binding BeforePath}" />
                    </Border>
                    <Button Grid.Row="0" Grid.Column="2" Content="폴더" Tag="before"
                            Click="OnPickPath" Margin="0,0,4,0"
                            ToolTip="폴더를 고릅니다 (그 안의 .sql / .csv / .frm 을 하위 폴더까지 읽습니다)." />
                    <Button Grid.Row="0" Grid.Column="3" Content="파일" Tag="before"
                            Click="OnPickFile"
                            ToolTip="파일 하나를 고릅니다 (.sql 덤프 · .csv · .frm)." />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="이후" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.After}"
                               VerticalAlignment="Center" Margin="0,6,8,0" />
                    <!--
                      칸에 직접 타 넣거나 붙여넣어도 됩니다. 탐색기 주소 칸에서
                      복사해 오는 것이 창을 띄워 찾는 것보다 빠를 때가 많습니다.
                      폴더든 파일이든 됩니다.
                    -->
                    <Border Grid.Row="1" Grid.Column="1" Tag="after|Brush.Window"
                            Background="{DynamicResource Brush.Window}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="3" Padding="2" Margin="0,6,6,0"
                            AllowDrop="True" DragOver="OnPathDragOver"
                            DragLeave="OnPathDragLeave" Drop="OnPathDrop">
                        <!--
                          AllowDrop="False" 가 중요합니다. TextBox 는 기본으로
                          끌어다 놓기를 받고(글자를 받으려고), 파일을 놓으면
                          <b>받지도 않고 위로 올려 보내지도 않습니다.</b> 그러면
                          칸 위에 놓은 파일이 조용히 아무 일도 안 합니다 —
                          칸 넓이가 거의 이 TextBox 라서 "드래그가 안 된다" 가
                          됩니다 (0.80 에서 고쳤습니다).
                          대신 글자를 끌어다 넣는 것은 안 됩니다. 붙여넣기로 됩니다.
                        -->
                        <TextBox Text="{Binding AfterPath, Mode=TwoWay}" AllowDrop="False"
                                 BorderThickness="0" Background="Transparent"
                                 Padding="6,3" ToolTip="{Binding AfterPath}" />
                    </Border>
                    <Button Grid.Row="1" Grid.Column="2" Content="폴더" Tag="after"
                            Click="OnPickPath" Margin="0,6,4,0" />
                    <Button Grid.Row="1" Grid.Column="3" Content="파일" Tag="after"
                            Click="OnPickFile" Margin="0,6,0,0" />
                </Grid>

                <TextBlock Text="{Binding PathText}" Style="{StaticResource Muted}"
                           FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                           Visibility="{Binding PathText, Converter={StaticResource TextToVisibility}}" />
                <TextBlock Text="{Binding Summary}" Margin="0,6,0,0" TextWrapping="Wrap" />

                <!-- 못 읽은 파일 같은 것. 없으면 줄 자체가 사라집니다. -->
                <TextBlock Text="{Binding Notes}" Style="{StaticResource Muted}" FontSize="11"
                           Margin="0,6,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Notes, Converter={StaticResource TextToVisibility}}" />
            </StackPanel>
        </Border>

        <!--
          왼쪽에 있던 표 목록(표 · 상태)을 없앴습니다. 차이 목록이 표
          이름을 칸으로 들고 있어서 같은 것을 두 군데서 보고 있었고,
          목록이 폭을 다 쓰는 쪽이 값을 읽기에 낫습니다.
        -->
            <!--
              차이 목록. 아래에 있던 "맞추는 SQL" 글 칸을 0.80 에서
              없앴습니다 — 목록이 창 높이를 다 쓰는 쪽이 값을 읽기에
              낫습니다. SQL 을 만드는 기능은 그대로 있습니다:
              위의 [SQL 글 저장] 이 지금 차이로 글을 만들어 파일로
              저장합니다 (화면에 띄우지만 않습니다).
            -->
                <!--
                  차이 목록. 칸마다 값 하나입니다.

                  글 한 덩이로 적던 것을 목록으로 바꿨습니다. 값이 바뀐 행은
                  바뀐 열마다 한 줄이라, 같은 열이 몇 군데서 바뀌었는지가
                  보입니다.
                -->
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.PanelAlt}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                            Padding="10,5">
                        <WrapPanel>
                            <TextBlock Text="차이 목록" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding LineText}" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="12,0,12,0" />
                            <Button Content="목록 CSV 저장" Click="OnSaveList"
                                    ToolTip="지금 보이는 목록을 칸 그대로 저장합니다. 엑셀에서 거르고 정렬하는 쪽이 이 화면보다 낫습니다." />
                        </WrapPanel>
                    </Border>

                    <Grid>
                        <ListView x:Name="DiffList" ItemsSource="{Binding Lines}"
                                  ItemContainerStyle="{StaticResource DiffRow}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView>
                                    <!--
                                      칸 이름(머리글)은 여기 적지 않았습니다.
                                      LogScope.Core/Db/DbNames.cs 한 곳에 있고,
                                      out\config.txt 에 "db.col.v1 = 설정값" 을
                                      적으면 빌드 없이 바뀝니다. 아래 줄은
                                      "어떤 칸을 어떤 폭으로 보일지" 만 정합니다.

                                      Binding 이 아니라 x:Static 인 이유: 목록
                                      칸은 화면 나무에 없어서 Binding 이 조용히
                                      실패하고 머리글이 빈 채로 나옵니다.

                                      표 · 열 칸은 0.79 에서 뺐습니다. 값만
                                      보시겠다고 해서입니다. 그 둘이 아주
                                      없어진 것은 아닙니다 — 줄에 마우스를
                                      올리면 뜨는 글(Tip)에 표 이름과 열
                                      이름이 그대로 들어 있고, [목록 CSV 저장]
                                      으로 뽑은 CSV 에도 칸으로 남아 있습니다.
                                      다시 보이게 하려면 아래에 한 줄
                                      더하면 됩니다.
                                    -->
                                    <GridViewColumn Header="{x:Static db:DbNames.Io}" Width="340"
                                                    DisplayMemberBinding="{Binding Io}" />
                                    <GridViewColumn Header="{x:Static db:DbNames.Before}" Width="170"
                                                    DisplayMemberBinding="{Binding Before}" />
                                    <GridViewColumn Header="{x:Static db:DbNames.After}" Width="170"
                                                    DisplayMemberBinding="{Binding After}" />
                                    <GridViewColumn Header="{x:Static db:DbNames.V1}" Width="110"
                                                    DisplayMemberBinding="{Binding V1}" />
                                    <GridViewColumn Header="{x:Static db:DbNames.V2}" Width="110"
                                                    DisplayMemberBinding="{Binding V2}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- 비었을 때. 왜 비었는지는 그때마다 다릅니다. -->
                        <TextBlock Text="{Binding EmptyText}" Margin="16,40,16,0"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LinesIsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>

    </DockPanel>
</UserControl>
