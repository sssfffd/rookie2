<UserControl x:Class="LogScope.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <Grid Margin="10,8,10,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 머리 줄. 좁아지면 아래로 줄바꿈되므로 글자끼리 겹치지 않습니다. -->
        <WrapPanel Grid.Row="0" Margin="6,4,6,2">
            <TextBlock Text="대시보드" Style="{StaticResource H1}" Margin="0,0,16,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding Files}" Style="{StaticResource Muted}" Margin="0,0,16,0" />
        </WrapPanel>

        <TextBlock Grid.Row="1" Text="{Binding Warning}" Margin="6,2,6,2" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Bad}">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Warning}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 네모 칸 요약. 창이 좁아지면 아래 줄로 넘어갑니다. -->
        <WrapPanel Grid.Row="2" Margin="0,4,0,6">

            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="이전 로그 IO 개수" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding BeforeCount}" Style="{StaticResource TileValue}" Margin="0,4,0,4" />
                    <TextBlock Text="{Binding BeforeNote}" TextWrapping="Wrap" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BeforeNoteBad}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="이후 로그 IO 개수" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding AfterCount}" Style="{StaticResource TileValue}" Margin="0,4,0,4" />
                    <TextBlock Text="{Binding AfterNote}" TextWrapping="Wrap" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AfterNoteGood}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Good}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="차이 발생 IO 개수" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding ChangedCount}" Style="{StaticResource TileValue}"
                               Margin="0,4,0,4" Foreground="{DynamicResource Brush.Warn}" />
                    <TextBlock Text="{Binding ChangedNote}" Style="{StaticResource Muted}" FontSize="11" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="표본 수 (이전 / 이후)" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding SampleCount}" Style="{StaticResource TileValue}" Margin="0,4,0,4" />
                    <TextBlock Text="{Binding SampleNote}" Style="{StaticResource Muted}" FontSize="11" />
                </StackPanel>
            </Border>

        </WrapPanel>

        <!-- 아래쪽: 차이가 난 IO 목록 + 한쪽에만 있는 IO 목록 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="120" />
                <RowDefinition Height="6" />
                <RowDefinition Height="2*" MinHeight="90" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SectionBox}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.PanelAlt}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <TextBlock Style="{StaticResource SectionCaption}"
                                   Text="차이가 난 IO 목록   (한 줄을 누르면 그래프 화면으로, 제목 칸을 누르면 그 기준으로 정렬)" />
                    </Border>
                    <Grid>
                        <!-- 제목 칸을 누르면 그 기준으로 정렬됩니다.
                             같은 칸을 다시 누르면 방향이 뒤집힙니다. -->
                        <ListView x:Name="ChangedList" ItemsSource="{Binding Changed}"
                                  SelectionChanged="OnChangedSelected"
                                  GridViewColumnHeader.Click="OnHeaderClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="230"
                                                    Header="{Binding ColName}"
                                                    HeaderTemplate="{StaticResource SortHeader}"
                                                    DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Width="90"
                                                    Header="{Binding ColKind}"
                                                    HeaderTemplate="{StaticResource SortHeader}"
                                                    DisplayMemberBinding="{Binding Kind}" />
                                    <GridViewColumn Width="100"
                                                    Header="{Binding ColMax}"
                                                    HeaderTemplate="{StaticResource SortHeader}"
                                                    DisplayMemberBinding="{Binding MaxAbs}" />
                                    <GridViewColumn Width="100"
                                                    Header="{Binding ColMean}"
                                                    HeaderTemplate="{StaticResource SortHeader}"
                                                    DisplayMemberBinding="{Binding MeanAbs}" />
                                    <GridViewColumn Width="90"
                                                    Header="{Binding ColRms}"
                                                    HeaderTemplate="{StaticResource SortHeader}"
                                                    DisplayMemberBinding="{Binding Rms}" />
                                    <GridViewColumn Width="110"
                                                    Header="{Binding ColArea}"
                                                    HeaderTemplate="{StaticResource SortHeader}"
                                                    DisplayMemberBinding="{Binding Area}" />
                                    <GridViewColumn Width="95"
                                                    Header="{Binding ColTime}"
                                                    HeaderTemplate="{StaticResource SortHeader}"
                                                    DisplayMemberBinding="{Binding TimeRatio}" />
                                    <GridViewColumn Width="90"
                                                    Header="{Binding ColSegments}"
                                                    HeaderTemplate="{StaticResource SortHeader}"
                                                    DisplayMemberBinding="{Binding Segments}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Text="{Binding ChangedEmptyText}"
                                   Margin="16,40,16,0" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChangedIsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SectionBox}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.PanelAlt}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                            <TextBlock Style="{StaticResource SectionCaption}"
                                       Text="이전 로그에만 있는 IO" />
                        </Border>
                        <Grid>
                            <ListBox x:Name="OnlyBeforeList" ItemsSource="{Binding OnlyBefore}"
                                     SelectionChanged="OnOnlySelected" />
                            <TextBlock Text="없음" Style="{StaticResource Muted}" Margin="12,10,0,0"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding OnlyBefore.Count, Converter={StaticResource ZeroToVisible}}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SectionBox}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.PanelAlt}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                            <TextBlock Style="{StaticResource SectionCaption}"
                                       Text="이후 로그에만 있는 IO" />
                        </Border>
                        <Grid>
                            <ListBox x:Name="OnlyAfterList" ItemsSource="{Binding OnlyAfter}"
                                     SelectionChanged="OnOnlySelected" />
                            <TextBlock Text="없음" Style="{StaticResource Muted}" Margin="12,10,0,0"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding OnlyAfter.Count, Converter={StaticResource ZeroToVisible}}" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
