<Window x:Class="LogScope.App.Views.SavedResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="저장된 분석" Width="620" SizeToContent="Height"
        MinWidth="480" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="12">

    <StackPanel Margin="20,16,20,16">

        <TextBlock x:Name="NameText" Text="—" Style="{StaticResource H1}" />
        <TextBlock x:Name="SavedAtText" Text="—" Style="{StaticResource Muted}" Margin="0,2,0,0" />

        <!-- 그때 견준 로그 -->
        <Border Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                CornerRadius="5" Padding="16,12" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="그때 견준 로그" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Top"
                            Background="{DynamicResource Brush.Before}" Margin="0,4,8,0" />
                    <TextBlock Text="이전" Width="34" Foreground="{DynamicResource Brush.Muted}"
                               VerticalAlignment="Top" Margin="0,1,0,0" />
                    <StackPanel>
                        <TextBlock x:Name="BeforeNameText" Text="—" TextWrapping="Wrap" />
                        <TextBlock x:Name="BeforePathText" Text="" Style="{StaticResource Muted}"
                                   FontSize="10" TextWrapping="Wrap" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Top"
                            Background="{DynamicResource Brush.After}" Margin="0,4,8,0" />
                    <TextBlock Text="이후" Width="34" Foreground="{DynamicResource Brush.Muted}"
                               VerticalAlignment="Top" Margin="0,1,0,0" />
                    <StackPanel>
                        <TextBlock x:Name="AfterNameText" Text="—" TextWrapping="Wrap" />
                        <TextBlock x:Name="AfterPathText" Text="" Style="{StaticResource Muted}"
                                   FontSize="10" TextWrapping="Wrap" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 그때의 점수 셋 -->
        <Border Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                CornerRadius="5" Padding="16,12" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="그때의 점수" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                <UniformGrid Rows="1" Columns="3">
                    <StackPanel>
                        <TextBlock Text="분석 1" Style="{StaticResource Muted}" FontSize="11" />
                        <TextBlock x:Name="Score1Text" Text="??" FontSize="26" FontWeight="Bold"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="분석 2" Style="{StaticResource Muted}" FontSize="11" />
                        <TextBlock x:Name="Score2Text" Text="??" FontSize="26" FontWeight="Bold"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="분석 3" Style="{StaticResource Muted}" FontSize="11" />
                        <TextBlock x:Name="Score3Text" Text="??" FontSize="26" FontWeight="Bold"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </UniformGrid>
                <TextBlock x:Name="CountsText" Text="—" Style="{StaticResource Muted}"
                           Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="BasisText" Text="—" Style="{StaticResource Muted}"
                           FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 현재 분석과 비교. 단추만 있고 안은 아직 비어 있습니다. -->
        <Border Background="{DynamicResource Brush.PanelAlt}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                CornerRadius="5" Padding="16,12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="이 기록을 지금 분석과 나란히 놓고 봅니다."
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="CompareNote" Text="미구현" Style="{StaticResource Muted}"
                               FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                        Content="현재 분석과 비교" Click="OnCompare" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="닫기" Click="OnClose" MinWidth="86" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
