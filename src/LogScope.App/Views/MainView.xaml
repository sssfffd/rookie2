<UserControl x:Class="LogScope.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogScope.App.ViewModels"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- 아주 넓은 화면에서 칸이 끝없이 늘어나지 않게 가둡니다. -->
        <StackPanel Margin="20,16,20,22" MaxWidth="1180" HorizontalAlignment="Stretch">

            <!-- ===== 종합 분석 결과 =====
                 전에 "열어 둔 로그" 가 있던 자리입니다. 로그 칸은 분석 1 안으로
                 들어갔습니다 : 로그를 여는 일은 분석 1 의 준비이고, 메인 화면이
                 먼저 답해야 하는 것은 "그래서 결과가 어떤가" 입니다.

                 IO 개수는 여기에 두지 않습니다. 0.59 에 분석 1 칸에서 여기로
                 옮겼다가 0.63 에 아예 뺐습니다 — 같은 수가 대시보드에도
                 있어서, 세는 자리는 거기 한 곳이면 됩니다. 이 칸은 "그래서
                 어떤가" 한 줄과 그 판정의 기준만 적습니다.
            -->
            <Border Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="5" Padding="18,14" Margin="6,0,6,16">
                <StackPanel>
                    <TextBlock Text="종합 분석 결과" Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,8" />

                    <!-- 판정 한 줄. 점 색은 점수 색과 같은 뜻입니다. -->
                    <StackPanel Orientation="Horizontal">
                        <Border Width="12" Height="12" CornerRadius="6"
                                VerticalAlignment="Center" Margin="0,0,10,0">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <!-- 안 견준 상태는 회색 그대로. 안 재 본 것에
                                         색을 칠하면 재 본 것으로 읽힙니다. -->
                                    <Setter Property="Background" Value="{DynamicResource Brush.Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverallGrade}" Value="{x:Static vm:ScoreBands.GradeGood}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Good}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverallGrade}" Value="{x:Static vm:ScoreBands.GradeWarn}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Warn}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverallGrade}" Value="{x:Static vm:ScoreBands.GradeBad}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Bad}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding OverallHeadline}" FontSize="22" FontWeight="Bold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- 어느 기준으로 본 결과인지. 기준이 없으면 "달라진 데가
                         있다" 가 무엇을 넘었다는 말인지 알 수 없습니다. -->
                    <TextBlock Text="{Binding OverallBasis}" Style="{StaticResource Muted}"
                               FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding OverallBasis, Converter={StaticResource TextToVisibility}}" />

                    <TextBlock Text="{Binding ComparedText}" Style="{StaticResource Muted}"
                               FontSize="11" Margin="0,3,0,0"
                               Visibility="{Binding ComparedText, Converter={StaticResource TextToVisibility}}" />

                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>

            </Border>

            <TextBlock Text="분석 결과" Style="{StaticResource H1}" Margin="2,4,0,8" />

            <!--
              분석 칸. 셋을 <b>가로로</b> 나란히 놓고 폭을 똑같이 나눕니다.

              WrapPanel 이 아니라 UniformGrid 인 이유가 있습니다. WrapPanel 은
              좁아지면 한 칸이 아래로 내려가 2+1 로 접힙니다. 셋이 나란히
              있어야 견줘 보이는 것이라, 좁아지면 다 같이 좁아지는 편이
              낫습니다.

              칸 전체가 단추입니다. 요청은 "점수를 누르면" 이었지만 점수만
              눌리게 하면 과녁이 너무 작습니다. 칸 어디를 눌러도 같은 자리로
              갑니다 — 점수도 그 안에 들어 있습니다.
            -->
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AnalysisCardVm}">
                        <!--
                          칸 전체가 단추이던 것을 되돌렸습니다. 칸 안에 누를
                          것(그룹 줄)이 생겼는데, 바깥까지 단추면 그룹을 누른
                          손이 칸도 같이 누릅니다. 이동은 오른쪽 위 화살표만
                          맡습니다.
                        -->
                        <!--
                          MinHeight 로 칸의 바닥 높이를 정합니다. UniformGrid 는
                          셋의 높이를 맞추므로 한 칸만 커져도 셋이 같이
                          커집니다. 가로로는 안 늘립니다 (가로는 화면 폭이
                          정합니다).

                          0.59 에 480 으로 뒀다가 0.65 에 390 으로 줄였습니다.
                          480 이면 1080 짜리 화면에서 메인 화면에 스크롤이
                          생겼습니다 — 한 화면에 다 들어오는 쪽이 "한눈에
                          본다" 는 이 화면의 뜻에 맞습니다. 요약이 길면
                          칸 안에서 굴립니다.
                        -->
                        <Border Background="{DynamicResource Brush.Panel}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="5" Padding="16,12" Margin="6" MinHeight="390">
                            <StackPanel>

                                <!-- 번호표 · 이름 · 이동 화살표 -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource Brush.AccentSoft}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            CornerRadius="3" Padding="7,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}" FontSize="11"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   FontWeight="SemiBold" />
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource H2}"
                                               VerticalAlignment="Center" Margin="9,0,6,0"
                                               TextTrimming="CharacterEllipsis" />

                                    <Button Grid.Column="2" Style="{StaticResource ArrowButton}"
                                            Content="↗" Click="OnCardClick" Tag="{Binding Number}"
                                            VerticalAlignment="Top"
                                            ToolTip="이 분석 화면으로 넘어갑니다." />
                                </Grid>

                                <!-- 점수 -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ScoreText" Text="{Binding ScoreText}"
                                               FontSize="34" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               VerticalAlignment="Bottom" />
                                    <TextBlock Text="{Binding ScoreOutOf}" FontSize="16" Margin="6,0,0,7"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Text="{Binding ScoreNote}" Style="{StaticResource Muted}"
                                           FontSize="11" Margin="0,1,0,0" />

                                <!-- 그 분석이 실제로 센 숫자들 -->
                                <ItemsControl ItemsSource="{Binding Stats}" Margin="0,12,0,0"
                                              Visibility="{Binding HasStats, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:StatVm}">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}"
                                                           FontSize="11" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Value}" FontSize="16"
                                                           FontWeight="SemiBold" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource Brush.Text}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- ===== 이 분석이 쓰는 로그 (분석 1 만) =====
                                     전에는 메인 화면 맨 위에 크게 있었습니다. 로그를
                                     여는 일은 이 분석의 준비라서 여기로 들였습니다.

                                     칸 자체가 놓을 자리입니다 (왼쪽 이전 / 오른쪽 이후).
                                     작아졌지만 과녁은 글자 줄이 아니라 여전히 칸
                                     전체입니다 — 그게 31~32 에서 고친 자리입니다.

                                     칸 안이라 DataContext 가 이 칸(AnalysisCardVm)
                                     입니다. 로그 정보는 화면(MainVm)에 있으므로
                                     DataContext 를 거슬러 올라가 읽습니다.
                                -->
                                <Grid Margin="0,12,0,0"
                                      Visibility="{Binding HasLogBox, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,5"
                                               Text="로그    (칸에 끌어다 놓으면 열립니다)" />

                                    <Border Grid.Row="1" Grid.Column="0" Tag="before|Brush.Window"
                                            Background="{DynamicResource Brush.Window}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            CornerRadius="4" Padding="9,7"
                                            ToolTip="{Binding DataContext.BeforePath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            AllowDrop="True" DragOver="OnLogRowDragOver"
                                            DragLeave="OnLogRowDragLeave" Drop="OnLogRowDrop">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                                        Background="{DynamicResource Brush.Before}" Margin="0,0,6,0" />
                                                <TextBlock Text="이전" FontWeight="Bold" FontSize="12"
                                                           Foreground="{DynamicResource Brush.Before}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DataContext.BeforeTime, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Style="{StaticResource Muted}" FontSize="10"
                                                           Margin="6,1,0,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding DataContext.BeforeFileName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       FontSize="11" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DataContext.BeforeText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       Style="{StaticResource Muted}" FontSize="10"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="2" Tag="after|Brush.Window"
                                            Background="{DynamicResource Brush.Window}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            CornerRadius="4" Padding="9,7"
                                            ToolTip="{Binding DataContext.AfterPath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            AllowDrop="True" DragOver="OnLogRowDragOver"
                                            DragLeave="OnLogRowDragLeave" Drop="OnLogRowDrop">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                                        Background="{DynamicResource Brush.After}" Margin="0,0,6,0" />
                                                <TextBlock Text="이후" FontWeight="Bold" FontSize="12"
                                                           Foreground="{DynamicResource Brush.After}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DataContext.AfterTime, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Style="{StaticResource Muted}" FontSize="10"
                                                           Margin="6,1,0,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding DataContext.AfterFileName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       FontSize="11" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DataContext.AfterText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       Style="{StaticResource Muted}" FontSize="10"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- ===== 이 분석의 요약 (그룹별) =====
                                     줄을 누르면 그 그룹의 IO 만 히트맵에 남깁니다. -->
                                <Border Background="{DynamicResource Brush.Window}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                        CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="요약" Style="{StaticResource FieldLabel}"
                                                   Margin="0,0,0,5" />

                                        <TextBlock Text="{Binding GroupNote}" Style="{StaticResource Muted}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Visibility="{Binding GroupNote, Converter={StaticResource TextToVisibility}}" />

                                        <!--
                                          그룹이 많아도 칸이 늘어나지 않게 여기서 굴립니다.
                                          한 줄이 두 줄짜리가 됐습니다 (이름 17 + 차이 내용 16
                                          + 위아래 여백 5 = 38). 여섯 줄이 230 이고,
                                          일곱 번째가 살짝 보여 더 있다는 것이 드러납니다.
                                          0.59 의 300 에서 줄였습니다 (메인 화면에
                                          스크롤이 생기지 않게).
                                        -->
                                        <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Visibility="{Binding HasGroups, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl ItemsSource="{Binding Groups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:GroupSummaryVm}">
                                                        <Button Style="{StaticResource RowButton}"
                                                                Click="OnGroupClick" Tag="{Binding GroupName}"
                                                                IsEnabled="{Binding CanOpen}"
                                                                ToolTip="이 그룹의 IO 만 히트맵에서 봅니다."
                                                                Margin="0,1,0,3">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border x:Name="Dot" Grid.Column="0"
                                                                            Width="8" Height="8" CornerRadius="4"
                                                                            VerticalAlignment="Center" Margin="0,0,7,0"
                                                                            Background="{DynamicResource Brush.Muted}" />

                                                                    <TextBlock Grid.Column="1" Text="{Binding GroupName}"
                                                                               VerticalAlignment="Center" FontSize="12"
                                                                               TextTrimming="CharacterEllipsis" />

                                                                    <TextBlock Grid.Column="2" Text="{Binding CountText}"
                                                                               Style="{StaticResource Muted}" FontSize="11"
                                                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                </Grid>

                                                                <!--
                                                                  그룹 줄 아래: 어떤 차이가 났는지.
                                                                  아직 자리만 잡아 둔 것입니다. 미리 잡아 두는 이유는
                                                                  나중에 글이 들어올 때 줄 높이가 달라져 목록이 통째로
                                                                  다시 접히지 않게 하려는 것입니다. 점 자리(15)만큼
                                                                  들여 써서 그룹 이름 아래에 붙게 합니다.
                                                                -->
                                                                <TextBlock Text="{Binding DetailText}"
                                                                           Style="{StaticResource Muted}" FontSize="10"
                                                                           TextWrapping="Wrap" MinHeight="14"
                                                                           Margin="15,2,0,0" />
                                                            </StackPanel>
                                                        </Button>

                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Grade}" Value="{x:Static vm:ScoreBands.GradeGood}">
                                                                <Setter TargetName="Dot" Property="Background"
                                                                        Value="{DynamicResource Brush.Good}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Grade}" Value="{x:Static vm:ScoreBands.GradeWarn}">
                                                                <Setter TargetName="Dot" Property="Background"
                                                                        Value="{DynamicResource Brush.Warn}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Grade}" Value="{x:Static vm:ScoreBands.GradeBad}">
                                                                <Setter TargetName="Dot" Property="Background"
                                                                        Value="{DynamicResource Brush.Bad}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <DataTemplate.Triggers>
                            <!-- 점수 색은 화면 아래의 색 설명과 같은 값을 봅니다
                                 (ScoreBands). 아직 안 재 본 "??" 는 회색 그대로 —
                                 안 재 본 값에 색을 칠하면 재 본 값으로 읽힙니다. -->
                            <DataTrigger Binding="{Binding Grade}" Value="{x:Static vm:ScoreBands.GradeGood}">
                                <Setter TargetName="ScoreText" Property="Foreground"
                                        Value="{DynamicResource Brush.Good}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Grade}" Value="{x:Static vm:ScoreBands.GradeWarn}">
                                <Setter TargetName="ScoreText" Property="Foreground"
                                        Value="{DynamicResource Brush.Warn}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Grade}" Value="{x:Static vm:ScoreBands.GradeBad}">
                                <Setter TargetName="ScoreText" Property="Foreground"
                                        Value="{DynamicResource Brush.Bad}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== 저장된 분석 =====
                 지금 결과를 남겨 두고, 다음에 분석했을 때 지난번과 얼마나
                 달라졌는지 봅니다. -->
            <Border Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="5" Padding="18,14" Margin="6,14,6,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="저장된 분석" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding HistoryNote}" Style="{StaticResource Muted}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,3,12,0" />
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                Content="지금 결과 저장" Click="OnSaveResult"
                                IsEnabled="{Binding CanSave}" VerticalAlignment="Top"
                                ToolTip="{Binding HistoryFolder}" />
                    </Grid>

                    <!--
                      세 줄까지만 보이고 그 다음부터는 이 칸 안에서 굴립니다.
                      기록이 쌓일수록 메인 화면이 끝없이 길어지면 아래 요약
                      칸이 화면 밖으로 밀려납니다.

                      줄 하나가 약 66 (이름 17 + 파일 15 + 기준 14 + 위아래
                      여백 16 + 줄 사이 선 1 + 여유 3) 이라 셋이면 198 입니다.
                      네 번째 줄이 살짝 보여야 "더 있다" 는 것이 눈에 띄므로
                      210 으로 둡니다.
                    -->
                    <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HistoryRowVm}">
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                                        Padding="0,6,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                          줄 전체가 단추입니다. 누르면 그때의
                                          기록을 펼쳐 보는 창이 뜹니다.
                                          [삭제] 는 이 단추 <b>밖</b>에 둡니다 —
                                          안에 넣으면 삭제를 눌러도 바깥 단추의
                                          Click 까지 같이 올라갑니다.
                                        -->
                                        <Button Grid.Column="0" Style="{StaticResource RowButton}"
                                                Click="OnOpenSaved" Tag="{Binding Id}"
                                                ToolTip="{Binding PathsText}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="200" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 언제 것인지, 무엇을 견줬는지 -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                            Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding LogsText}" Style="{StaticResource Muted}"
                                                               FontSize="11" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding BasisText}" Style="{StaticResource Muted}"
                                                               FontSize="10" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- 그때의 점수 셋과 수 -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                            Margin="0,0,18,0">
                                                    <TextBlock Text="{Binding ScoreText}" FontSize="14"
                                                               FontWeight="SemiBold" HorizontalAlignment="Right"
                                                               ToolTip="분석 1 / 2 / 3" />
                                                    <TextBlock Text="{Binding CountsText}" Style="{StaticResource Muted}"
                                                               FontSize="11" HorizontalAlignment="Right"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- 지금 결과와의 차이 -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="170"
                                                            Visibility="{Binding HasDelta, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock x:Name="DeltaText" Text="{Binding DeltaText}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource Brush.Muted}" />
                                                    <TextBlock Text="{Binding BasisWarning}" Style="{StaticResource Muted}"
                                                               FontSize="10" HorizontalAlignment="Right"
                                                               TextWrapping="Wrap" TextAlignment="Right"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding BasisWarning, Converter={StaticResource TextToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <Button Grid.Column="1" Content="삭제" Click="OnDeleteSaved"
                                                Tag="{Binding Id}" VerticalAlignment="Center"
                                                Margin="8,3,0,3" />
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <!-- 달라진 IO 가 늘면 나쁨입니다 — 지난번보다
                                         어긋난 곳이 많아졌다는 뜻이니까요. -->
                                    <DataTrigger Binding="{Binding DeltaKind}" Value="{x:Static vm:HistoryRowVm.DeltaBad}">
                                        <Setter TargetName="DeltaText" Property="Foreground"
                                                Value="{DynamicResource Brush.Bad}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeltaKind}" Value="{x:Static vm:HistoryRowVm.DeltaGood}">
                                        <Setter TargetName="DeltaText" Property="Foreground"
                                                Value="{DynamicResource Brush.Good}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeltaKind}" Value="{x:Static vm:HistoryRowVm.DeltaSame}">
                                        <Setter TargetName="DeltaText" Property="Foreground"
                                                Value="{DynamicResource Brush.Text}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Grid Margin="4,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource Muted}" FontSize="11"
                           TextWrapping="Wrap" VerticalAlignment="Bottom" MaxWidth="520"
                           Text="점수를 매기는 규칙은 아직 정해지지 않았습니다. 지금은 Log 파일을 비교한 후에 100 점으로 둡니다." />

                <!-- 점수 색 설명. 작게, 오른쪽 아래에. -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="20,0,0,0">
                    <TextBlock Text="점수 색" Style="{StaticResource Muted}" FontSize="10"
                               HorizontalAlignment="Right" Margin="0,0,0,3" />
                    <ItemsControl ItemsSource="{Binding Bands}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BandVm}">
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                    <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4"
                                            VerticalAlignment="Center" Margin="0,0,6,0"
                                            Background="{DynamicResource Brush.Muted}" />
                                    <TextBlock Text="{Binding RangeText}" FontSize="10" Width="52"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Meaning}" FontSize="10"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Grade}" Value="{x:Static vm:ScoreBands.GradeGood}">
                                        <Setter TargetName="Dot" Property="Background"
                                                Value="{DynamicResource Brush.Good}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Grade}" Value="{x:Static vm:ScoreBands.GradeWarn}">
                                        <Setter TargetName="Dot" Property="Background"
                                                Value="{DynamicResource Brush.Warn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Grade}" Value="{x:Static vm:ScoreBands.GradeBad}">
                                        <Setter TargetName="Dot" Property="Background"
                                                Value="{DynamicResource Brush.Bad}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
