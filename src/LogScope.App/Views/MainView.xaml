<UserControl x:Class="LogScope.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogScope.App.ViewModels"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- 아주 넓은 화면에서 칸이 끝없이 늘어나지 않게 가둡니다. -->
        <StackPanel Margin="20,16,20,22" MaxWidth="1180" HorizontalAlignment="Stretch">

            <!-- ===== 지금 열어 둔 로그 =====
                 이 정보가 아래 알림 줄 한 줄에만 있었습니다. 메인 화면이라면
                 "지금 무엇을 보고 있는가" 가 제일 먼저 보여야 합니다. -->
            <Border Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="5" Padding="18,13" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="열어 둔 로그" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />

                        <!--
                          발생시간은 파일 이름 앞부분을 그대로 떼어 온 것입니다.
                          로그 안에는 "이게 언제 것인가" 가 적혀 있지 않아서,
                          이름에 날짜를 붙이는 관행을 그대로 씁니다.
                          잘라 보여 주므로 전체 경로는 풍선 도움말에 둡니다.
                        -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3"
                                    ToolTip="{Binding BeforePath}">
                            <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.Before}" Margin="0,0,8,0" />
                            <TextBlock Text="이전" Width="34" Foreground="{DynamicResource Brush.Muted}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="발생시간" Foreground="{DynamicResource Brush.Muted}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,1,6,0" />
                            <TextBlock Text="{Binding BeforeTime}" FontWeight="SemiBold" MinWidth="104"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding BeforeText}" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" ToolTip="{Binding AfterPath}">
                            <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.After}" Margin="0,0,8,0" />
                            <TextBlock Text="이후" Width="34" Foreground="{DynamicResource Brush.Muted}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="발생시간" Foreground="{DynamicResource Brush.Muted}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,1,6,0" />
                            <TextBlock Text="{Binding AfterTime}" FontWeight="SemiBold" MinWidth="104"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding AfterText}" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- 지금 보고 있는 결과가 언제 나온 것인지. -->
                        <TextBlock Text="{Binding ComparedText}" Style="{StaticResource Muted}"
                                   FontSize="11" Margin="52,6,0,0"
                                   Visibility="{Binding ComparedText, Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding Hint}" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"
                               TextAlignment="Right" Margin="16,0,0,0" />
                </Grid>
            </Border>

            <TextBlock Text="분석 결과" Style="{StaticResource H1}" Margin="2,4,0,8" />

            <!--
              분석 칸. 셋을 <b>가로로</b> 나란히 놓고 폭을 똑같이 나눕니다.

              WrapPanel 이 아니라 UniformGrid 인 이유가 있습니다. WrapPanel 은
              좁아지면 한 칸이 아래로 내려가 2+1 로 접힙니다. 셋이 나란히
              있어야 견줘 보이는 것이라, 좁아지면 다 같이 좁아지는 편이
              낫습니다.

              칸 전체가 단추입니다. 요청은 "점수를 누르면" 이었지만 점수만
              눌리게 하면 과녁이 너무 작습니다. 칸 어디를 눌러도 같은 자리로
              갑니다 — 점수도 그 안에 들어 있습니다.
            -->
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AnalysisCardVm}">
                        <Button Style="{StaticResource CardButton}" Click="OnCardClick"
                                Tag="{Binding Number}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                            <StackPanel>

                                <!-- 번호표와 이름 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="{DynamicResource Brush.AccentSoft}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            CornerRadius="3" Padding="7,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}" FontSize="11"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"
                                               VerticalAlignment="Center" Margin="9,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- 점수 -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ScoreText" Text="{Binding ScoreText}"
                                               FontSize="40" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               VerticalAlignment="Bottom" />
                                    <TextBlock Text="{Binding ScoreOutOf}" FontSize="16" Margin="6,0,0,7"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Text="{Binding ScoreNote}" Style="{StaticResource Muted}"
                                           FontSize="11" Margin="0,1,0,0" />

                                <!-- 그 분석이 실제로 센 숫자들 -->
                                <ItemsControl ItemsSource="{Binding Stats}" Margin="0,12,0,0"
                                              Visibility="{Binding HasStats, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:StatVm}">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}"
                                                           FontSize="11" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Value}" FontSize="16"
                                                           FontWeight="SemiBold" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource Brush.Text}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 설명. 높이를 고정해 세 칸의 키를 맞춥니다. -->
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}"
                                           TextWrapping="Wrap" Height="46" Margin="0,12,0,0" />
                            </StackPanel>
                        </Button>

                        <DataTemplate.Triggers>
                            <!-- 점수 색은 화면 아래의 색 설명과 같은 값을 봅니다
                                 (ScoreBands). 아직 안 재 본 "??" 는 회색 그대로 —
                                 안 재 본 값에 색을 칠하면 재 본 값으로 읽힙니다. -->
                            <DataTrigger Binding="{Binding Grade}" Value="good">
                                <Setter TargetName="ScoreText" Property="Foreground"
                                        Value="{DynamicResource Brush.Good}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Grade}" Value="warn">
                                <Setter TargetName="ScoreText" Property="Foreground"
                                        Value="{DynamicResource Brush.Warn}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Grade}" Value="bad">
                                <Setter TargetName="ScoreText" Property="Foreground"
                                        Value="{DynamicResource Brush.Bad}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== 저장된 분석 =====
                 지금 결과를 남겨 두고, 다음에 분석했을 때 지난번과 얼마나
                 달라졌는지 봅니다. -->
            <Border Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="5" Padding="18,14" Margin="6,14,6,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="저장된 분석" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding HistoryNote}" Style="{StaticResource Muted}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,3,12,0" />
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                Content="지금 결과 저장" Click="OnSaveResult"
                                IsEnabled="{Binding CanSave}" VerticalAlignment="Top"
                                ToolTip="{Binding HistoryFolder}" />
                    </Grid>

                    <!--
                      세 줄까지만 보이고 그 다음부터는 이 칸 안에서 굴립니다.
                      기록이 쌓일수록 메인 화면이 끝없이 길어지면 아래 요약
                      칸이 화면 밖으로 밀려납니다.

                      줄 하나가 약 66 (이름 17 + 파일 15 + 기준 14 + 위아래
                      여백 16 + 줄 사이 선 1 + 여유 3) 이라 셋이면 198 입니다.
                      네 번째 줄이 살짝 보여야 "더 있다" 는 것이 눈에 띄므로
                      210 으로 둡니다.
                    -->
                    <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HistoryRowVm}">
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                                        Padding="0,6,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                          줄 전체가 단추입니다. 누르면 그때의
                                          기록을 펼쳐 보는 창이 뜹니다.
                                          [삭제] 는 이 단추 <b>밖</b>에 둡니다 —
                                          안에 넣으면 삭제를 눌러도 바깥 단추의
                                          Click 까지 같이 올라갑니다.
                                        -->
                                        <Button Grid.Column="0" Style="{StaticResource RowButton}"
                                                Click="OnOpenSaved" Tag="{Binding Id}"
                                                ToolTip="{Binding PathsText}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="200" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 언제 것인지, 무엇을 견줬는지 -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                            Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding LogsText}" Style="{StaticResource Muted}"
                                                               FontSize="11" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding BasisText}" Style="{StaticResource Muted}"
                                                               FontSize="10" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- 그때의 점수 셋과 수 -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                            Margin="0,0,18,0">
                                                    <TextBlock Text="{Binding ScoreText}" FontSize="14"
                                                               FontWeight="SemiBold" HorizontalAlignment="Right"
                                                               ToolTip="분석 1 / 2 / 3" />
                                                    <TextBlock Text="{Binding CountsText}" Style="{StaticResource Muted}"
                                                               FontSize="11" HorizontalAlignment="Right"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- 지금 결과와의 차이 -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="170"
                                                            Visibility="{Binding HasDelta, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock x:Name="DeltaText" Text="{Binding DeltaText}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource Brush.Muted}" />
                                                    <TextBlock Text="{Binding BasisWarning}" Style="{StaticResource Muted}"
                                                               FontSize="10" HorizontalAlignment="Right"
                                                               TextWrapping="Wrap" TextAlignment="Right"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding BasisWarning, Converter={StaticResource TextToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <Button Grid.Column="1" Content="삭제" Click="OnDeleteSaved"
                                                Tag="{Binding Id}" VerticalAlignment="Center"
                                                Margin="8,3,0,3" />
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <!-- 달라진 IO 가 늘면 나쁨입니다 — 지난번보다
                                         어긋난 곳이 많아졌다는 뜻이니까요. -->
                                    <DataTrigger Binding="{Binding DeltaKind}" Value="bad">
                                        <Setter TargetName="DeltaText" Property="Foreground"
                                                Value="{DynamicResource Brush.Bad}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeltaKind}" Value="good">
                                        <Setter TargetName="DeltaText" Property="Foreground"
                                                Value="{DynamicResource Brush.Good}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeltaKind}" Value="same">
                                        <Setter TargetName="DeltaText" Property="Foreground"
                                                Value="{DynamicResource Brush.Text}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ===== 요약 =====
                 분석 셋의 결과를 한자리에 묶어 줄 자리입니다. 아직 무엇을
                 요약할지 정해지지 않아서 비워 두되, 칸은 미리 만들어 두고
                 "미구현" 이라고 적어 둡니다. -->
            <Border Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="5" Padding="18,14" Margin="6,14,6,0" MinHeight="86">
                <StackPanel>
                    <TextBlock Text="요약" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Muted}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Margin="4,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource Muted}" FontSize="11"
                           TextWrapping="Wrap" VerticalAlignment="Bottom" MaxWidth="520"
                           Text="점수를 매기는 규칙은 아직 정해지지 않았습니다. 지금은 견주기 전이면 ??, 견주고 나면 만점으로 둡니다." />

                <!-- 점수 색 설명. 작게, 오른쪽 아래에. -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="20,0,0,0">
                    <TextBlock Text="점수 색" Style="{StaticResource Muted}" FontSize="10"
                               HorizontalAlignment="Right" Margin="0,0,0,3" />
                    <ItemsControl ItemsSource="{Binding Bands}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BandVm}">
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                    <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4"
                                            VerticalAlignment="Center" Margin="0,0,6,0"
                                            Background="{DynamicResource Brush.Muted}" />
                                    <TextBlock Text="{Binding RangeText}" FontSize="10" Width="52"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Meaning}" FontSize="10"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Grade}" Value="good">
                                        <Setter TargetName="Dot" Property="Background"
                                                Value="{DynamicResource Brush.Good}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Grade}" Value="warn">
                                        <Setter TargetName="Dot" Property="Background"
                                                Value="{DynamicResource Brush.Warn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Grade}" Value="bad">
                                        <Setter TargetName="Dot" Property="Background"
                                                Value="{DynamicResource Brush.Bad}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
