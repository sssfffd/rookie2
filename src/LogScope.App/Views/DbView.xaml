<UserControl x:Class="LogScope.App.Views.DbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogScope.App.ViewModels"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <!--
          목록 줄. 기본 모양(ListRow)을 그대로 쓰고 마우스 설명만 답니다.
          BasedOn 을 빼면 테마의 줄 모양이 통째로 사라집니다.
          칸이 좁아 잘린 값은 짚어 보지 않으면 읽을 수가 없습니다.
        -->
        <Style x:Key="DiffRow" TargetType="{x:Type ListViewItem}"
               BasedOn="{StaticResource ListRow}">
            <Setter Property="ToolTip" Value="{Binding Tip}" />
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- 위: 어디를 견주는지와 단추들 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="DB 분석" Style="{StaticResource H2}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="DB 읽기" Click="OnRead" Margin="0,0,6,0"
                            ToolTip="config.txt 의 db.before / db.after 를 읽어 견줍니다." />
                    <Button Content="SQL 글 저장" Click="OnSaveScript" Margin="0,0,14,0"
                            ToolTip="아래 글을 .sql 파일로 저장합니다. 돌리는 것은 직접 하세요." />

                    <TextBlock Text="맞출 방향" Style="{StaticResource ToolGroupCaption}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <RadioButton GroupName="way" Style="{StaticResource SegmentButton}"
                                 Content="이전 → 이후" IsChecked="{Binding ToAfter, Mode=TwoWay}"
                                 ToolTip="이전 DB 를 이후와 같게 만드는 글을 만듭니다." />
                    <RadioButton GroupName="way" Style="{StaticResource SegmentButton}"
                                 Content="이후 → 이전" IsChecked="{Binding ToBefore, Mode=TwoWay}"
                                 ToolTip="이후 DB 를 이전과 같게 되돌리는 글을 만듭니다." />
                </WrapPanel>

                <TextBlock Text="{Binding PathText}" Style="{StaticResource Muted}"
                           FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Summary}" Margin="0,6,0,0" TextWrapping="Wrap" />

                <!-- 못 읽은 파일 같은 것. 없으면 줄 자체가 사라집니다. -->
                <TextBlock Text="{Binding Notes}" Style="{StaticResource Muted}" FontSize="11"
                           Margin="0,6,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Notes, Converter={StaticResource TextToVisibility}}" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 표 목록 -->
            <ListView Grid.Column="0" ItemsSource="{Binding Tables}"
                      SelectedItem="{Binding Selected, Mode=TwoWay}"
                      BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="표" Width="150"
                                        DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="상태" Width="70"
                                        DisplayMemberBinding="{Binding Status}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- 오른쪽: 고른 표의 차이와 SQL 글 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                  차이 목록. 칸마다 값 하나입니다.

                  글 한 덩이로 적던 것을 목록으로 바꿨습니다. 값이 바뀐 행은
                  바뀐 열마다 한 줄이라, 같은 열이 몇 군데서 바뀌었는지가
                  보입니다.
                -->
                <DockPanel Grid.Row="0">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.PanelAlt}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                            Padding="10,5">
                        <WrapPanel>
                            <TextBlock Text="차이 목록" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <RadioButton GroupName="scope" Style="{StaticResource SegmentButton}"
                                         Content="전체 표" IsChecked="{Binding ShowAll, Mode=TwoWay}"
                                         ToolTip="달라진 모든 표의 차이를 한 목록으로 뽑습니다." />
                            <RadioButton GroupName="scope" Style="{StaticResource SegmentButton}"
                                         Content="고른 표만" IsChecked="{Binding ShowOne, Mode=TwoWay}"
                                         ToolTip="왼쪽에서 고른 표의 차이만 봅니다." />
                            <TextBlock Text="{Binding LineText}" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="12,0,12,0" />
                            <Button Content="목록 CSV 저장" Click="OnSaveList"
                                    ToolTip="지금 보이는 목록을 칸 그대로 저장합니다. 엑셀에서 거르고 정렬하는 쪽이 이 화면보다 낫습니다." />
                        </WrapPanel>
                    </Border>

                    <Grid>
                        <ListView x:Name="DiffList" ItemsSource="{Binding Lines}"
                                  ItemContainerStyle="{StaticResource DiffRow}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="표" Width="140"
                                                    DisplayMemberBinding="{Binding Table}" />
                                    <GridViewColumn Header="갈래" Width="50"
                                                    DisplayMemberBinding="{Binding Kind}" />
                                    <GridViewColumn Header="구분" Width="64"
                                                    DisplayMemberBinding="{Binding Change}" />
                                    <GridViewColumn Header="행" Width="150"
                                                    DisplayMemberBinding="{Binding Where}" />
                                    <GridViewColumn Header="열" Width="120"
                                                    DisplayMemberBinding="{Binding Column}" />
                                    <GridViewColumn Header="이전" Width="140"
                                                    DisplayMemberBinding="{Binding Before}" />
                                    <GridViewColumn Header="이후" Width="140"
                                                    DisplayMemberBinding="{Binding After}" />
                                    <GridViewColumn Header="설명" Width="300"
                                                    DisplayMemberBinding="{Binding Note}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- 비었을 때. 왜 비었는지는 그때마다 다릅니다. -->
                        <TextBlock Text="{Binding EmptyText}" Margin="16,40,16,0"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LinesIsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" Background="Transparent" />

                <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}"
                                   Margin="12,6,12,4"
                                   Text="맞추는 SQL — 이 프로그램이 돌리지 않습니다. 읽어 보고 직접 돌리세요." />
                        <!--
                          읽기 전용이지만 TextBox 입니다. 글을 골라 복사할 수
                          있어야 합니다 — 저장만 되고 복사가 안 되면 번거롭습니다.
                        -->
                        <TextBox Text="{Binding ScriptText, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 BorderThickness="0" Background="Transparent" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
