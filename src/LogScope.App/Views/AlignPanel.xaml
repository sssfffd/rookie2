<UserControl x:Class="LogScope.App.Views.AlignPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Panel}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <!--
      가로축과 시간 맞추기. 그래프 화면과 히트맵 화면이 이 판 하나를 똑같이
      띄웁니다. 도구 줄에 늘어놓지 않고 접어 둔 이유는 간단합니다 — 한 번
      정해 놓고 계속 쓰는 값들이라, 늘 펼쳐 두면 도구 줄만 길어집니다.
    -->
    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
            Background="{DynamicResource Brush.Panel}" Padding="14,12">
        <StackPanel Width="440">

            <TextBlock Text="가로축" Style="{StaticResource H2}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="로그의 시간 열 대신 다른 IO 를 가로축으로 놓습니다. 경과 시간이나 스캔 번호처럼 값이 늘어나기만 하는 IO 만 고를 수 있습니다." />
            <ComboBox ItemsSource="{Binding AxisChoices}"
                      SelectedItem="{Binding AxisIo, Mode=TwoWay}" />

            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,14,0,12" />

            <TextBlock Text="시간 맞추기" Style="{StaticResource H2}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="고른 IO 가 어떤 값이 되는 순간이 겹치도록 이후 로그를 밉니다. 시작 시각이 달라도 사건끼리 맞춰집니다." />

            <TextBlock Text="기준 IO" Style="{StaticResource FieldLabel}" Margin="0,4,0,2" />
            <ComboBox ItemsSource="{Binding AlignChoices}"
                      SelectedItem="{Binding AlignIo, Mode=TwoWay}" />

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="기준 값" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="어느 순간" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                <TextBlock Grid.Row="0" Grid.Column="4" Text="몇 번째" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />

                <!-- 0/1 만이 아니라 그 IO 에 실제로 나온 값을 다 올립니다. -->
                <ComboBox Grid.Row="1" Grid.Column="0"
                          ItemsSource="{Binding LevelChoices}"
                          SelectedIndex="{Binding LevelIndex, Mode=TwoWay}"
                          IsEnabled="{Binding HasLevels}"
                          ToolTip="그 IO 에 실제로 나온 값들입니다. 0~5 로 움직이는 단계 신호면 5 도 고를 수 있습니다.&#x0a;값 종류가 너무 많은 아날로그 IO 만 문턱 하나로 위/아래를 가릅니다." />

                <ComboBox Grid.Row="1" Grid.Column="2"
                          ItemsSource="{Binding EdgeChoices}"
                          SelectedIndex="{Binding EdgeIndex, Mode=TwoWay}"
                          ToolTip="[그 값이 될 때] 는 처음부터 그 값인 로그도 잡습니다 — 그 로그에서는 시작 지점이 그 순간입니다." />

                <TextBox Grid.Row="1" Grid.Column="4"
                         Text="{Binding OccurrenceText, UpdateSourceTrigger=LostFocus}"
                         ToolTip="같은 일이 여러 번 일어날 때 몇 번째로 맞출지. 1 이 첫 번째입니다." />
            </Grid>

            <WrapPanel Margin="0,10,0,0">
                <Button Content="맞추기 해제" Click="OnClearAlign"
                        ToolTip="기준 IO 를 지우고 시작 시각 자동 맞춤으로 돌아갑니다." />
                <Button Content="닫기" Click="OnClose" />
            </WrapPanel>

            <!-- 결과 한 줄. 못 맞췄으면 그 이유가 여기 적힙니다. -->
            <Border Background="{DynamicResource Brush.PanelAlt}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    Padding="8,5" Margin="0,10,0,0"
                    Visibility="{Binding Note, Converter={StaticResource TextToVisibility}}">
                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource Brush.Text}" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
