<UserControl x:Class="LogScope.App.Views.HeatmapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:LogScope.App.Controls"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <DockPanel>

        <!-- 도구 줄. 좁아지면 저절로 줄바꿈됩니다. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="8,4">
            <WrapPanel>
                <TextBlock Text="히트맵" Style="{StaticResource H2}" VerticalAlignment="Center"
                           Margin="2,0,14,0" />

                <Button Content="히트맵 다시 계산" Style="{StaticResource PrimaryButton}"
                        Click="OnRecalculate" />

                <TextBlock Text="칸 폭" Style="{StaticResource FieldLabel}" Margin="12,0,8,0" />
                <ComboBox MinWidth="150" ItemsSource="{Binding BucketChoices}"
                          SelectedIndex="{Binding BucketIndex, Mode=TwoWay}" />

                <TextBlock Text="허용 오차 (값 범위의 %)" Style="{StaticResource FieldLabel}"
                           Margin="12,0,8,0" />
                <TextBox Width="64" Margin="0,3,3,3"
                         Text="{Binding RelativeTolerancePercent, UpdateSourceTrigger=LostFocus}"
                         ToolTip="기본 0.1%. IO 범위가 몇천인데 1 정도 흔들리는 것은 오류로 세지 않습니다." />

                <ToggleButton Style="{StaticResource ToolToggle}" Content="차이 없는 IO도 보기"
                              IsChecked="{Binding IncludeUnchanged, Mode=TwoWay}" Margin="12,3,3,3" />

                <TextBlock Text="칸 크기" Style="{StaticResource FieldLabel}" Margin="12,0,8,0" />
                <Button Content="칸 넓게" Click="OnWider" />
                <Button Content="칸 좁게" Click="OnNarrower" />
                <Button Content="줄 높게" Click="OnTaller" />
                <Button Content="줄 낮게" Click="OnShorter" />
            </WrapPanel>
        </Border>

        <!-- 요약 + 색 설명 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Window}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="12,6">
            <StackPanel>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Text}" />
                <WrapPanel Margin="0,6,0,0">
                    <Border Width="16" Height="12" Margin="0,0,6,0"
                            Background="{DynamicResource Brush.Bad}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                    <TextBlock Text="차이 발생 (칸 안의 숫자 = 그 구간의 절대 차이 평균, 진할수록 큼)"
                               Style="{StaticResource Muted}" Margin="0,0,18,0" />

                    <Border Width="16" Height="12" Margin="0,0,6,0"
                            Background="{DynamicResource Brush.Good}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                    <TextBlock Text="정상 (허용 오차 안)" Style="{StaticResource Muted}" Margin="0,0,18,0" />

                    <Border Width="16" Height="12" Margin="0,0,6,0"
                            Background="{DynamicResource Brush.PanelAlt}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                    <TextBlock Text="기록 없음" Style="{StaticResource Muted}" Margin="0,0,18,0" />

                    <TextBlock Text="칸을 누르면 그 IO 와 그 시간대로 그래프 화면이 열립니다. Ctrl+휠 = 칸 너비, Shift+휠 = 옆으로"
                               Style="{StaticResource Muted}" FontSize="11" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 아래 띠: 마우스가 올라간 칸의 자세한 값 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="12,5" MinHeight="28">
            <TextBlock Text="{Binding HoverText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ctl:HeatmapCanvas x:Name="Map" Grid.Row="0" Grid.Column="0" />

            <ScrollBar Grid.Row="0" Grid.Column="1" Orientation="Vertical" Minimum="0"
                       SmallChange="26" LargeChange="200"
                       Maximum="{Binding VerticalMaximum, ElementName=Map, Mode=OneWay}"
                       ViewportSize="{Binding VerticalViewport, ElementName=Map, Mode=OneWay}"
                       Value="{Binding VerticalOffset, ElementName=Map, Mode=TwoWay}" />

            <ScrollBar Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Minimum="0"
                       SmallChange="58" LargeChange="400"
                       Maximum="{Binding HorizontalMaximum, ElementName=Map, Mode=OneWay}"
                       ViewportSize="{Binding HorizontalViewport, ElementName=Map, Mode=OneWay}"
                       Value="{Binding HorizontalOffset, ElementName=Map, Mode=TwoWay}" />
        </Grid>
    </DockPanel>
</UserControl>
