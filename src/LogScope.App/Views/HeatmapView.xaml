<UserControl x:Class="LogScope.App.Views.HeatmapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:LogScope.App.Controls"
             xmlns:local="clr-namespace:LogScope.App.Views"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <DockPanel>

        <!-- 도구 줄. 좁아지면 저절로 줄바꿈됩니다. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="8,4">
            <WrapPanel>
                <TextBlock Text="히트맵" Style="{StaticResource H2}" VerticalAlignment="Center"
                           Margin="2,0,14,0" />

                <Button Content="히트맵 다시 계산" Style="{StaticResource PrimaryButton}"
                        Click="OnRecalculate" />

                <TextBlock Text="칸 폭" Style="{StaticResource FieldLabel}" Margin="12,0,8,0" />
                <ComboBox MinWidth="150" ItemsSource="{Binding BucketChoices}"
                          SelectedIndex="{Binding BucketIndex, Mode=TwoWay}" />

                <TextBlock Text="허용 오차 (이전 값 대비 %)" Style="{StaticResource FieldLabel}"
                           Margin="12,0,8,0" />
                <TextBox Width="64" Margin="0,3,3,3"
                         Text="{Binding RelativeTolerancePercent, UpdateSourceTrigger=LostFocus}"
                         ToolTip="오차 = |이후 − 이전| / |이전| x 100. 기본 0.1%.&#x0a;칸에 적히는 퍼센트와 같은 잣대라 그대로 견주면 됩니다." />

                <ToggleButton Style="{StaticResource ToolToggle}" Content="차이 없는 IO도 보기"
                              IsChecked="{Binding IncludeUnchanged, Mode=TwoWay}" Margin="12,3,3,3" />

                <!-- 칸에 적을 숫자를 값으로 볼지 퍼센트로 볼지 -->
                <TextBlock Text="칸에 적을 값" Style="{StaticResource FieldLabel}" Margin="12,0,10,0" />
                <RadioButton GroupName="heatunit" Style="{StaticResource SegmentButton}"
                             Content="값 그대로" Checked="OnUnitChanged"
                             IsChecked="{Binding ShowValue, Mode=TwoWay}"
                             ToolTip="그 구간의 절대 차이 평균을 값 그대로 적습니다." />
                <RadioButton GroupName="heatunit" Style="{StaticResource SegmentButton}"
                             Content="% (값 범위 대비)" Checked="OnUnitChanged"
                             IsChecked="{Binding ShowPercent, Mode=TwoWay}"
                             ToolTip="이전 값 대비 몇 % 벌어졌는지. 설정한 허용 오차와 같은 잣대라 바로 견줄 수 있고,&#x0a;값 크기가 다른 IO 끼리도 견줄 수 있습니다." />

                <!--
                  가로축과 시간 맞추기. 그래프 화면과 <b>같은 판</b>을 띄웁니다.
                  히트맵도 두 로그를 겹쳐 견주는 화면이라, 시간이 어긋나 있으면
                  칸 하나하나가 전부 엉뚱한 구간을 가리킵니다.
                -->
                <Button x:Name="AlignAnchor" Content="{Binding Align.Summary}" Width="146"
                        Margin="12,3,3,3" Click="OnAlignOpen"
                        ToolTip="가로축을 다른 IO 로 놓거나, 특정 IO 가 어떤 값이 되는 순간으로 두 로그의 시간을 맞춥니다.&#x0a;그래프 화면과 같은 설정입니다." />
                <Popup x:Name="AlignPopup" PlacementTarget="{Binding ElementName=AlignAnchor}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       Closed="OnAlignPopupClosed">
                    <local:AlignPanel DataContext="{Binding Align}"
                                      CloseRequested="OnAlignPanelClose" />
                </Popup>

                <TextBlock Text="칸 크기" Style="{StaticResource FieldLabel}" Margin="12,0,8,0" />
                <Button Content="칸 넓게" Click="OnWider" />
                <Button Content="칸 좁게" Click="OnNarrower" />
                <Button Content="줄 높게" Click="OnTaller" />
                <Button Content="줄 낮게" Click="OnShorter" />
            </WrapPanel>
        </Border>

        <!-- 요약 + 색 설명 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Window}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="12,6">
            <StackPanel>
                <!-- 허용 오차를 바꾸고 아직 다시 계산하지 않았을 때만 나옵니다. -->
                <Border Background="{DynamicResource Brush.PanelAlt}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        Padding="8,4" Margin="0,0,0,6"
                        Visibility="{Binding StaleText, Converter={StaticResource TextToVisibility}}">
                    <TextBlock Text="{Binding StaleText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text}" />
                </Border>

                <!-- 한 그룹만 보고 있을 때. 그렇다고 말해 주지 않으면
                     "IO 가 왜 이것밖에 없지" 가 됩니다. -->
                <Border Background="{DynamicResource Brush.AccentSoft}"
                        BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                        CornerRadius="3" Padding="10,5" Margin="0,0,0,6"
                        Visibility="{Binding HasFocus, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding FocusText}" TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text}" />
                        <Button Grid.Column="1" Content="모든 IO 보기" Click="OnClearFocus"
                                Margin="10,0,0,0" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Text}" />
                <WrapPanel Margin="0,6,0,0">
                    <Border Width="16" Height="12" Margin="0,0,6,0"
                            Background="{DynamicResource Brush.Bad}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                    <TextBlock Text="{Binding LegendText}"
                               Style="{StaticResource Muted}" Margin="0,0,18,0" />

                    <Border Width="16" Height="12" Margin="0,0,6,0"
                            Background="{DynamicResource Brush.Good}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                    <TextBlock Text="정상 (허용 오차 안)" Style="{StaticResource Muted}" Margin="0,0,18,0" />

                    <Border Width="16" Height="12" Margin="0,0,6,0"
                            Background="{DynamicResource Brush.PanelAlt}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                    <TextBlock Text="기록 없음" Style="{StaticResource Muted}" Margin="0,0,18,0" />

                    <TextBlock Text="칸을 누르면 그 IO 와 그 시간대로 그래프 화면이 열립니다. 칸에 마우스를 올리면 그 칸의 값·%·기준을 나란히 보여 줍니다. Ctrl+휠 = 칸 너비, Shift+휠 = 옆으로"
                               Style="{StaticResource Muted}" FontSize="11" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 아래 띠: 마우스가 올라간 칸의 자세한 값 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="12,5" MinHeight="28">
            <TextBlock Text="{Binding HoverText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ctl:HeatmapCanvas x:Name="Map" Grid.Row="0" Grid.Column="0" />

            <ScrollBar Grid.Row="0" Grid.Column="1" Orientation="Vertical" Minimum="0"
                       SmallChange="26" LargeChange="200"
                       Maximum="{Binding VerticalMaximum, ElementName=Map, Mode=OneWay}"
                       ViewportSize="{Binding VerticalViewport, ElementName=Map, Mode=OneWay}"
                       Value="{Binding VerticalOffset, ElementName=Map, Mode=TwoWay}" />

            <ScrollBar Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Minimum="0"
                       SmallChange="58" LargeChange="400"
                       Maximum="{Binding HorizontalMaximum, ElementName=Map, Mode=OneWay}"
                       ViewportSize="{Binding HorizontalViewport, ElementName=Map, Mode=OneWay}"
                       Value="{Binding HorizontalOffset, ElementName=Map, Mode=TwoWay}" />
        </Grid>
    </DockPanel>
</UserControl>
