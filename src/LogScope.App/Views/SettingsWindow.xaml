<Window x:Class="LogScope.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LogScope.App.ViewModels"
        Title="설정" Width="760" Height="560" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="12">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="10,8">
            <Button Content="닫기" HorizontalAlignment="Right" MinWidth="100" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="OnClose" />
        </Border>

        <TabControl>

            <!-- ===================== 폴더 ===================== -->
            <TabItem Header="폴더">
                <DockPanel Margin="14">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="파일 열기 창이 처음 가리킬 폴더를 이전용 / 이후용으로 따로 정할 수 있습니다.&#x0a;비워 두면 마지막으로 연 파일이 있던 폴더에서 시작합니다." />

                    <Grid VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="이전 로그 기본 폴더"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                                 Text="{Binding BeforeFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="1" Grid.Column="2" Content="폴더 고르기" Click="OnPickBeforeFolder" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="이후 로그 기본 폴더"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3"
                                 Text="{Binding AfterFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="2" Grid.Column="2" Content="폴더 고르기" Click="OnPickAfterFolder" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="마지막으로 연 이전 로그"
                                   Style="{StaticResource FieldLabel}" Margin="0,12,10,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                   Text="{Binding BeforeFile}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="마지막으로 연 이후 로그"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                   Text="{Binding AfterFile}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                        <Button Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Content="기억된 파일 지우기" Click="OnForgetFiles" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ===================== 표시 ===================== -->
            <TabItem Header="표시">
                <StackPanel Margin="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="테마" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeNames}"
                                  SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0"
                               Text="테마를 고르면 바로 바뀝니다. 프로그램을 다시 켜지 않아도 됩니다." />
                </StackPanel>
            </TabItem>

            <!-- ===================== 비교 ===================== -->
            <TabItem Header="비교">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="허용 오차 (이전 값 대비 %)"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3"
                                 Text="{Binding RelativeTolerancePercentText, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="오차 = |이후 − 이전| / |이전| x 100. 기본 0.1%.&#x0a;화면에 적히는 퍼센트가 바로 이 값이라 그대로 견주면 됩니다." />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="기본 0.1"
                                   Style="{StaticResource Muted}" Margin="10,0,0,0" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="허용 오차 (절대값)"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                                 Text="{Binding AbsoluteToleranceText, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="값 그대로. 기본 0 (끔).&#x0a;이 값 이하로 벌어진 것은 퍼센트와 상관없이 같은 것으로 봅니다.&#x0a;0 언저리에서 퍼센트가 크게 튀는 것을 막는 데 씁니다." />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="기본 0 (끔)"
                                   Style="{StaticResource Muted}" Margin="10,0,0,0" />

                        <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"
                                Content="허용 오차를 기본값으로" Click="OnResetTolerance" />

                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Muted}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="위 두 값이 모든 IO 의 기본값입니다." />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="목록 정렬 기준"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Metrics}"
                                  SelectedIndex="{Binding SortMetricIndex, Mode=TwoWay}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="시간 맞추기"
                                   Style="{StaticResource FieldLabel}" />
                        <CheckBox Grid.Row="4" Grid.Column="1" Content="두 로그의 시작 시각을 자동으로 맞춤"
                                  IsChecked="{Binding AutoAlign, Mode=TwoWay}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="손으로 밀기"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,3"
                                 Text="{Binding ManualShiftText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="시간축 단위입니다. 시각 로그라면 밀리초." />
                    </Grid>

                    <!--
                      ================= IO 별 허용 오차 =================

                      기본값 하나로 다 보는 것이 맞지 않는 경우가 있습니다.
                      온도처럼 원래 조금씩 흔들리는 값과, 밸브 열림처럼 조금도
                      달라지면 안 되는 값에 같은 잣대를 대면 한쪽은 늘 빨갛고
                      다른 쪽은 놓칩니다.

                      칸을 비워 두면 그 자리는 기본값입니다. 0 과 빈 칸은
                      다릅니다 — 절대값 0 은 "절대 오차를 끈다", 퍼센트 0 은
                      "조금이라도 벌어지면 차이" 라는 뜻이라 둘 다 쓰는 값입니다.
                    -->
                    <TextBlock Text="IO 별 허용 오차" Style="{StaticResource H2}" Margin="0,20,0,4" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="여기 적은 IO 만 따로 봅니다. 칸을 비워 두면 그 자리는 위의 기본값을 씁니다.&#x0a;이름은 느슨하게 맞춥니다 — 띄어쓰기나 _ - . 가 달라도 같은 IO 로 봅니다." />

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IO 이름" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Column="1" Text="퍼센트 (%)" Style="{StaticResource FieldLabel}"
                                   Margin="6,0,0,0" />
                        <TextBlock Grid.Column="2" Text="값 (절대)" Style="{StaticResource FieldLabel}"
                                   Margin="6,0,0,0" />
                    </Grid>

                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="4" Padding="6"
                            Visibility="{Binding HasTolerances, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Tolerances}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ToleranceRowVm}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>

                                            <!--
                                              IsEditable: 로그를 안 열었으면 고를 것이
                                              없습니다. 그때도 이름을 적어 둘 수 있어야
                                              규칙을 미리 걸어 둘 수 있습니다.
                                            -->
                                            <ComboBox Grid.Column="0" IsEditable="True"
                                                      ItemsSource="{Binding DataContext.IoNames,
                                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Text="{Binding Io, UpdateSourceTrigger=LostFocus}" />
                                            <TextBox Grid.Column="1" Margin="6,0,0,0"
                                                     Text="{Binding PercentText, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="비워 두면 기본값을 씁니다." />
                                            <TextBox Grid.Column="2" Margin="6,0,0,0"
                                                     Text="{Binding AbsoluteText, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="비워 두면 기본값을 씁니다.&#x0a;이 값 이하로 벌어진 것은 퍼센트와 상관없이 같은 것으로 봅니다." />
                                            <Button Grid.Column="3" Margin="6,0,0,0" Content="지우기"
                                                    Click="OnRemoveTolerance" Tag="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Button HorizontalAlignment="Left" Margin="0,8,0,0" Content="IO 추가"
                            Click="OnAddTolerance" />

                    <TextBlock Style="{StaticResource Muted}" Margin="0,16,0,0"
                               Text="오차는 그 순간의 값끼리 견줍니다.&#x0a;&#x0a;    오차(%) = |이후 − 이전| / |이전| x 100&#x0a;&#x0a;위 칸에 적는 퍼센트가 바로 이 값입니다. 대시보드의 [최대 오차 %] 칸,&#x0a;히트맵 칸에 적히는 퍼센트도 모두 같은 값이라 눈으로 바로 견줄 수 있습니다.&#x0a;어느 채널이든 같은 잣대입니다.&#x0a;&#x0a;이전 값이 0 이면 나눌 수가 없어 100% 로 봅니다 (0 → 0 은 0%).&#x0a;0 언저리에서 잘게 흔들리는 것까지 100% 로 잡히는 게 싫으면&#x0a;절대 오차를 함께 걸어 두세요.&#x0a;&#x0a;이 값은 대시보드 · 그래프 차이 영역 표시 · 히트맵이 모두 함께 씁니다.&#x0a;여기서 바꾼 값은 위 메뉴의 [비교 다시 하기] 를 눌러야 반영됩니다." />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- ===================== AI 모듈 ===================== -->
            <TabItem Header="AI 모듈 (선택)">
                <StackPanel Margin="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="사용 여부"
                                   Style="{StaticResource FieldLabel}" />
                        <CheckBox Grid.Row="0" Grid.Column="1" Content="파이썬 분석 모듈 사용"
                                  IsChecked="{Binding AiEnabled, Mode=TwoWay}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="python.exe 경로"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                                 Text="{Binding PythonPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="1" Grid.Column="2" Content="파일 고르기" Click="OnPickPython" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="분석 스크립트 경로"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3"
                                 Text="{Binding AiScriptPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="2" Grid.Column="2" Content="파일 고르기" Click="OnPickScript" />
                    </Grid>

                    <TextBlock Style="{StaticResource Muted}" Margin="0,16,0,0"
                               Text="기본은 꺼져 있습니다. 켜면 지정한 파이썬을 자식 프로세스로 띄워&#x0a;비교 결과 요약(채널 이름과 숫자)만 넘기고 소견 글을 받아 옵니다.&#x0a;로그 파일 자체나 파일 경로는 넘기지 않고, 네트워크로 내보내는 코드도 없습니다.&#x0a;스크립트가 무엇을 하는지는 그 파일을 직접 열어 확인하세요.&#x0a;남이 고쳐 쓸 수 있는 폴더의 파이썬을 지정하지 마세요." />
                </StackPanel>
            </TabItem>

            <!-- ===================== 정보 ===================== -->
            <TabItem Header="정보">
                <StackPanel Margin="14">
                    <TextBlock Text="LogScope — IO 로그 그래프 뷰어" Style="{StaticResource H2}" />

                    <TextBox Margin="0,12,0,0" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Consolas, Courier New" Height="132"
                             Background="{DynamicResource Brush.Panel}"
                             Text="{Binding VersionText, Mode=OneWay}" />

                    <TextBlock Text="설정 파일" Style="{StaticResource Muted}" Margin="0,14,0,4" />
                    <TextBox IsReadOnly="True" Background="{DynamicResource Brush.Panel}"
                             Text="{Binding SettingsPath, Mode=OneWay}" />
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
