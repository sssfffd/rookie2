<Window x:Class="LogScope.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:LogScope.App.Views"
        Title="LogScope — IO 로그 그래프 뷰어"
        Width="1360" Height="860" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <DockPanel>

        <!-- ================= 위쪽 메뉴 줄 (진한 파랑) ================= -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.TopBar}" Padding="12,6">
            <WrapPanel>
                <!--
                  [LogScope] 를 누르면 큰 화면 목록이 내려옵니다.
                  분석이 늘어나도 위 줄이 길어지지 않게 접어 둡니다.
                -->
                <Button x:Name="BrandButton" Style="{StaticResource BrandButton}" Click="OnBrandClick"
                        ToolTip="누르면 화면 목록이 열립니다.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LogScope" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.TopBarText}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="▾" FontSize="11" Margin="6,2,0,0"
                                   Foreground="{DynamicResource Brush.TopBarMuted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Popup x:Name="BrandMenu" PlacementTarget="{Binding ElementName=BrandButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       Closed="OnBrandMenuClosed">
                    <Border Background="{DynamicResource Brush.Panel}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            Padding="0,5">
                        <StackPanel>
                            <TextBlock Text="화면" Style="{StaticResource FieldLabel}" Margin="14,2,14,5" />
                            <Button Style="{StaticResource MenuItemButton}" Content="1.  메인"
                                    Tag="0" Click="OnGoScreen" />
                            <Button Style="{StaticResource MenuItemButton}" Content="2.  1번 화면 — 로그 비교"
                                    Tag="1" Click="OnGoScreen" />
                            <Button Style="{StaticResource MenuItemButton}" Content="3.  2번 화면"
                                    Tag="2" Click="OnGoScreen" />
                            <Button Style="{StaticResource MenuItemButton}" Content="4.  3번 화면"
                                    Tag="3" Click="OnGoScreen" />
                        </StackPanel>
                    </Border>
                </Popup>

                <TextBlock Text="{Binding ScreenName}" FontSize="12"
                           Foreground="{DynamicResource Brush.TopBarMuted}"
                           VerticalAlignment="Center" Margin="2,0,10,0" />
                <TextBlock Text="{Binding VersionText}" FontSize="11"
                           Foreground="{DynamicResource Brush.TopBarMuted}"
                           VerticalAlignment="Center" Margin="0,0,14,0" />

                <!--
                  대시보드 · 그래프 · 히트맵은 <b>분석 1 안에서만</b> 뜻이
                  있습니다. 다른 화면에서도 보이면 눌러 놓고 왜 안 바뀌나
                  하게 됩니다.
                -->
                <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Content="대시보드"
                             IsChecked="{Binding ShowDashboard, Mode=TwoWay}"
                             Visibility="{Binding ShowAnalysis1, Converter={StaticResource BoolToVisibility}}"
                             ToolTip="요약 화면입니다 (F1)." />
                <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Content="그래프"
                             IsChecked="{Binding ShowGraph, Mode=TwoWay}"
                             Visibility="{Binding ShowAnalysis1, Converter={StaticResource BoolToVisibility}}"
                             ToolTip="시간에 따른 파형을 봅니다 (F2)." />
                <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Content="히트맵"
                             IsChecked="{Binding ShowHeatmap, Mode=TwoWay}"
                             Visibility="{Binding ShowAnalysis1, Converter={StaticResource BoolToVisibility}}"
                             ToolTip="시간 구간별로 어디서 차이가 났는지 한눈에 봅니다 (F3)." />

                <TextBlock Text="로그 세트" Foreground="{DynamicResource Brush.TopBarMuted}"
                           VerticalAlignment="Center" Margin="18,0,6,0" />
                <ComboBox MinWidth="150" ItemsSource="{Binding SetNames}"
                          SelectedIndex="{Binding ActiveSet, Mode=TwoWay}"
                          ToolTip="한 세트 = 이전 로그 + 이후 로그 한 쌍입니다." />

                <Button Style="{StaticResource TopBarButton}" Content="이전 로그 열기"
                        Click="OnOpenBefore" Margin="10,3,3,3" />
                <Button Style="{StaticResource TopBarButton}" Content="이후 로그 열기"
                        Click="OnOpenAfter" />
                <Button Style="{StaticResource TopBarButton}" Content="다시 읽기"
                        Click="OnReload" ToolTip="이 세트에 기억된 파일을 다시 읽습니다." />
                <Button Style="{StaticResource TopBarButton}" Content="비교 다시 하기"
                        Click="OnRecompare" ToolTip="허용 오차 등을 바꾼 뒤 누르세요 (F5)." />
                <Button Style="{StaticResource TopBarButton}" Content="설정"
                        Click="OnSettings" Margin="10,3,3,3" />
            </WrapPanel>
        </Border>

        <!-- ================= 아래쪽 알림 줄 ================= -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="12,4" MinHeight="26">
            <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush.Muted}" FontSize="11"
                       VerticalAlignment="Center" />
        </Border>

        <!-- ================= 본문 =================
             화면을 모두 만들어 두고 보이기만 바꿉니다. 그래야 화면을
             오갈 때 고른 IO 나 확대 상태가 사라지지 않습니다. -->
        <Grid>

            <!-- 메인 -->
            <v:MainView x:Name="Main" DataContext="{Binding Main}"
                        Visibility="{Binding DataContext.ShowMain,
                                     RelativeSource={RelativeSource AncestorType=Window},
                                     Converter={StaticResource BoolToVisibility}}" />

            <!-- 분석 1 — 지금까지 만든 것. 안에서 다시 셋으로 갈립니다. -->
            <Grid Visibility="{Binding ShowAnalysis1, Converter={StaticResource BoolToVisibility}}">
                <v:DashboardView x:Name="Dashboard" DataContext="{Binding Dashboard}"
                                 Visibility="{Binding DataContext.ShowDashboard,
                                              RelativeSource={RelativeSource AncestorType=Window},
                                              Converter={StaticResource BoolToVisibility}}" />

                <v:GraphView x:Name="Graph" DataContext="{Binding Graph}"
                             Visibility="{Binding DataContext.ShowGraph,
                                          RelativeSource={RelativeSource AncestorType=Window},
                                          Converter={StaticResource BoolToVisibility}}" />

                <v:HeatmapView x:Name="Heatmap" DataContext="{Binding Heatmap}"
                               Visibility="{Binding DataContext.ShowHeatmap,
                                            RelativeSource={RelativeSource AncestorType=Window},
                                            Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- 분석 2 · 3 — 아직 빈 화면입니다. -->
            <v:PlaceholderView Heading="분석 2"
                               Visibility="{Binding ShowAnalysis2, Converter={StaticResource BoolToVisibility}}" />
            <v:PlaceholderView Heading="분석 3"
                               Visibility="{Binding ShowAnalysis3, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</Window>
