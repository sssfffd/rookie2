<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <runtime>
    <!-- 모니터별 DPI.
         WPF 는 원래 화면 배율에 맞춰 알아서 커집니다(단위가 픽셀이 아니라
         DIP 라서). 다만 "창을 다른 배율의 모니터로 옮겼을 때 다시 그리는" 것은
         .NET Framework 4.6.2 에서 들어온 기능이고, 그 아래를 대상으로 빌드한
         앱에서는 기본으로 꺼져 있습니다. 여기서 명시로 켭니다.

         이 설정은 "빌드 대상" 이 아니라 "그 PC 에 깔린 런타임" 이 읽습니다.
         윈도우 10/11 은 4.8 을 들고 있으므로 그대로 동작하고, 4.6.1 까지만
         있는 윈도우 7 에서는 조용히 무시되면서 시스템 배율로 돕니다. -->
    <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false" />
  </runtime>
</configuration>
