<UserControl x:Class="LogScope.Analysis3.Analysis3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:LogScope.Common"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="760"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <!--
      아직 만들지 않은 분석 화면. 진짜로 아무것도 안 그리면 프로그램이
      멈춘 것처럼 보여서, 여기가 어디인지만 적어 둡니다.

      <b>이 폴더(Analysis3)는 통째로 갈아 끼우는 자리입니다</b> (1.27).
      따로 만든 분석 3 폴더를 이 폴더 자리에 그대로 덮어 넣으면 됩니다.
      지킬 것은 하나 — 그 폴더에도 LogScope.Analysis3.Analysis3View
      (UserControl) 가 있어야 합니다. 창(Shell/ShellWindow.xaml)이 이 이름을
      띄웁니다. 파일 목록은 tools/Analysis3.targets 가 폴더에서 저절로 찾으므로
      csproj 에 적지 않습니다. 자세한 것은 docs/ANALYSIS3-PORTING.md.
    -->
    <Border Background="{DynamicResource Brush.Window}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
            <TextBlock x:Name="TitleText" Text="분석" Style="{StaticResource H1}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static common:CommonTexts.PlaceholderNote}" Style="{StaticResource Muted}"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,14,0,0"
                       Text="{x:Static common:CommonTexts.PlaceholderLogScopeNote}" />
        </StackPanel>
    </Border>
</UserControl>
