<UserControl x:Class="LogScope.Analysis2.DbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:db="clr-namespace:LogScope.Analysis2"
             xmlns:t="clr-namespace:LogScope.Analysis2"
             xmlns:common="clr-namespace:LogScope.Common"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="760"
             d:DataContext="{x:Static common:DesignData.Db}"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <!--
          목록 줄. 기본 모양(ListRow)을 그대로 쓰고 마우스 설명만 답니다.
          BasedOn 을 빼면 테마의 줄 모양이 통째로 사라집니다.
          칸이 좁아 잘린 값은 짚어 보지 않으면 읽을 수가 없습니다.
        -->
        <Style x:Key="DiffRow" TargetType="{x:Type ListViewItem}"
               BasedOn="{StaticResource ListRow}">
            <Setter Property="ToolTip" Value="{Binding Tip}" />
            <!--
              줄 색. 어느 색인지는 Core 가 정합니다 (DbDiffLine.Mark) —
              어느 줄을 칠할지는 화면이 정하지 않습니다.
              색 자체는 테마에 있습니다 (밝은/어두운 테마에서 다릅니다).

              마우스 올림과 고름은 ListRow 의 템플릿 트리거가 직접 칠하므로
              이 색보다 앞섭니다 — 칠한 줄도 고르면 고른 표시가 보입니다.
            -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mark}"
                             Value="{x:Static db:DbDiffLine.MarkValue}">
                    <Setter Property="Background" Value="{DynamicResource Brush.BadSoft}" />
                </DataTrigger>
                <!--
                  두 쪽이 <b>같은</b> 줄은 옅은 초록 (1.12). [전체] 로 볼 때만
                  목록에 들어오는 줄입니다. Mark 로 칠하지 않고 Change 로 칠하는
                  까닭: Mark 가 비어 있지 않은 줄은 "차이 발생" 으로 세어집니다
                  (DbDiffList.Count). 같은 줄에 Mark 를 붙이면 개수가 늘어납니다.
                -->
                <DataTrigger Binding="{Binding Change}"
                             Value="{x:Static db:DbDiffLine.ChangeSame}">
                    <Setter Property="Background" Value="{DynamicResource Brush.GoodSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- 위: 어디를 견주는지와 단추들 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="{Binding ScreenTitle}" Style="{StaticResource H2}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="{x:Static t:DbTexts.Read}" Click="OnRead" Margin="0,0,6,0"
                            ToolTip="{x:Static t:DbTexts.ReadTip}" />
                    <Button Content="{x:Static t:DbTexts.ShowScript}" Click="OnShowScript" Margin="0,0,14,0"
                            ToolTip="{x:Static t:DbTexts.ShowScriptTip}" />

                    <!--
                      맞출 방향(이전 → 이후 / 이후 → 이전) 고르기를 뺐습니다.
                      늘 "이전 → 이후" 입니다 — 이전 DB 를 이후와 같게 만드는
                      글입니다. 만든 글의 머리에 어느 방향인지 적혀 있습니다.
                    -->
                </WrapPanel>

                <!--
                  견줄 DB 두 벌. <b>메인 화면의 로그 칸과 같은 모양</b>입니다 —
                  같은 일(끌어다 놓아 자리를 정하는 것)을 두 화면에서 다르게
                  생기게 둘 이유가 없습니다.

                  칸 안의 TextBox 에 AllowDrop="False" 가 붙어 있어야 합니다.
                  TextBox 는 파일 드롭을 받지도 않고 위로 올려 보내지도 않아서,
                  그게 없으면 칸의 거의 전부가 "놓아도 아무 일 없는" 자리가
                  됩니다 (0.80 에서 겪었습니다). 메인 화면 칸은 안에 TextBox 가
                  없어서 처음부터 됐던 것입니다.
                -->
                <!-- "견줄 DB (칸에 끌어다 놓으면 …)" 머리글을 1.06 에서 뺐습니다.
                     칸 자체가 테두리 상자라 놓을 자리로 보이고, [폴더] [파일]
                     단추 풍선말이 같은 말을 합니다. 줄 번호는 그대로 둡니다
                     (0 번 줄이 비어 높이 0). -->
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="1" Grid.Column="0" Tag="before|Brush.Window"
                            Background="{DynamicResource Brush.Window}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="4" Padding="9,7"
                            AllowDrop="True" DragOver="OnPathDragOver"
                            DragLeave="OnPathDragLeave" Drop="OnPathDrop">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{DynamicResource Brush.Before}" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static t:DbTexts.Text}" FontWeight="Bold" FontSize="12"
                                               Foreground="{DynamicResource Brush.Before}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{x:Static t:DbTexts.PickPath}" Tag="before" Click="OnPickPath"
                                            Padding="8,1" Margin="0,0,4,0"
                                            ToolTip="{x:Static t:DbTexts.PickPathTip}" />
                                    <Button Content="{x:Static t:DbTexts.PickFile}" Tag="before" Click="OnPickFile"
                                            Padding="8,1"
                                            ToolTip="{x:Static t:DbTexts.PickFileTip}" />
                                </StackPanel>
                            </Grid>

                            <TextBox Text="{Binding BeforePath, Mode=TwoWay}" AllowDrop="False"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="11" Margin="0,5,0,0" Padding="0"
                                     ToolTip="{Binding BeforePath}" />

                            <TextBlock Text="{Binding BeforeNote}" Style="{StaticResource Muted}"
                                       FontSize="10" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Tag="after|Brush.Window"
                            Background="{DynamicResource Brush.Window}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="4" Padding="9,7"
                            AllowDrop="True" DragOver="OnPathDragOver"
                            DragLeave="OnPathDragLeave" Drop="OnPathDrop">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{DynamicResource Brush.After}" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static t:DbTexts.Text2}" FontWeight="Bold" FontSize="12"
                                               Foreground="{DynamicResource Brush.After}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{x:Static t:DbTexts.PickPath}" Tag="after" Click="OnPickPath"
                                            Padding="8,1" Margin="0,0,4,0" />
                                    <Button Content="{x:Static t:DbTexts.PickFile}" Tag="after" Click="OnPickFile"
                                            Padding="8,1" />
                                </StackPanel>
                            </Grid>

                            <TextBox Text="{Binding AfterPath, Mode=TwoWay}" AllowDrop="False"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="11" Margin="0,5,0,0" Padding="0"
                                     ToolTip="{Binding AfterPath}" />

                            <TextBlock Text="{Binding AfterNote}" Style="{StaticResource Muted}"
                                       FontSize="10" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--
                  두 칸과 차이 목록 사이에 있던 글(자리 설명 · 판정 · "차이 발생
                  N개 · 없어진 IO …" · 읽기 알림)을 1.05 에서 뺐습니다. 판정과
                  개수는 메인 화면 분석 2 칸에 있고, 읽기 알림은 목록 머리의
                  ⚠ 에 마우스를 올리면 보입니다.
                -->
            </StackPanel>
        </Border>

        <!--
          왼쪽에 있던 표 목록(표 · 상태)을 없앴습니다. 차이 목록이 표
          이름을 칸으로 들고 있어서 같은 것을 두 군데서 보고 있었고,
          목록이 폭을 다 쓰는 쪽이 값을 읽기에 낫습니다.
        -->
            <!--
              차이 목록. 아래에 있던 "맞추는 SQL" 글 칸을 0.80 에서
              없앴습니다 — 목록이 창 높이를 다 쓰는 쪽이 값을 읽기에
              낫습니다. SQL 을 만드는 기능은 그대로 있습니다:
              위의 [SQL 글 저장] 이 지금 차이로 글을 만들어 파일로
              저장합니다 (화면에 띄우지만 않습니다).
            -->
                <!--
                  차이 목록. 칸마다 값 하나입니다.

                  글 한 덩이로 적던 것을 목록으로 바꿨습니다. 값이 바뀐 행은
                  바뀐 열마다 한 줄이라, 같은 열이 몇 군데서 바뀌었는지가
                  보입니다.
                -->
                <!--
                  <b>카드</b>로 띄웁니다 (1.14). 전에는 목록이 창 왼쪽 끝부터
                  오른쪽 끝까지 붙어 있었습니다. 바깥 여백(12)은 위쪽 칸의
                  안쪽 여백(12)과 같아서 [데이터 읽기] 줄 · 두 칸 · 목록의 왼쪽
                  끝이 한 줄로 맞습니다. 모양은 메인 화면 카드와 같습니다
                  (둥근 모서리 5 · 테두리 1).
                -->
                <Border Background="{DynamicResource Brush.Panel}" Padding="12,10,12,12">
                <Border Background="{DynamicResource Brush.Window}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="5">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.PanelAlt}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                            CornerRadius="4,4,0,0" Padding="10,5">
                        <WrapPanel>
                            <TextBlock Text="{x:Static t:DbTexts.Label}" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <!--
                              IO 검색 (1.17). 그래프 · 히트맵과 같은 규칙(NameSearch) —
                              IO 이름에 그 글자가 들면, 대소문자 안 가림. 치는 대로 바로
                              걸러집니다. 메인 화면 개수와 CSV 는 검색과 상관없습니다.
                            -->
                            <TextBlock Text="{x:Static t:DbTexts.Note}" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Width="160" VerticalContentAlignment="Center" Margin="0,0,2,0"
                                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                     ToolTip="{x:Static t:DbTexts.SearchTip}" />
                            <Button Content="{x:Static t:DbTexts.ClearSearch}" Padding="6,0" Margin="0,0,14,0"
                                    Click="OnClearSearch" ToolTip="{x:Static t:DbTexts.ClearSearchTip}" />
                            <!--
                              읽으면서 생긴 일(못 읽은 파일 · 키 없는 표 등). 있을
                              때만 ⚠ 하나가 뜨고, 마우스를 올리면 다 보입니다.
                              아예 빼면 파일 하나를 못 읽어도 모르고 지나갑니다 —
                              그러면 그 파일의 IO 가 "없어진 IO" 로 잡힙니다.
                            -->
                            <TextBlock Text="{x:Static t:DbTexts.Text3}" FontSize="13" VerticalAlignment="Center"
                                       Margin="0,0,12,0" Cursor="Help"
                                       Foreground="{DynamicResource Brush.Warn}"
                                       ToolTip="{Binding Notes}"
                                       Visibility="{Binding Notes, Converter={StaticResource TextToVisibility}}" />
                            <!--
                              무엇을 보여 줄지. <b>둘 중 하나</b> (1.11): [차이 발생] ·
                              [전체]. 1.10 까지 맨 앞에 있던 [값이 달라진 것만] 은
                              뺐고, [차이 전체] · [모든 IO] 는 이름을 바꿨습니다.

                              0.97 까지는 [차이가 발생한 IO만 보기] 켜고 끄기
                              둘뿐이었는데, 끈 상태가 "모든 IO" 가 아니었습니다 —
                              두 쪽이 같은 IO 는 어느 쪽에서도 안 보였습니다.
                              이름이 그렇게 읽혀서 "모든 IO 가 안 보인다" 는
                              말을 들었습니다. 이제 셋을 글자로 적어 둡니다.
                            -->
                            <TextBlock Text="{x:Static t:DbTexts.ViewAllDiffsLabel}" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <RadioButton GroupName="dbview" Style="{StaticResource SegmentButton}"
                                         Content="{x:Static t:DbTexts.ViewAllDiffs}"
                                         IsChecked="{Binding ViewAllDiffs, Mode=TwoWay}"
                                         ToolTip="{x:Static t:DbTexts.ViewAllDiffsTip}" />
                            <RadioButton GroupName="dbview" Style="{StaticResource SegmentButton}"
                                         Content="{x:Static t:DbTexts.ViewEveryIo}"
                                         IsChecked="{Binding ViewEveryIo, Mode=TwoWay}"
                                         Margin="0,0,14,0"
                                         ToolTip="{x:Static t:DbTexts.ViewEveryIoTip}" />

                            <!-- 색이 무슨 뜻인지. 색만 칠해 두고 말을 안 하면 못 읽습니다. -->
                            <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.BadSoft}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                            <TextBlock Text="{x:Static t:DbTexts.Note2}" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <!-- 초록 설명은 같은 줄이 보이는 [전체] 일 때만 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding ViewEveryIo, Converter={StaticResource BoolToVisibility}}">
                                <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.GoodSoft}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                                <TextBlock Text="{x:Static t:DbTexts.Note3}" Style="{StaticResource Muted}"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                            </StackPanel>

                            <Button Content="{x:Static t:DbTexts.SaveList}" Click="OnSaveList"
                                    ToolTip="{x:Static t:DbTexts.SaveListTip}" />
                        </WrapPanel>
                    </Border>

                    <Grid>
                        <!--
                          칸 폭은 <b>목록 폭에 맞춰</b> 코드가 정합니다 (1.14,
                          DbView.FitColumns): IO명 40% · 이전 30% · 이후 30%.
                          아래 Width 는 처음 그려질 때만 쓰입니다.
                        -->
                        <ListView x:Name="DiffList" ItemsSource="{Binding Lines}"
                                  Background="Transparent"
                                  ItemContainerStyle="{StaticResource DiffRow}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView>
                                    <!--
                                      칸 이름(머리글)은 여기 적지 않았습니다.
                                      src/LogScope/Analysis2/DbNames.cs 한 곳에 있고,
                                      out\config.txt 에 "db.col.v1 = 설정값" 을
                                      적으면 빌드 없이 바뀝니다. 아래 줄은
                                      "어떤 칸을 어떤 폭으로 보일지" 만 정합니다.

                                      Binding 이 아니라 x:Static 인 이유: 목록
                                      칸은 화면 나무에 없어서 Binding 이 조용히
                                      실패하고 머리글이 빈 채로 나옵니다.

                                      칸은 셋입니다 — IO명 · 이전 value ·
                                      이후 value. 0.87 에서 v1 · v2 를
                                      뺐고, 표 칸은 0.79 에서 뺐습니다.
                                      열 이름은 줄에 마우스를 올리면 뜨는
                                      글에 그대로 있습니다.
                                    -->
                                    <GridViewColumn Header="{x:Static db:DbNames.Io}" Width="360"
                                                    DisplayMemberBinding="{Binding Io}" />
                                    <GridViewColumn Header="{x:Static db:DbNames.Before}" Width="220"
                                                    DisplayMemberBinding="{Binding Before}" />
                                    <!--
                                      이후 값 옆에 <b>얼마나 달라졌나</b>를 빨간 글씨로
                                      (1.08). 숫자면 "(+3)", 아니면 "(OPEN → CLOSE)".
                                      값이 달라진 줄에서만 채워집니다 (DbDiffLine.Delta).
                                      칸을 따로 두지 않은 것은 이후 값과 붙어 있어야
                                      "무엇이 얼마나" 가 한 번에 읽혀서입니다.
                                    -->
                                    <GridViewColumn Header="{x:Static db:DbNames.After}" Width="300">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding After}" />
                                                    <TextBlock Text="{Binding Delta}" Margin="8,0,0,0"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.Bad}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- 비었을 때. 왜 비었는지는 그때마다 다릅니다. -->
                        <TextBlock Text="{Binding EmptyText}" Margin="16,40,16,0"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LinesIsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
                </Border>
                </Border>

    </DockPanel>
</UserControl>
