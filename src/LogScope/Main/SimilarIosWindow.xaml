<Window x:Class="LogScope.Main.SimilarIosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:main="clr-namespace:LogScope.Main"
        xmlns:t="clr-namespace:LogScope.Main"
        Title="{x:Static t:MainTexts.SimilarTitle}" Width="760" Height="500" MinWidth="520" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="12">

    <!--
      메인 분석 1 칸의 알림 줄 "파형은 같고 조금 어긋난 IO" 를 누르면 뜨는 창 (1.74).
      IO 하나에 한 줄 — 어떻게 어긋났는지 사람 말로 ("이후가 1.2초 늦음", "이후 값이 0.3 높음"), 어느 단계 · 몇 구간.
      줄마다 고르고 아래 단추로 한꺼번에 허용 (SimilarIosVm.AllowSelected → MainVm.AllowMany). [그래프] 는 그 IO 의 첫 구간.
    -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,12,16,8">
            <StackPanel>
                <TextBlock Text="{x:Static t:MainTexts.SimilarTitle}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Margin="0,4,0,0"
                           Foreground="{DynamicResource Brush.Warn}" />
                <TextBlock Text="{x:Static t:MainTexts.SimilarHelp}" Style="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="{x:Static t:MainTexts.SimilarSelectAll}" Click="OnSelectAll" Margin="0,0,4,0" Padding="8,3" />
                    <Button Content="{x:Static t:MainTexts.SimilarSelectNone}" Click="OnSelectNone" Padding="8,3" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static t:MainTexts.SimilarAllowOnce}" Click="OnAllowOnce"
                            ToolTip="{x:Static t:MainTexts.SimilarAllowOnceTip}" Margin="0,0,6,0" Padding="10,3" />
                    <Button Content="{x:Static t:MainTexts.SimilarAllowAlways}" Click="OnAllowAlways"
                            ToolTip="{x:Static t:MainTexts.SimilarAllowAlwaysTip}" Margin="0,0,12,0" Padding="10,3" />
                    <Button Content="{x:Static t:MainTexts.IoErrorsClose}" MinWidth="90"
                            IsCancel="True" Style="{StaticResource PrimaryButton}" Click="OnClose" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="16,0,16,8">
            <TextBlock Text="{x:Static t:MainTexts.SimilarNone}" Style="{StaticResource Muted}"
                       Visibility="{Binding NoRows, Converter={StaticResource BoolToVisibility}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type main:SimilarIoRowVm}">
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,6,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                              VerticalAlignment="Top" Margin="0,2,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Io}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Io}" Margin="0,1,10,0" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Brush.Muted}" />
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="{x:Static t:MainTexts.ShowGraph}" Click="OnGraph"
                                            ToolTip="{x:Static t:MainTexts.ErrorGraphTip}"
                                            VerticalAlignment="Top" MinHeight="0" Padding="7,2" Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
