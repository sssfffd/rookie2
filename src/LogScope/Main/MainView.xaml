<UserControl x:Class="LogScope.Main.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:main="clr-namespace:LogScope.Main"
             xmlns:t="clr-namespace:LogScope.Main"
             xmlns:common="clr-namespace:LogScope.Common"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="760"
             d:DataContext="{x:Static common:DesignData.Main}"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <!--
      1.92: 판정 등 (정상 · 주의 · 이상) — 왼쪽 기둥과 칸 머리가 같은 모양. LampGrade (good · warn · bad · none) 로 색.
    -->
    <UserControl.Resources>
        <Style x:Key="LampBadge" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LampGrade}" Value="{x:Static main:ScoreBands.GradeGood}">
                    <Setter Property="Background" Value="{DynamicResource Brush.GoodSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LampGrade}" Value="{x:Static main:ScoreBands.GradeWarn}">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LampGrade}" Value="{x:Static main:ScoreBands.GradeBad}">
                    <Setter Property="Background" Value="{DynamicResource Brush.BadSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bad}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LampText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LampGrade}" Value="{x:Static main:ScoreBands.GradeGood}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LampGrade}" Value="{x:Static main:ScoreBands.GradeWarn}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LampGrade}" Value="{x:Static main:ScoreBands.GradeBad}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 1.94: 대시보드 칸 (Grafana 패널처럼 — 작은 회색 이름 · 큰 숫자 · 작은 설명) -->
        <Style x:Key="DashTile" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style x:Key="DashTileLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        </Style>
        <Style x:Key="DashTileNote" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        </Style>
        <Style x:Key="DashBig" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Style.Triggers>
                <!-- 1.95: 결과가 없으면 "결과 없음" 을 작게 (큰 글자면 칸에서 잘림) -->
                <DataTrigger Binding="{Binding Dash.HasResult}" Value="False">
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 1.97: 분석 2 · 3 칸의 판정 낱말 — 결과가 없으면 왼쪽 칸들의 "결과 없음" 과 같은 글꼴 (16 · 보통 · 흐림) -->
        <Style x:Key="LampWordTile" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LampText}">
            <Setter Property="FontSize" Value="22" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LampGrade}" Value="{x:Static main:ScoreBands.GradeNone}">
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 1.97: 판정 표시는 그림 하나 (LampIcon) — 결과가 없으면 감춤 (왼쪽 칸들처럼 "결과 없음" 글자만) -->
        <Style x:Key="LampIconTile" TargetType="{x:Type main:LampIcon}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LampGrade}" Value="{x:Static main:ScoreBands.GradeNone}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashUnit" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="4,0,0,5" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        </Style>
        <Style x:Key="DashHead" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- 아주 넓은 화면에서 칸이 끝없이 늘어나지 않게 가둡니다. 1.92: 왼쪽 판정 기둥 (230) 만큼 넓힘 1180 → 1400. -->
        <StackPanel Margin="20,16,20,22" MaxWidth="1400" HorizontalAlignment="Stretch">

            <!-- "분석 결과" 와, History 를 펼쳐 보는 중이면 그 띠 (1.42). 칸 셋이 지금 결과가
                 아니라는 것이 한눈에 보여야 합니다 — 안 그러면 옛 요약을 지금 것으로 읽습니다. -->
            <Grid Margin="2,4,6,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static t:MainTexts.Heading}" Style="{StaticResource H1}"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{DynamicResource Brush.AccentSoft}"
                        BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                        CornerRadius="4" Padding="10,2,4,2" Margin="14,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Visibility="{Binding IsViewingHistory, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ViewingText}" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent}" TextTrimming="CharacterEllipsis" />
                        <Button Content="{x:Static t:MainTexts.ShowLive}" Click="OnShowLive"
                                ToolTip="{x:Static t:MainTexts.ShowLiveTip}"
                                Height="24" MinHeight="0" Padding="10,0" Margin="12,0,0,0" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--
              분석 칸. 셋을 <b>가로로</b> 나란히 놓고 폭을 똑같이 나눕니다.

              WrapPanel 이 아니라 UniformGrid 인 이유가 있습니다. WrapPanel 은
              좁아지면 한 칸이 아래로 내려가 2+1 로 접힙니다. 셋이 나란히
              있어야 견줘 보이는 것이라, 좁아지면 다 같이 좁아지는 편이
              낫습니다.

              칸 전체가 단추입니다. 요청은 "점수를 누르면" 이었지만 점수만
              눌리게 하면 과녁이 너무 작습니다. 칸 어디를 눌러도 같은 자리로
              갑니다 — 점수도 그 안에 들어 있습니다.
            -->
            <!--
              1.83: 분석 1 이 메인 — 위에 <b>한 줄 통째로</b> 크게, 분석 2 · 3 은 그 아래 나란히 (사용자 요청).
              자리는 칸 VM 의 LayoutRow · LayoutColumn · LayoutSpan (AnalysisCardVm).
            -->
            <!--
              1.94: 위쪽 <b>대시보드</b> (사용자 요청 — Grafana 숫자 패널 · Splunk 타임라인 · 장비 모니터링 타일 · WhaTap Top-N).
              시안: claude-log/189. 값은 MainVm.Dash (MainDashVm) — 점수와 같은 셈 (JudgeScore). 최종 판정은 OverallVm,
              분석 2 · 3 패널은 그 칸 VM 의 판정 등 그대로. 아래 "분석별 자세히" 가 예전 분석 칸 (파일 넣기 · [분석] · 그룹 줄).

                [최종 판정 ──][점수 게이지][차이 IO][평균 오차율][로그 길이][분석 2][분석 3]
                [시간대별 차이 ▁▃▇█▇▃▁ + 공정 단계 띠 + 시각]
                [차이 큰 IO (Top 8) ─────────────][그룹 상태 타일]
            -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 최종 판정 -->
                <Border Grid.Column="0" DataContext="{Binding Overall}" Style="{StaticResource LampBadge}"
                        CornerRadius="8" Padding="16,12" Margin="6">
                    <!-- 1.97: 이름 줄 아래 남는 높이의 가운데에 판정 (결과가 없을 때 "결과 없음" 이 위에 붙지 않게) -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Static t:MainTexts.FinalVerdictTile}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Muted}" />
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <main:LampIcon Width="24" Height="24" Grade="{Binding LampGrade}" Style="{StaticResource LampIconTile}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Word}" FontSize="32" Style="{StaticResource LampText}" />
                            <!-- 2.04: 정상 · 주의 일 때 오른쪽에 종합 점수 (셈법은 마우스를 올리면) -->
                            <TextBlock Text="{Binding ScoreBeside}" FontSize="22" Margin="12,0,0,3" VerticalAlignment="Bottom"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" ToolTip="{Binding CompositeTip}"
                                       Visibility="{Binding HasScoreBeside, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <!-- 2.02: 넉아웃으로 판정이 바뀌었으면 그 까닭 (2.04 — 점수는 낱말 옆으로) -->
                        <TextBlock Text="{Binding GateNote}" FontSize="11" Foreground="{DynamicResource Brush.Muted}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding CompositeTip}"
                                   Visibility="{Binding HasGateNote, Converter={StaticResource BoolToVisibility}}" />
                        <!--
                          2.00: 결과가 있는 분석마다 두 줄 — [색 점] 분석 이름 / 무엇이 있었나 (사용자 요청 — 예전 근거 · 몰린 단계 ·
                          "이름 판정" 글은 뺌). 한글이 낱자 사이에서 꺾이지 않게 줄바꿈 없이, 넘치면 … 과 마우스 글.
                        -->
                        <ItemsControl ItemsSource="{Binding Lines}" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type main:OverallLine}">
                                    <Grid Margin="0,3,0,0" ToolTip="{Binding Text}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <main:LampIcon Width="10" Height="10" Grade="{Binding LampGrade}" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Text}" FontSize="12"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </Grid>
                </Border>

                <!-- 점수 -->
                <Border Grid.Column="1" Style="{StaticResource DashTile}">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:MainTexts.ScoreTile}" Style="{StaticResource DashTileLabel}" />
                        <main:ScoreGauge Height="84" Margin="0,4,0,0" Value="{Binding Dash.Score}" Grade="{Binding Dash.ScoreGrade}" />
                        <TextBlock Text="{Binding Dash.BandsText}" FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap"
                                   TextAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
                        <!-- 2.00: IO 하나의 영향 상한에 걸린 IO — 점수는 덜 떨어지되 알 수는 있게 -->
                        <TextBlock Text="{Binding Dash.CapNote}" FontSize="10" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Dash.CapNote}"
                                   Foreground="{DynamicResource Brush.Warn}" Margin="0,2,0,0"
                                   Visibility="{Binding Dash.HasCapNote, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- 차이 IO -->
                <Border Grid.Column="2" Style="{StaticResource DashTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding Dash.DiffLabel}" Style="{StaticResource DashTileLabel}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                            <TextBlock Text="{Binding Dash.DiffMain}" Style="{StaticResource DashBig}" />
                            <TextBlock Text="{Binding Dash.DiffTotal}" Style="{StaticResource DashUnit}" />
                        </StackPanel>
                        <main:RateBar Height="10" TimeRate="{Binding Dash.DiffSharePercent}" WeightedRate="{Binding Dash.DiffSharePercent}"
                                      Grade="{Binding Dash.DiffGrade}" />
                        <TextBlock Text="{Binding Dash.DiffBreak}" Style="{StaticResource DashTileNote}" />
                    </StackPanel>
                </Border>

                <!-- 평균 오차율 -->
                <Border Grid.Column="3" Style="{StaticResource DashTile}">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:MainTexts.RateTile}" Style="{StaticResource DashTileLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="{Binding Dash.RateMain}" Style="{StaticResource DashBig}" />
                            <TextBlock Text="{Binding Dash.PercentUnit}" Style="{StaticResource DashUnit}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Dash.RateSub}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <!-- 1.95: 기준 설명은 칸에서 안 잘리게 줄바꿈 -->
                        <TextBlock Text="{x:Static t:MainTexts.RateTileNote}" Style="{StaticResource DashTileNote}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 로그 길이 -->
                <Border Grid.Column="4" Style="{StaticResource DashTile}">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:MainTexts.LengthTile}" Style="{StaticResource DashTileLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="{Binding Dash.LengthMain}" Style="{StaticResource DashBig}" />
                            <TextBlock Text="{Binding Dash.PercentUnit}" Style="{StaticResource DashUnit}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Dash.LengthSub}" Style="{StaticResource DashTileNote}" TextWrapping="Wrap"
                                   ToolTip="{Binding Dash.LengthSub}" />
                    </StackPanel>
                </Border>

                <!-- 분석 2 · 3 — 칸 VM 의 판정 등 그대로 -->
                <Border Grid.Column="5" Style="{StaticResource DashTile}" DataContext="{Binding Cards[1]}" ToolTip="{Binding Meaning}">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource DashTileLabel}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <main:LampIcon Width="16" Height="16" Grade="{Binding LampGrade}" Style="{StaticResource LampIconTile}" />
                            <TextBlock Text="{Binding LampWord}" Style="{StaticResource LampWordTile}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource DashTile}" DataContext="{Binding Cards[2]}" ToolTip="{Binding Meaning}">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource DashTileLabel}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <main:LampIcon Width="16" Height="16" Grade="{Binding LampGrade}" Style="{StaticResource LampIconTile}" />
                            <TextBlock Text="{Binding LampWord}" Style="{StaticResource LampWordTile}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 결과가 없을 때 (또는 History 보는 중) -->
            <Border Style="{StaticResource DashTile}" Visibility="{Binding Dash.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Dash.EmptyText}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Visibility="{Binding Dash.HasResult, Converter={StaticResource BoolToVisibility}}">
                <!-- 시간대별 차이 -->
                <Border Style="{StaticResource DashTile}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static t:MainTexts.TimelineHeading}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Static t:MainTexts.TimelineNote}" FontSize="11" Margin="12,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="10" Height="10" Background="{DynamicResource Brush.Warn}" Margin="0,0,4,0" />
                                <TextBlock Text="{x:Static t:MainTexts.LegendOver}" FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,10,0" />
                                <Border Width="10" Height="10" Background="{DynamicResource Brush.Bad}" Margin="0,0,4,0" />
                                <TextBlock Text="{x:Static t:MainTexts.LegendBig}" FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,10,0" />
                                <Border Width="10" Height="10" Background="{DynamicResource Brush.BadSoft}" BorderBrush="{DynamicResource Brush.Bad}" BorderThickness="0.5" Margin="0,0,4,0" />
                                <TextBlock Text="{x:Static t:MainTexts.LegendGap}" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                            </StackPanel>
                        </Grid>
                        <main:TimelineStrip Height="196" Data="{Binding Dash.Timeline}" />
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 차이 큰 IO -->
                    <Border Grid.Column="0" Style="{StaticResource DashTile}">
                        <StackPanel>
                            <!-- 1.97: 제목 · 오차율순 (작게) · 막대 설명 · N개 중 상위 M개 -->
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{x:Static t:MainTexts.TopHeading}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static t:MainTexts.TopNote}" FontSize="11" Margin="8,2,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Muted}" />
                                <!-- 2.04: 발생 순서를 볼 단위 (0.1초 · 1초 · 10초) — 같은 단위 안에서는 최대 오차가 큰 IO 먼저 -->
                                <ComboBox ItemsSource="{Binding Dash.OnsetChoices}" SelectedIndex="{Binding Dash.OnsetIndex, Mode=TwoWay}"
                                          Width="70" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"
                                          ToolTip="{x:Static t:MainTexts.TopOnsetTip}" />
                                <StackPanel Orientation="Horizontal" Margin="16,2,0,0" VerticalAlignment="Center">
                                    <Border Width="18" Height="8" CornerRadius="1" Background="{DynamicResource Brush.Warn}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static t:MainTexts.TopBarTime}" FontSize="11" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Muted}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Dash.TopNote}" FontSize="11" FontWeight="SemiBold" Margin="16,2,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Muted}" />
                            </WrapPanel>
                            <TextBlock Text="{x:Static t:MainTexts.TopEmpty}" Foreground="{DynamicResource Brush.Muted}"
                                       Visibility="{Binding Dash.NoTopIos, Converter={StaticResource BoolToVisibility}}" />
                            <Grid Margin="0,0,0,4" Visibility="{Binding Dash.HasTopIos, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="판정" Style="{StaticResource DashHead}" />
                                <TextBlock Grid.Column="1" Text="IO" Style="{StaticResource DashHead}" />
                                <TextBlock Grid.Column="2" Text="그룹" Style="{StaticResource DashHead}" />
                                <TextBlock Grid.Column="3" Text="최대 오차율" Style="{StaticResource DashHead}" />
                                <TextBlock Grid.Column="4" Text="오차 시간" Style="{StaticResource DashHead}" TextAlignment="Right" HorizontalAlignment="Right"
                                           ToolTip="로그 시간 중 허용 오차 밖에 있던 비율" />
                                <TextBlock Grid.Column="5" Text="언제" Style="{StaticResource DashHead}" Margin="12,0,0,0" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Dash.TopIos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type main:DashIoRow}">
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="1.3*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="1.4*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource LampBadge}" Padding="6,1" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Word}" FontSize="12" Style="{StaticResource LampText}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Group}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Brush.Muted}" />
                                                <Grid Grid.Column="3" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <main:RateBar Height="10" TimeRate="{Binding PeakBar}" Grade="{Binding LampGrade}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding RateText}" Margin="8,0,0,0" FontSize="11" />
                                                </Grid>
                                                <TextBlock Grid.Column="4" Text="{Binding TimeText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="5" Text="{Binding WhenText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WhenText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 그룹 상태 -->
                    <Border Grid.Column="1" Style="{StaticResource DashTile}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{x:Static t:MainTexts.GroupHeading}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Static t:MainTexts.GroupNote}" FontSize="11" Margin="12,2,0,0" Foreground="{DynamicResource Brush.Muted}" />
                            </StackPanel>
                            <TextBlock Text="{x:Static t:MainTexts.GroupEmpty}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap"
                                       Visibility="{Binding Dash.NoGroups, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Dash.Groups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type main:DashGroupTile}">
                                        <Border Style="{StaticResource LampBadge}" CornerRadius="6" Padding="10,8" Margin="0,0,8,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Word}" FontSize="12" Margin="6,0,0,0" Style="{StaticResource LampText}" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Diff}" FontSize="20" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Total}" FontSize="12" Margin="4,0,0,3" VerticalAlignment="Bottom"
                                                               Foreground="{DynamicResource Brush.Muted}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <TextBlock Text="{x:Static t:MainTexts.DetailHeading}" Style="{StaticResource H2}" Margin="8,18,0,2" />
            <Grid>
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type ContentPresenter}">
                        <Setter Property="Grid.Row" Value="{Binding LayoutRow}" />
                        <Setter Property="Grid.Column" Value="{Binding LayoutColumn}" />
                        <Setter Property="Grid.ColumnSpan" Value="{Binding LayoutSpan}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type main:AnalysisCardVm}">
                        <!--
                          칸 전체가 단추이던 것을 되돌렸습니다. 칸 안에 누를
                          것(그룹 줄)이 생겼는데, 바깥까지 단추면 그룹을 누른
                          손이 칸도 같이 누릅니다. 이동은 오른쪽 위 화살표만
                          맡습니다.
                        -->
                        <!--
                          MinHeight 로 칸의 바닥 높이를 정합니다. UniformGrid 는
                          셋의 높이를 맞추므로 한 칸만 커져도 셋이 같이
                          커집니다. 가로로는 안 늘립니다 (가로는 화면 폭이
                          정합니다).

                          0.59 에 480 으로 뒀다가 0.65 에 390 으로 줄였습니다.
                          480 이면 1080 짜리 화면에서 메인 화면에 스크롤이
                          생겼습니다 — 한 화면에 다 들어오는 쪽이 "한눈에
                          본다" 는 이 화면의 뜻에 맞습니다. 요약이 길면
                          칸 안에서 굴립니다.
                        -->
                        <Border Background="{DynamicResource Brush.Panel}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="5" Padding="16,12" Margin="6" MinHeight="{Binding CardMinHeight}">
                            <Grid>
                                <StackPanel IsEnabled="{Binding IsUsable}">

                                    <!-- 번호표 · 이름 · (분석 3: 분석) · 이동 화살표 -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 1.95: 칸 머리의 판정 등은 뺌 (사용자 요청 — 판정은 위 대시보드에서) -->

                                        <Border Grid.Column="0" Background="{DynamicResource Brush.AccentSoft}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                CornerRadius="3" Padding="7,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" FontSize="11"
                                                       Foreground="{DynamicResource Brush.Accent}"
                                                       FontWeight="SemiBold" />
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource H2}"
                                                   VerticalAlignment="Center" Margin="9,0,6,0"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!--
                                          칸 머리의 [분석] — 1.35 에 분석 3 칸에만, 1.53 부터 칸 셋 모두.
                                          메인 칸에서 고르거나 놓기만 하면 읽지 않고, 이 단추를 눌러야 돕니다.
                                            분석 1 : 창이 기다리던 로그를 읽고 견줌 (ShellWindow.OnMainLogAnalyze)
                                            분석 2 : 분석 2 화면의 [읽기] 와 같음 (DbView.ReadNow)
                                            분석 3 : Common/Analysis3Link 의 AnalyzeRequested 가 울리고, 무엇을 할지는
                                                     분석 3 폴더의 코드가 정합니다 (갈아 끼우는 폴더라 여기서 직접 부르지 않음).

                                          머리 줄에 둔 까닭: 칸 셋의 이전/이후 · 요약 줄이 나란히 놓여야
                                          합니다. 칸 안에 줄을 하나 더 두면 분석 3 칸만 아래로 밀립니다.
                                          그래서 높이를 화살표 단추와 같은 26 으로 맞추고 (기본 단추는
                                          MinHeight 28 · 위아래 여백 3) 머리 줄 높이가 변하지 않게 합니다.
                                        -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                                                    Margin="0,0,6,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:MainTexts.A3Analyze}"
                                                    Click="OnCardAnalyze" Tag="{Binding Number}" ToolTip="{Binding AnalyzeTip}"
                                                    Height="26" MinHeight="0" Padding="10,0" Margin="0" FontSize="12" />
                                        </StackPanel>

                                        <Button Grid.Column="3" Style="{StaticResource ArrowButton}"
                                                Content="{x:Static t:MainTexts.CardClick}" Click="OnCardClick" Tag="{Binding Number}"
                                                VerticalAlignment="Top"
                                                ToolTip="{x:Static t:MainTexts.CardClickTip}" />
                                    </Grid>

                                    <!-- 1.96: 칸 머리 아래 "뜻" 줄은 뺌 (사용자 요청). 설명은 위 대시보드 분석 2 · 3 칸에 마우스를 올리면. -->
                                    <Border Height="6" />

                                    <!-- 점수 (또는 판정 낱말) — <b>한 줄, 높이 고정</b> (1.09).

                                         칸 셋이 나란히 있어서, 점수 자리 높이가 칸마다 다르면
                                         그 아래 이전/이후 줄이 칸마다 다른 높이에 놓입니다.
                                         그래서 높이를 정해 두고, 적을 것이 없어도 자리는
                                         남깁니다 (분석 2 는 DB 를 읽기 전에 아무것도 안 적습니다).

                                         1.06 에는 점수 아래 글(ScoreNote)까지 들어가게 54 로
                                         잡았는데, 파일을 넣으면 그 글이 비어 이전/이후 위에
                                         빈 줄 하나가 남았습니다. 이제 그 글은 <b>점수 오른쪽</b>
                                         에 작게 붙고, 높이는 점수 한 줄(30pt)만큼입니다.

                                         글자 크기: 분석 1 점수 = 분석 2 판정 낱말 = 차이 개수 =
                                         30 (ScoreSize). -->
                                    <Grid Height="42">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom"
                                                Visibility="{Binding HasScoreText, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock x:Name="ScoreText" Text="{Binding ScoreText}"
                                                   FontSize="{Binding ScoreSize}" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Muted}"
                                                   VerticalAlignment="Bottom" />
                                        <TextBlock Text="{Binding ScoreOutOf}" FontSize="16" Margin="6,0,0,8"
                                                   Foreground="{DynamicResource Brush.Muted}"
                                                   VerticalAlignment="Bottom" />

                                        <!--
                                          분석 2: 차이 발생 개수를 <b>낱말 오른쪽에</b> (1.03).
                                          CRITICAL 을 보는 눈이 바로 옆의 수로 이어집니다.
                                        -->
                                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                                                    VerticalAlignment="Bottom"
                                                    Visibility="{Binding VerdictCount, Converter={StaticResource TextToVisibility}}">
                                            <TextBlock Text="{x:Static t:MainTexts.Text}" FontSize="13" VerticalAlignment="Bottom"
                                                       Margin="0,0,8,6" Foreground="{DynamicResource Brush.Muted}" />
                                            <TextBlock x:Name="VerdictCountText" Text="{Binding VerdictCount}"
                                                       FontSize="{Binding ScoreSize}" FontWeight="Bold"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="{DynamicResource Brush.Text}" />
                                            <TextBlock Text="{x:Static t:MainTexts.Text2}" FontSize="13" VerticalAlignment="Bottom"
                                                       Margin="4,0,0,6" Foreground="{DynamicResource Brush.Muted}" />
                                        </StackPanel>

                                        <!--
                                          분석 1 (1.81): 점수 오른쪽에 "차이 5 / 120 IO", 그 아래 "평균 오차율 11.7 %".
                                          점수 줄 높이 (42) 안에 두 줄 — 칸마다 이전 · 이후 줄 높이가 그대로.
                                        -->
                                        <StackPanel Margin="16,0,0,1" VerticalAlignment="Bottom"
                                                    Visibility="{Binding HasCountBlock, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{x:Static t:MainTexts.CountBlockLabel}" FontSize="12" VerticalAlignment="Bottom"
                                                           Margin="0,0,6,3" Foreground="{DynamicResource Brush.Muted}" />
                                                <TextBlock Text="{Binding CountMain}" FontSize="18" FontWeight="Bold" VerticalAlignment="Bottom"
                                                           Foreground="{DynamicResource Brush.Text}" />
                                                <TextBlock Text="{x:Static t:MainTexts.CountBlockUnit}" FontSize="12" VerticalAlignment="Bottom"
                                                           Margin="5,0,0,3" Foreground="{DynamicResource Brush.Muted}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding CountSub}" FontSize="11" Margin="0,0,0,0"
                                                       Foreground="{DynamicResource Brush.Muted}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 점수 옆 작은 글 ("Log 파일을 비교한 후 점수가 나옵니다" 등).
                                         좁으면 … 로 자르고 마우스를 올리면 다 보입니다. -->
                                    <TextBlock Grid.Column="1" Text="{Binding ScoreNote}" Style="{StaticResource Muted}"
                                               FontSize="11" Margin="12,0,0,9" VerticalAlignment="Bottom"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ScoreNote}"
                                               Visibility="{Binding ScoreNote, Converter={StaticResource TextToVisibility}}" />
                                    </Grid>

                                    <!-- ===== 이 분석이 쓰는 로그 (분석 1) — 점수 바로 아래 (1.04) =====

                                         <b>모양이 둘</b>입니다. 한 자리에 두 Border 를 겹쳐
                                         두고 하나만 보입니다.

                                           열기 전 : 테두리 친 상자 — "여기 놓으라" 는 자리로
                                                     보여야 합니다 (0.99 의 모양)
                                           연 뒤   : 납작한 한 줄 — 이름만 읽히면 됩니다
                                                     (1.02 의 모양)

                                         두 모양을 Border 하나에 바인딩으로 바꿔 끼우지
                                         않은 까닭: 끌기가 끝나면 CardTag 가 Tag 에 적힌
                                         색으로 되돌리는데, Tag 와 색이 바인딩으로 함께
                                         바뀌면 그 둘이 어긋나는 순간이 생깁니다
                                         (0.59 · 1.02 에 겪은 모양). 둘로 두면 저마다 Tag 와
                                         색이 고정이라 검사기가 그 짝을 볼 수 있습니다.

                                         자리: 제목 → <b>점수</b> → 파일 → 숫자·요약 (1.04).
                                         결과가 맨 먼저, 무엇과 무엇을 견줬는지가 바로
                                         그 아래입니다. 1.02 에는 바닥, 1.03 에는 점수
                                         위였습니다.

                                         위·아래 어느 쪽을 보일지는 Hint / Shown 이 정확히
                                         엇갈리게 만들어 둬서 겹치거나 둘 다 사라지지
                                         않습니다. -->
                                    <Grid Margin="0,4,0,0"
                                          Visibility="{Binding HasLogBox, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="4" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Tag="before|Brush.Window"
                                                Background="{DynamicResource Brush.Window}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                CornerRadius="4" Padding="10,7" Cursor="Hand"
                                                AllowDrop="True" DragOver="OnDropCardDragOver"
                                                DragLeave="OnDropCardDragLeave" Drop="OnLogDrop"
                                                MouseLeftButtonUp="OnLogCardClick"
                                                Visibility="{Binding DataContext.BeforeHint, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TextToVisibility}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                                            Background="{DynamicResource Brush.Before}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{x:Static t:MainTexts.Text3}" FontWeight="Bold" FontSize="12"
                                                               Foreground="{DynamicResource Brush.Before}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"
                                                           Text="{Binding DataContext.BeforeHint, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="0" Tag="before|Brush.Panel|Brush.Panel"
                                                Background="{DynamicResource Brush.Panel}"
                                                BorderBrush="{DynamicResource Brush.Panel}" BorderThickness="1"
                                                CornerRadius="3" Padding="4,3" Cursor="Hand"
                                                ToolTip="{Binding DataContext.BeforePath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                AllowDrop="True" DragOver="OnDropCardDragOver"
                                                DragLeave="OnDropCardDragLeave" Drop="OnLogDrop"
                                                MouseLeftButtonUp="OnLogCardClick"
                                                Visibility="{Binding DataContext.BeforeShown, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TextToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                                        Background="{DynamicResource Brush.Before}" />
                                                <TextBlock Grid.Column="1" Text="{x:Static t:MainTexts.Text3}" FontWeight="Bold" FontSize="12"
                                                           Foreground="{DynamicResource Brush.Before}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding DataContext.BeforeShown, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                <TextBlock Grid.Column="3" FontSize="10" VerticalAlignment="Center"
                                                           Style="{StaticResource Muted}" Margin="8,0,0,0"
                                                           Text="{Binding DataContext.BeforeDetail, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="2" Tag="after|Brush.Window"
                                                Background="{DynamicResource Brush.Window}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                CornerRadius="4" Padding="10,7" Cursor="Hand"
                                                AllowDrop="True" DragOver="OnDropCardDragOver"
                                                DragLeave="OnDropCardDragLeave" Drop="OnLogDrop"
                                                MouseLeftButtonUp="OnLogCardClick"
                                                Visibility="{Binding DataContext.AfterHint, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TextToVisibility}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                                            Background="{DynamicResource Brush.After}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{x:Static t:MainTexts.Text4}" FontWeight="Bold" FontSize="12"
                                                               Foreground="{DynamicResource Brush.After}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"
                                                           Text="{Binding DataContext.AfterHint, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="2" Tag="after|Brush.Panel|Brush.Panel"
                                                Background="{DynamicResource Brush.Panel}"
                                                BorderBrush="{DynamicResource Brush.Panel}" BorderThickness="1"
                                                CornerRadius="3" Padding="4,3" Cursor="Hand"
                                                ToolTip="{Binding DataContext.AfterPath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                AllowDrop="True" DragOver="OnDropCardDragOver"
                                                DragLeave="OnDropCardDragLeave" Drop="OnLogDrop"
                                                MouseLeftButtonUp="OnLogCardClick"
                                                Visibility="{Binding DataContext.AfterShown, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TextToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                                        Background="{DynamicResource Brush.After}" />
                                                <TextBlock Grid.Column="1" Text="{x:Static t:MainTexts.Text4}" FontWeight="Bold" FontSize="12"
                                                           Foreground="{DynamicResource Brush.After}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding DataContext.AfterShown, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                <TextBlock Grid.Column="3" FontSize="10" VerticalAlignment="Center"
                                                           Style="{StaticResource Muted}" Margin="8,0,0,0"
                                                           Text="{Binding DataContext.AfterDetail, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- ===== 이 분석이 견줄 자리 (분석 2) — 분석 1 과 같은 두 모양 =====
                                         폴더도 파일도 됩니다. 누르면 파일 고르는 창
                                         (폴더는 끌어다 놓기). 둘 다 차면 바로 읽습니다. -->
                                    <Grid Margin="0,4,0,0"
                                          Visibility="{Binding HasDbBox, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="4" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Tag="before|Brush.Window"
                                                Background="{DynamicResource Brush.Window}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                CornerRadius="4" Padding="10,7" Cursor="Hand"
                                                AllowDrop="True" DragOver="OnDropCardDragOver"
                                                DragLeave="OnDropCardDragLeave" Drop="OnDbDrop"
                                                MouseLeftButtonUp="OnDbCardClick"
                                                Visibility="{Binding DataContext.DbBeforeHint, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TextToVisibility}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                                            Background="{DynamicResource Brush.Before}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{x:Static t:MainTexts.Text3}" FontWeight="Bold" FontSize="12"
                                                               Foreground="{DynamicResource Brush.Before}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"
                                                           Text="{Binding DataContext.DbBeforeHint, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="0" Tag="before|Brush.Panel|Brush.Panel"
                                                Background="{DynamicResource Brush.Panel}"
                                                BorderBrush="{DynamicResource Brush.Panel}" BorderThickness="1"
                                                CornerRadius="3" Padding="4,3" Cursor="Hand"
                                                ToolTip="{Binding DataContext.DbBeforePath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                AllowDrop="True" DragOver="OnDropCardDragOver"
                                                DragLeave="OnDropCardDragLeave" Drop="OnDbDrop"
                                                MouseLeftButtonUp="OnDbCardClick"
                                                Visibility="{Binding DataContext.DbBeforeName, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TextToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                                        Background="{DynamicResource Brush.Before}" />
                                                <TextBlock Grid.Column="1" Text="{x:Static t:MainTexts.Text3}" FontWeight="Bold" FontSize="12"
                                                           Foreground="{DynamicResource Brush.Before}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding DataContext.DbBeforeName, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                <TextBlock Grid.Column="3" FontSize="10" VerticalAlignment="Center"
                                                           Style="{StaticResource Muted}" Margin="8,0,0,0"
                                                           Text="{Binding DataContext.DbBeforeKind, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="2" Tag="after|Brush.Window"
                                                Background="{DynamicResource Brush.Window}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                CornerRadius="4" Padding="10,7" Cursor="Hand"
                                                AllowDrop="True" DragOver="OnDropCardDragOver"
                                                DragLeave="OnDropCardDragLeave" Drop="OnDbDrop"
                                                MouseLeftButtonUp="OnDbCardClick"
                                                Visibility="{Binding DataContext.DbAfterHint, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TextToVisibility}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                                            Background="{DynamicResource Brush.After}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{x:Static t:MainTexts.Text4}" FontWeight="Bold" FontSize="12"
                                                               Foreground="{DynamicResource Brush.After}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"
                                                           Text="{Binding DataContext.DbAfterHint, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="2" Tag="after|Brush.Panel|Brush.Panel"
                                                Background="{DynamicResource Brush.Panel}"
                                                BorderBrush="{DynamicResource Brush.Panel}" BorderThickness="1"
                                                CornerRadius="3" Padding="4,3" Cursor="Hand"
                                                ToolTip="{Binding DataContext.DbAfterPath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                AllowDrop="True" DragOver="OnDropCardDragOver"
                                                DragLeave="OnDropCardDragLeave" Drop="OnDbDrop"
                                                MouseLeftButtonUp="OnDbCardClick"
                                                Visibility="{Binding DataContext.DbAfterName, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TextToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                                        Background="{DynamicResource Brush.After}" />
                                                <TextBlock Grid.Column="1" Text="{x:Static t:MainTexts.Text4}" FontWeight="Bold" FontSize="12"
                                                           Foreground="{DynamicResource Brush.After}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding DataContext.DbAfterName, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                <TextBlock Grid.Column="3" FontSize="10" VerticalAlignment="Center"
                                                           Style="{StaticResource Muted}" Margin="8,0,0,0"
                                                           Text="{Binding DataContext.DbAfterKind, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- ===== 분석 3 의 이전 · 이후 (1.29) — 분석 2 칸과 같은 두 모양 =====
                                         자리는 Common/Analysis3Link 에 적히고 분석 3 화면이
                                         거기서 읽습니다. 누르면 파일 고르는 창, 폴더는 끌어다 놓기. -->
                                    <Grid Margin="0,4,0,0"
                                          Visibility="{Binding HasA3Box, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="4" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Tag="before|Brush.Window"
                                                Background="{DynamicResource Brush.Window}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                CornerRadius="4" Padding="10,7" Cursor="Hand"
                                                AllowDrop="True" DragOver="OnDropCardDragOver"
                                                DragLeave="OnDropCardDragLeave" Drop="OnA3Drop"
                                                MouseLeftButtonUp="OnA3CardClick"
                                                Visibility="{Binding DataContext.A3BeforeHint, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TextToVisibility}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                                            Background="{DynamicResource Brush.Before}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{x:Static t:MainTexts.Text3}" FontWeight="Bold" FontSize="12"
                                                               Foreground="{DynamicResource Brush.Before}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"
                                                           Text="{Binding DataContext.A3BeforeHint, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="0" Tag="before|Brush.Panel|Brush.Panel"
                                                Background="{DynamicResource Brush.Panel}"
                                                BorderBrush="{DynamicResource Brush.Panel}" BorderThickness="1"
                                                CornerRadius="3" Padding="4,3" Cursor="Hand"
                                                ToolTip="{Binding DataContext.A3BeforePath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                AllowDrop="True" DragOver="OnDropCardDragOver"
                                                DragLeave="OnDropCardDragLeave" Drop="OnA3Drop"
                                                MouseLeftButtonUp="OnA3CardClick"
                                                Visibility="{Binding DataContext.A3BeforeName, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TextToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                                        Background="{DynamicResource Brush.Before}" />
                                                <TextBlock Grid.Column="1" Text="{x:Static t:MainTexts.Text3}" FontWeight="Bold" FontSize="12"
                                                           Foreground="{DynamicResource Brush.Before}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding DataContext.A3BeforeName, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                <TextBlock Grid.Column="3" FontSize="10" VerticalAlignment="Center"
                                                           Style="{StaticResource Muted}" Margin="8,0,0,0"
                                                           Text="{Binding DataContext.A3BeforeKind, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="2" Tag="after|Brush.Window"
                                                Background="{DynamicResource Brush.Window}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                CornerRadius="4" Padding="10,7" Cursor="Hand"
                                                AllowDrop="True" DragOver="OnDropCardDragOver"
                                                DragLeave="OnDropCardDragLeave" Drop="OnA3Drop"
                                                MouseLeftButtonUp="OnA3CardClick"
                                                Visibility="{Binding DataContext.A3AfterHint, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TextToVisibility}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                                            Background="{DynamicResource Brush.After}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{x:Static t:MainTexts.Text4}" FontWeight="Bold" FontSize="12"
                                                               Foreground="{DynamicResource Brush.After}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"
                                                           Text="{Binding DataContext.A3AfterHint, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="2" Tag="after|Brush.Panel|Brush.Panel"
                                                Background="{DynamicResource Brush.Panel}"
                                                BorderBrush="{DynamicResource Brush.Panel}" BorderThickness="1"
                                                CornerRadius="3" Padding="4,3" Cursor="Hand"
                                                ToolTip="{Binding DataContext.A3AfterPath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                AllowDrop="True" DragOver="OnDropCardDragOver"
                                                DragLeave="OnDropCardDragLeave" Drop="OnA3Drop"
                                                MouseLeftButtonUp="OnA3CardClick"
                                                Visibility="{Binding DataContext.A3AfterName, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TextToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                                        Background="{DynamicResource Brush.After}" />
                                                <TextBlock Grid.Column="1" Text="{x:Static t:MainTexts.Text4}" FontWeight="Bold" FontSize="12"
                                                           Foreground="{DynamicResource Brush.After}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding DataContext.A3AfterName, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                <TextBlock Grid.Column="3" FontSize="10" VerticalAlignment="Center"
                                                           Style="{StaticResource Muted}" Margin="8,0,0,0"
                                                           Text="{Binding DataContext.A3AfterKind, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- 그 분석이 실제로 센 숫자들 -->
                                    <ItemsControl ItemsSource="{Binding Stats}" Margin="0,12,0,0"
                                                  Visibility="{Binding HasStats, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type main:StatVm}">
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}"
                                                               FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Value}" FontSize="16"
                                                               FontWeight="SemiBold" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource Brush.Text}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- ===== 이 분석의 요약 (그룹별) =====
                                         줄을 누르면 그 그룹의 IO 만 히트맵에 남깁니다. -->
                                    <Border Background="{DynamicResource Brush.Window}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{x:Static t:MainTexts.GroupNoteLabel}" Style="{StaticResource FieldLabel}"
                                                       Margin="0,0,0,5" />

                                            <TextBlock Text="{Binding GroupNote}" Style="{StaticResource Muted}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Visibility="{Binding GroupNote, Converter={StaticResource TextToVisibility}}" />

                                            <!--
                                              ===== 분석 2 의 요약 줄 =====

                                              분석 1 은 아래의 그룹 줄을 쓰고, 분석 2 는
                                              이 줄을 씁니다 (칸은 하나라서 들어 있는 쪽이
                                              보입니다). 누르면 그 분석 화면으로 넘어갑니다 —
                                              그룹 줄과 같은 손놀림입니다.
                                            -->
                                            <!-- 높이 한도는 칸마다 (1.41) — 분석 2 는 230 에서 굴리고,
                                                 분석 3 은 문장이 길어 줄을 바꾸므로 한도 없이 다 보입니다
                                                 (230 이면 긴 줄 두어 개에서 나머지가 가려졌음). -->
                                            <ScrollViewer MaxHeight="{Binding LinesMaxHeight}" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Visibility="{Binding HasLines, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type main:CardLineVm}">
                                                        <Button x:Name="LineButton" Style="{StaticResource RowButton}"
                                                                Click="OnCardIoClick" Tag="{Binding Target}"
                                                                IsEnabled="{Binding CanOpen}"
                                                                ToolTip="{x:Static t:MainTexts.CardIoClickTip}"
                                                                Margin="0,1,0,3">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border x:Name="LineDot" Grid.Column="0"
                                                                            Width="8" Height="8" CornerRadius="4"
                                                                            VerticalAlignment="Center" Margin="0,0,7,0"
                                                                            Background="{DynamicResource Brush.Muted}" />

                                                                    <!--
                                                                      이름 = 꼬리표 + 나머지 (1.40). "[오류] …" 의 [오류] 만 점과
                                                                      같은 색. Run.Text 는 기본이 양방향 바인딩이라 읽기 전용
                                                                      속성에 걸면 오류가 납니다 — 그래서 Mode=OneWay.
                                                                      분석 3 은 길면 줄을 바꿔 다 보입니다 (아래 Wrap 트리거).
                                                                    -->
                                                                    <TextBlock x:Name="LineLabel" Grid.Column="1"
                                                                               VerticalAlignment="Center" FontSize="12"
                                                                               TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding LabelTag, Mode=OneWay}">
                                                                            <Run.Style>
                                                                                <Style TargetType="{x:Type Run}">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeGood}">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Good}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeWarn}">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeBad}">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Run.Style>
                                                                        </Run><Run Text="{Binding LabelRest, Mode=OneWay}" />
                                                                    </TextBlock>

                                                                    <!-- 분석 2 는 여기에 "1 → 2" (1.04). 값이 길면
                                                                         이름을 밀어내지 않게 자릅니다 — 다 보려면 아래
                                                                         작은 글이나 분석 2 화면. -->
                                                                    <TextBlock x:Name="LineValue" Grid.Column="2" Text="{Binding Value}"
                                                                               Style="{StaticResource Muted}" FontSize="11"
                                                                               MaxWidth="240" TextTrimming="CharacterEllipsis"
                                                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                </Grid>

                                                                <!-- 줄 아래 작은 글. 없으면 줄 높이만 차지하지 않게
                                                                     비어 있을 때는 숨깁니다. -->
                                                                <TextBlock Text="{Binding Detail}"
                                                                           Style="{StaticResource Muted}" FontSize="10"
                                                                           TextWrapping="Wrap" Margin="15,2,0,0"
                                                                           Visibility="{Binding Detail, Converter={StaticResource TextToVisibility}}" />
                                                            </StackPanel>
                                                        </Button>

                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeGood}">
                                                                <Setter TargetName="LineDot" Property="Background"
                                                                        Value="{DynamicResource Brush.Good}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeWarn}">
                                                                <Setter TargetName="LineDot" Property="Background"
                                                                        Value="{DynamicResource Brush.Warn}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeBad}">
                                                                <Setter TargetName="LineDot" Property="Background"
                                                                        Value="{DynamicResource Brush.Bad}" />
                                                            </DataTrigger>
                                                            <!-- 분석 2 의 "1 → 2" 는 빨간 글씨로 (1.08). 칸이 좁아
                                                                 "(+1)" 은 안 붙이고 색만 칠합니다. -->
                                                            <DataTrigger Binding="{Binding ValueIsChange}" Value="True">
                                                                <Setter TargetName="LineValue" Property="Foreground"
                                                                        Value="{DynamicResource Brush.Bad}" />
                                                            </DataTrigger>
                                                            <!-- 분석 3 의 줄 (1.40): 문장이 길어 자르지 않고 줄을 바꿉니다.
                                                                 여러 줄이 되면 점은 첫 줄 높이에 붙입니다. -->
                                                            <DataTrigger Binding="{Binding Wrap}" Value="True">
                                                                <Setter TargetName="LineLabel" Property="TextWrapping" Value="Wrap" />
                                                                <Setter TargetName="LineLabel" Property="TextTrimming" Value="None" />
                                                                <Setter TargetName="LineLabel" Property="VerticalAlignment" Value="Top" />
                                                                <Setter TargetName="LineValue" Property="TextWrapping" Value="Wrap" />
                                                                <Setter TargetName="LineValue" Property="TextTrimming" Value="None" />
                                                                <Setter TargetName="LineValue" Property="MaxWidth" Value="140" />
                                                                <Setter TargetName="LineValue" Property="VerticalAlignment" Value="Top" />
                                                                <Setter TargetName="LineDot" Property="VerticalAlignment" Value="Top" />
                                                                <Setter TargetName="LineDot" Property="Margin" Value="0,5,7,0" />
                                                                <Setter TargetName="LineButton" Property="ToolTip"
                                                                        Value="{x:Static t:MainTexts.CardA3LineTip}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </ScrollViewer>

                                            <!--
                                              1.74: 알림 줄 — 그룹 위. "공정 단계 (IO 아님)" (단계 길이 · 없어짐 · 차례) 와
                                              "파형은 같고 조금 어긋난 IO" (시간 · 높이만 조금 다름 → 눌러서 확인하고 한꺼번에 허용).
                                              왼쪽 점 색 = 정도, 오른쪽 = 누르면 할 일.
                                            -->
                                            <ItemsControl ItemsSource="{Binding Notices}" Margin="0,0,0,4"
                                                          Visibility="{Binding HasNotices, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type main:NoticeVm}">
                                                        <Button Style="{StaticResource RowButton}" Padding="4,4" Margin="0,0,0,2"
                                                                Click="OnNoticeClick" Tag="{Binding Key}"
                                                                ToolTip="{x:Static t:MainTexts.NoticeTip}">
                                                            <Border x:Name="NoticeBox" BorderThickness="3,0,0,0" Padding="8,2,4,2"
                                                                    BorderBrush="{DynamicResource Brush.Muted}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding Text}" FontSize="11" TextWrapping="Wrap"
                                                                                   Foreground="{DynamicResource Brush.Muted}" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Action}" FontSize="11"
                                                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                                                               Foreground="{DynamicResource Brush.Accent}" />
                                                                </Grid>
                                                            </Border>
                                                        </Button>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeWarn}">
                                                                <Setter TargetName="NoticeBox" Property="BorderBrush" Value="{DynamicResource Brush.Warn}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeBad}">
                                                                <Setter TargetName="NoticeBox" Property="BorderBrush" Value="{DynamicResource Brush.Bad}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeGood}">
                                                                <Setter TargetName="NoticeBox" Property="BorderBrush" Value="{DynamicResource Brush.Good}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!--
                                              그룹이 많아도 칸이 늘어나지 않게 여기서 굴립니다.
                                              한 줄이 두 줄짜리가 됐습니다 (이름 17 + 차이 내용 16
                                              + 위아래 여백 5 = 38). 여섯 줄이 230 이고,
                                              일곱 번째가 살짝 보여 더 있다는 것이 드러납니다.
                                              0.59 의 300 에서 줄였습니다 (메인 화면에
                                              스크롤이 생기지 않게).
                                            -->
                                            <!--
                                              1.59: 그룹 줄을 누르면 IO 들이 펼쳐지고, 1.62 부터 IO 줄을 누르면 작은 창(IoErrorsWindow)에서 구간별 오차를 보고
                                              오차 줄의 단추로 그 자리에서 허용합니다 (따로 뜨는 창 없음 — MainVm.ToggleGroup · ToggleIo · Allow).
                                              그래프로 보려면 줄 오른쪽 [그래프]. 펼쳐도 칸 높이는 230 그대로 — IO · 오차 줄은 이 안에서 굴립니다
                                              (1.61: 1.59 에 520 까지 늘였더니 메인 화면 전체가 길어졌습니다).
                                            -->
                                            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Visibility="{Binding HasGroups, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl ItemsSource="{Binding Groups}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type main:GroupSummaryVm}">
                                                            <StackPanel Margin="0,1,0,3">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Grid.Column="0" Style="{StaticResource RowButton}" Padding="4,4"
                                                                            Click="OnGroupClick" Tag="{Binding GroupName}"
                                                                            IsEnabled="{Binding CanOpen}"
                                                                            ToolTip="{x:Static t:MainTexts.GroupClickTip}">
                                                                        <StackPanel>
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>

                                                                                <TextBlock Grid.Column="0" Text="{Binding ExpandGlyph}" Width="12"
                                                                                           VerticalAlignment="Center" FontSize="11"
                                                                                           Foreground="{DynamicResource Brush.Muted}" />
                                                                                <Border x:Name="Dot" Grid.Column="1"
                                                                                        Width="8" Height="8" CornerRadius="4"
                                                                                        VerticalAlignment="Center" Margin="0,0,7,0"
                                                                                        Background="{DynamicResource Brush.Muted}" />

                                                                                <TextBlock Grid.Column="2" Text="{Binding GroupName}"
                                                                                           VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                                                                           TextTrimming="CharacterEllipsis" />

                                                                                <TextBlock Grid.Column="3" Text="{Binding CountText}"
                                                                                           Style="{StaticResource Muted}" FontSize="11"
                                                                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                            </Grid>

                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Grid.Column="1" Content="{x:Static t:MainTexts.ShowGraph}" Click="OnGroupGraph"
                                                                            Tag="{Binding GroupName}" ToolTip="{x:Static t:MainTexts.GroupGraphTip}"
                                                                            Visibility="{Binding CanGraph, Converter={StaticResource BoolToVisibility}}"
                                                                            VerticalAlignment="Top" MinHeight="0" Padding="6,1" FontSize="11" Margin="4,2,0,0" />
                                                                </Grid>

                                                                <!-- 펼친 그룹: IO 줄들 -->
                                                                <ItemsControl ItemsSource="{Binding Ios}" Margin="14,2,0,2"
                                                                              Visibility="{Binding ShowIos, Converter={StaticResource BoolToVisibility}}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type main:GroupIoVm}">
                                                                            <StackPanel>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Button Grid.Column="0" Style="{StaticResource RowButton}" Click="OnIoOpen" Padding="4,3"
                                                                                            Tag="{Binding Name}" IsEnabled="{Binding HasErrors}"
                                                                                            ToolTip="{x:Static t:MainTexts.IoClickTip}">
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="Auto" />
                                                                                                <ColumnDefinition Width="Auto" />
                                                                                                <ColumnDefinition Width="Auto" />
                                                                                                <ColumnDefinition Width="*" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock Grid.Column="0" Text="{Binding OpenGlyph}" Width="12" FontSize="12"
                                                                                                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
                                                                                            <Border x:Name="IoDot" Grid.Column="1" Width="8" Height="8" CornerRadius="4"
                                                                                                    VerticalAlignment="Center" Margin="0,0,7,0"
                                                                                                    Background="{DynamicResource Brush.Muted}" />
                                                                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12"
                                                                                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                                            <TextBlock Grid.Column="3" Text="{Binding Summary}" Style="{StaticResource Muted}"
                                                                                                       FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                                        </Grid>
                                                                                    </Button>
                                                                                    <Button Grid.Column="1" Content="{x:Static t:MainTexts.ShowGraph}" Click="OnIoGraph"
                                                                                            Tag="{Binding Name}" ToolTip="{x:Static t:MainTexts.IoGraphTip}"
                                                                                            VerticalAlignment="Center" MinHeight="0" Padding="6,1" FontSize="11" Margin="4,1,0,1" />
                                                                                </Grid>
                                                                            </StackPanel>
                                                                            <DataTemplate.Triggers>
                                                                                <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeGood}">
                                                                                    <Setter TargetName="IoDot" Property="Background" Value="{DynamicResource Brush.Good}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeWarn}">
                                                                                    <Setter TargetName="IoDot" Property="Background" Value="{DynamicResource Brush.Warn}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeBad}">
                                                                                    <Setter TargetName="IoDot" Property="Background" Value="{DynamicResource Brush.Bad}" />
                                                                                </DataTrigger>
                                                                            </DataTemplate.Triggers>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                            </StackPanel>

                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeGood}">
                                                                    <Setter TargetName="Dot" Property="Background"
                                                                            Value="{DynamicResource Brush.Good}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeWarn}">
                                                                    <Setter TargetName="Dot" Property="Background"
                                                                            Value="{DynamicResource Brush.Warn}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeBad}">
                                                                    <Setter TargetName="Dot" Property="Background"
                                                                            Value="{DynamicResource Brush.Bad}" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                                <!-- LLM 서버에 안 닿을 때 회색 반투명 덮개 + 안내 (1.51). 덮개가 누름도 막습니다. -->
                                <Border Background="{DynamicResource Brush.Muted}" Opacity="0.35" CornerRadius="4" Margin="-16,-12"
                                        Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}" />
                                <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                        CornerRadius="4" Padding="14,10" MaxWidth="460"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding BlockText}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Text="{Binding BlockDetail}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   Visibility="{Binding BlockDetail, Converter={StaticResource TextToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <!-- 점수 색은 화면 아래의 색 설명과 같은 값을 봅니다
                                 (ScoreBands). 아직 안 재 본 "??" 는 회색 그대로 —
                                 안 재 본 값에 색을 칠하면 재 본 값으로 읽힙니다. -->
                            <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeGood}">
                                <Setter TargetName="ScoreText" Property="Foreground"
                                        Value="{DynamicResource Brush.Good}" />
                                <Setter TargetName="VerdictCountText" Property="Foreground"
                                        Value="{DynamicResource Brush.Good}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeWarn}">
                                <Setter TargetName="ScoreText" Property="Foreground"
                                        Value="{DynamicResource Brush.Warn}" />
                                <Setter TargetName="VerdictCountText" Property="Foreground"
                                        Value="{DynamicResource Brush.Warn}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeBad}">
                                <Setter TargetName="ScoreText" Property="Foreground"
                                        Value="{DynamicResource Brush.Bad}" />
                                <Setter TargetName="VerdictCountText" Property="Foreground"
                                        Value="{DynamicResource Brush.Bad}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Grid>

            <!-- ===== 종합 분석 결과 (LLM, 1.45) — 1.83: 분석 칸들 아래로 (사용자 요청) =====
                 1.44 까지의 한 줄 판정 · 기준 · 안내를 빼고, 사용자가 만든 LLM 분석의 결과를 보입니다.

                   종합 분석 결과                                    [LLM 분석 실행] [취소]
                   ● 분석 1 · 로그 비교  완료   ● 분석 2 · DB  안 함   ● 분석 3  완료
                   [■■■■■□□□□□] 서버에 보내는 중
                   ┌ 결과 글 ───────────────────────────────────────────────┐
                   2026-10-29 15:02:10 · 분석 1 · 3 결과로 분석

                 값은 MainVm.Llm (LlmPanelVm), 돌리는 것은 ShellWindow, 꽂는 자리는 Main/LlmSetup.cs.
                 진행 중에는 DataContext.Llm 이 바뀌지 않으므로 모두 Llm.X 로 묶습니다. -->
            <Border Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="5" Padding="18,14" Margin="6,14,6,0">
                <Grid>
                    <StackPanel IsEnabled="{Binding Llm.ServerOk}">
                        <!-- 제목 · [LLM 분석 실행] · [취소] -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static t:MainTexts.Label}" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                    Content="{x:Static t:MainTexts.LlmRun}" Click="OnLlmRun"
                                    ToolTip="{x:Static t:MainTexts.LlmRunTip}" IsEnabled="{Binding Llm.CanRun}"
                                    Margin="0" />
                            <Button Grid.Column="2" Content="{x:Static t:MainTexts.LlmCancel}" Click="OnLlmCancel"
                                    ToolTip="{x:Static t:MainTexts.LlmCancelTip}" Margin="6,0,0,0"
                                    Visibility="{Binding Llm.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <!-- 분석 1 · 2 · 3 체크 — 지금 결과가 있는지 (점 · 완료/안 함) 와 LLM 에 보낼지 (체크 상자, 1.54).
                             결과가 없으면 체크 상자가 꺼집니다. 마우스를 올리면 무엇을 보고 판단했는지. -->
                        <ItemsControl ItemsSource="{Binding Llm.Checks}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type main:LlmCheckVm}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0" Background="Transparent"
                                                ToolTip="{Binding Note}" ToolTipService.ShowOnDisabled="True">
                                        <!-- 2.04: 체크와 이름만 (점 · "완료 / 안 함" 글 · "분석 N" 뺌). 결과가 없으면 체크가 꺼져 있고 까닭은 마우스 글 -->
                                        <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" IsEnabled="{Binding Ready}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 진행 — 돌 때만 -->
                        <Grid Margin="0,0,0,8"
                              Visibility="{Binding Llm.IsRunning, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Height="10" Minimum="0" Maximum="100"
                                         Value="{Binding Llm.Progress, Mode=OneWay}"
                                         IsIndeterminate="{Binding Llm.ProgressUnknown, Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{Binding Llm.Message}" Style="{StaticResource Muted}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 아직 아무것도 없을 때 -->
                        <TextBlock Text="{x:Static t:MainTexts.LlmEmpty}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Visibility="{Binding Llm.ShowEmpty, Converter={StaticResource BoolToVisibility}}" />

                        <!-- 오류 · 취소 -->
                        <TextBlock Text="{Binding Llm.ErrorText}" Foreground="{DynamicResource Brush.Bad}" TextWrapping="Wrap"
                                   Margin="0,0,0,6"
                                   Visibility="{Binding Llm.HasError, Converter={StaticResource BoolToVisibility}}" />

                        <!-- 결과 글 — 고르고 복사할 수 있게 읽기 전용 글 상자. 길면 칸 안에서 굴립니다. -->
                        <TextBox Text="{Binding Llm.ResultText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxHeight="360"
                                 BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Text}"
                                 Padding="0" FontSize="13"
                                 Visibility="{Binding Llm.HasResult, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Llm.FinishedText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"
                                   Visibility="{Binding Llm.HasResult, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <!-- LLM 서버에 안 닿을 때 회색 반투명 덮개 + 안내 (1.51). 덮개가 누름도 막습니다. -->
                    <Border Background="{DynamicResource Brush.Muted}" Opacity="0.35" CornerRadius="4" Margin="-18,-14"
                            Visibility="{Binding Llm.IsBlocked, Converter={StaticResource BoolToVisibility}}" />
                    <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="4" Padding="14,10" MaxWidth="460"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Llm.IsBlocked, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Llm.BlockText}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="{Binding Llm.BlockDetail}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Visibility="{Binding Llm.BlockDetail, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== History (전 "저장된 분석", 1.42) =====
                 저장 한 번 = 한 줄 = 분석 1 · 2 · 3 의 그때 요약 셋 (가로). 줄을 누르면
                 위 칸 셋에 그 요약을 펼칩니다. -->
            <Border Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="5" Padding="18,14" Margin="6,14,6,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 1.54: 이름 아래의 안내 글 (HistoryNote) 을 뺐습니다. 줄 설명은 줄의 풍선 도움말에 남아 있습니다. -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static t:MainTexts.HistoryNoteLabel}" Style="{StaticResource FieldLabel}" />
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                Content="{x:Static t:MainTexts.SaveResult}" Click="OnSaveResult"
                                IsEnabled="{Binding CanSave}" VerticalAlignment="Top"
                                ToolTip="{Binding HistoryFolder}" />
                    </Grid>

                    <!--
                      기록이 쌓일수록 메인 화면이 끝없이 길어지지 않게 이 칸 안에서 굴립니다.
                      1.61: 칸을 두 줄로 줄였습니다 (줄 하나 약 90 → 56). 300 이면 다섯 줄과 여섯 번째가 살짝 보입니다.
                    -->
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type main:HistoryRowVm}">
                                <Border x:Name="RowBox" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                                        Padding="0,3,0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                          줄 전체가 단추입니다 — 누르면 위 칸 셋에 그때의 요약을 펼칩니다.
                                          [삭제] 는 이 단추 <b>밖</b>에 둡니다 — 안에 넣으면 삭제를 눌러도
                                          바깥 단추의 Click 까지 같이 올라갑니다.
                                        -->
                                        <Button Grid.Column="0" Style="{StaticResource RowButton}"
                                                Click="OnOpenSaved" Tag="{Binding Id}"
                                                ToolTip="{x:Static t:MainTexts.HistoryRowTip}">
                                            <StackPanel>
                                                <!-- 이름 (없으면 저장 시각) · 이름이 있으면 옆에 시각 -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SavedAtText}" Style="{StaticResource Muted}"
                                                               FontSize="11" Margin="10,0,0,0" VerticalAlignment="Bottom" />
                                                </StackPanel>

                                                <!-- 분석 1 / 2 / 3 — 가로 셋, 칸 셋과 같은 차례 -->
                                                <!-- 1.95: 같은 폭 셋 → 분석 1 · 2 를 넓게, 3 은 좁게 (분석 2 글이 줄바꿈되고 오른쪽이 남던 것) -->
                                                <ItemsControl ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Grid>
                                                                <!-- 2.00: 분석 2 칸을 더 넓게 (이름 · 판정 · 개수가 한 줄에) -->
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="1.25*" />
                                                                    <ColumnDefinition Width="1.85*" />
                                                                    <ColumnDefinition Width="0.9*" />
                                                                </Grid.ColumnDefinitions>
                                                            </Grid>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="{x:Type ContentPresenter}">
                                                            <Setter Property="Grid.Column" Value="{Binding Column}" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type main:HistoryCellVm}">
                                                            <!--
                                                              1.61: 네 줄 → 두 줄. 윗줄 = 분석 이름 · 판정/점수 · 개수,
                                                              아랫줄 = 요약. 무엇을 견줬는지(InputsText)는 마우스를 올리면.
                                                            -->
                                                            <Border Background="{DynamicResource Brush.Window}"
                                                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                                    CornerRadius="3" Padding="6,2" Margin="0,0,6,0"
                                                                    ToolTip="{Binding InputsText}">
                                                                <StackPanel>
                                                                    <DockPanel LastChildFill="True">
                                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" Style="{StaticResource Muted}"
                                                                                   FontSize="10" VerticalAlignment="Center" MaxWidth="170"
                                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                                                        <TextBlock DockPanel.Dock="Left" x:Name="CellHead" Text="{Binding HeadText}"
                                                                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource Brush.Muted}" />
                                                                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}"
                                                                                   FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </DockPanel>
                                                                    <TextBlock Text="{Binding SummaryText}" FontSize="10" TextWrapping="NoWrap"
                                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SummaryText}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding HeadGrade}" Value="{x:Static main:ScoreBands.GradeGood}">
                                                                    <Setter TargetName="CellHead" Property="Foreground" Value="{DynamicResource Brush.Good}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HeadGrade}" Value="{x:Static main:ScoreBands.GradeWarn}">
                                                                    <Setter TargetName="CellHead" Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HeadGrade}" Value="{x:Static main:ScoreBands.GradeBad}">
                                                                    <Setter TargetName="CellHead" Property="Foreground" Value="{DynamicResource Brush.Bad}" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" Content="{x:Static t:MainTexts.DeleteSaved}" Click="OnDeleteSaved"
                                                Tag="{Binding Id}" VerticalAlignment="Center"
                                                Margin="8,3,0,3" />
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <!-- 위 칸에 펼쳐 보고 있는 줄 -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="RowBox" Property="Background"
                                                Value="{DynamicResource Brush.AccentSoft}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- 1.54: 맨 아래의 "점수를 매기는 규칙은 아직 …" 안내와 점수 색 설명을 뺐습니다. -->
        </StackPanel>
    </ScrollViewer>
</UserControl>
