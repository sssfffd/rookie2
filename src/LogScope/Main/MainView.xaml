<UserControl x:Class="LogScope.Main.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:main="clr-namespace:LogScope.Main"
             xmlns:t="clr-namespace:LogScope.Main"
             xmlns:common="clr-namespace:LogScope.Common"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="760"
             d:DataContext="{x:Static common:DesignData.Main}"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <!--
          분석 1 칸에 펼친 오차 한 줄 (1.59). IO 아래 · 공정 단계 아래 두 곳이 같이 씁니다.
          [그래프] = 그 구간을 그래프로, [이번만 허용] · [앞으로도 허용] (본 크기까지) · 허용됐으면 [허용 풀기].
          단추는 Tag 대신 줄의 DataContext(ErrorRowVm)로 어느 오차인지 압니다.
        -->
        <DataTemplate x:Key="ErrorRowTemplate" DataType="{x:Type main:ErrorRowVm}">
            <Border x:Name="Row" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,2,0,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Word" Grid.Column="0" Text="{Binding Word}" FontSize="10" FontWeight="Bold"
                               MinWidth="58" Margin="0,1,6,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource Brush.Muted}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Text}" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Muted}" />
                    </StackPanel>
                    <WrapPanel Grid.Column="2" VerticalAlignment="Top" Margin="6,0,0,0" MaxWidth="250"
                               HorizontalAlignment="Right">
                        <Button Content="{x:Static t:MainTexts.ShowGraph}" Click="OnErrorGraph"
                                ToolTip="{x:Static t:MainTexts.ErrorGraphTip}"
                                Visibility="{Binding CanGraph, Converter={StaticResource BoolToVisibility}}"
                                MinHeight="0" Padding="5,0" FontSize="10" Margin="2,1" />
                        <Button Content="{x:Static t:MainTexts.AllowOnce}" Click="OnAllowOnce"
                                ToolTip="{x:Static t:MainTexts.AllowOnceTip}"
                                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}"
                                MinHeight="0" Padding="5,0" FontSize="10" Margin="2,1" />
                        <Button Content="{x:Static t:MainTexts.AllowAlways}" Click="OnAllowAlways"
                                ToolTip="{x:Static t:MainTexts.AllowAlwaysTip}"
                                Visibility="{Binding CanAllowAlways, Converter={StaticResource BoolToVisibility}}"
                                MinHeight="0" Padding="5,0" FontSize="10" Margin="2,1" />
                        <Button Content="{x:Static t:MainTexts.Unallow}" Click="OnUnallow"
                                ToolTip="{x:Static t:MainTexts.UnallowTip}"
                                Visibility="{Binding IsAllowed, Converter={StaticResource BoolToVisibility}}"
                                MinHeight="0" Padding="5,0" FontSize="10" Margin="2,1" />
                    </WrapPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeWarn}">
                    <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Grade}" Value="{x:Static main:ScoreBands.GradeBad}">
                    <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource Brush.Bad}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAllowed}" Value="True">
                    <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- 아주 넓은 화면에서 칸이 끝없이 늘어나지 않게 가둡니다. -->
        <StackPanel Margin="20,16,20,22" MaxWidth="1180" HorizontalAlignment="Stretch">

            <!-- ===== 종합 분석 결과 (LLM, 1.45) =====
                 1.44 까지의 한 줄 판정 · 기준 · 안내를 빼고, 사용자가 만든 LLM 분석의 결과를 보입니다.

                   종합 분석 결과                                    [LLM 분석 실행] [취소]
                   ● 분석 1 · 로그 비교  완료   ● 분석 2 · DB  안 함   ● 분석 3  완료
                   [■■■■■□□□□□] 서버에 보내는 중
                   ┌ 결과 글 ───────────────────────────────────────────────┐
                   2026-10-29 15:02:10 · 분석 1 · 3 결과로 분석

                 값은 MainVm.Llm (LlmPanelVm), 돌리는 것은 ShellWindow, 꽂는 자리는 Main/LlmSetup.cs.
                 진행 중에는 DataContext.Llm 이 바뀌지 않으므로 모두 Llm.X 로 묶습니다. -->
            <Border Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="5" Padding="18,14" Margin="6,0,6,16">
                <Grid>
                    <StackPanel IsEnabled="{Binding Llm.ServerOk}">
                        <!-- 제목 · [LLM 분석 실행] · [취소] -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static t:MainTexts.Label}" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                    Content="{x:Static t:MainTexts.LlmRun}" Click="OnLlmRun"
                                    ToolTip="{x:Static t:MainTexts.LlmRunTip}" IsEnabled="{Binding Llm.CanRun}"
                                    Margin="0" />
                            <Button Grid.Column="2" Content="{x:Static t:MainTexts.LlmCancel}" Click="OnLlmCancel"
                                    ToolTip="{x:Static t:MainTexts.LlmCancelTip}" Margin="6,0,0,0"
                                    Visibility="{Binding Llm.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <!-- 분석 1 · 2 · 3 체크 — 지금 결과가 있는지 (점 · 완료/안 함) 와 LLM 에 보낼지 (체크 상자, 1.54).
                             결과가 없으면 체크 상자가 꺼집니다. 마우스를 올리면 무엇을 보고 판단했는지. -->
                        <ItemsControl ItemsSource="{Binding Llm.Checks}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type main:LlmCheckVm}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0" Background="Transparent"
                                                ToolTip="{Binding Note}" ToolTipService.ShowOnDisabled="True">
                                        <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" IsEnabled="{Binding Ready}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Border x:Name="CheckDot" Width="10" Height="10" CornerRadius="5"
                                                VerticalAlignment="Center" Margin="0,0,7,0"
                                                Background="{DynamicResource Brush.Muted}" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="CheckState" Text="{Binding StateText}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Muted}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Ready}" Value="True">
                                            <Setter TargetName="CheckDot" Property="Background" Value="{DynamicResource Brush.Good}" />
                                            <Setter TargetName="CheckState" Property="Foreground" Value="{DynamicResource Brush.Good}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 진행 — 돌 때만 -->
                        <Grid Margin="0,0,0,8"
                              Visibility="{Binding Llm.IsRunning, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Height="10" Minimum="0" Maximum="100"
                                         Value="{Binding Llm.Progress, Mode=OneWay}"
                                         IsIndeterminate="{Binding Llm.ProgressUnknown, Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{Binding Llm.Message}" Style="{StaticResource Muted}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 아직 아무것도 없을 때 -->
                        <TextBlock Text="{x:Static t:MainTexts.LlmEmpty}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Visibility="{Binding Llm.ShowEmpty, Converter={StaticResource BoolToVisibility}}" />

                        <!-- 오류 · 취소 -->
                        <TextBlock Text="{Binding Llm.ErrorText}" Foreground="{DynamicResource Brush.Bad}" TextWrapping="Wrap"
                                   Margin="0,0,0,6"
                                   Visibility="{Binding Llm.HasError, Converter={StaticResource BoolToVisibility}}" />

                        <!-- 결과 글 — 고르고 복사할 수 있게 읽기 전용 글 상자. 길면 칸 안에서 굴립니다. -->
                        <TextBox Text="{Binding Llm.ResultText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxHeight="360"
                                 BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Text}"
                                 Padding="0" FontSize="13"
                                 Visibility="{Binding Llm.HasResult, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Llm.FinishedText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"
                                   Visibility="{Binding Llm.HasResult, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <!-- LLM 서버에 안 닿을 때 회색 반투명 덮개 + 안내 (1.51). 덮개가 누름도 막습니다. -->
                    <Border Background="{DynamicResource Brush.Muted}" Opacity="0.35" CornerRadius="4" Margin="-18,-14"
                            Visibility="{Binding Llm.IsBlocked, Converter={StaticResource BoolToVisibility}}" />
                    <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="4" Padding="14,10" MaxWidth="460"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Llm.IsBlocked, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Llm.BlockText}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="{Binding Llm.BlockDetail}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Visibility="{Binding Llm.BlockDetail, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- "분석 결과" 와, History 를 펼쳐 보는 중이면 그 띠 (1.42). 칸 셋이 지금 결과가
                 아니라는 것이 한눈에 보여야 합니다 — 안 그러면 옛 요약을 지금 것으로 읽습니다. -->
            <Grid Margin="2,4,6,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static t:MainTexts.Heading}" Style="{StaticResource H1}"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{DynamicResource Brush.AccentSoft}"
                        BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                        CornerRadius="4" Padding="10,2,4,2" Margin="14,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Visibility="{Binding IsViewingHistory, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ViewingText}" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent}" TextTrimming="CharacterEllipsis" />
                        <Button Content="{x:Static t:MainTexts.ShowLive}" Click="OnShowLive"
                                ToolTip="{x:Static t:MainTexts.ShowLiveTip}"
                                Height="24" MinHeight="0" Padding="10,0" Margin="12,0,0,0" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--
              분석 칸. 셋을 <b>가로로</b> 나란히 놓고 폭을 똑같이 나눕니다.

              WrapPanel 이 아니라 UniformGrid 인 이유가 있습니다. WrapPanel 은
              좁아지면 한 칸이 아래로 내려가 2+1 로 접힙니다. 셋이 나란히
              있어야 견줘 보이는 것이라, 좁아지면 다 같이 좁아지는 편이
              낫습니다.

              칸 전체가 단추입니다. 요청은 "점수를 누르면" 이었지만 점수만
              눌리게 하면 과녁이 너무 작습니다. 칸 어디를 눌러도 같은 자리로
              갑니다 — 점수도 그 안에 들어 있습니다.
            -->
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type main:AnalysisCardVm}">
                        <!--
                          칸 전체가 단추이던 것을 되돌렸습니다. 칸 안에 누를
                          것(그룹 줄)이 생겼는데, 바깥까지 단추면 그룹을 누른
                          손이 칸도 같이 누릅니다. 이동은 오른쪽 위 화살표만
                          맡습니다.
                        -->
                        <!--
                          MinHeight 로 칸의 바닥 높이를 정합니다. UniformGrid 는
                          셋의 높이를 맞추므로 한 칸만 커져도 셋이 같이
                          커집니다. 가로로는 안 늘립니다 (가로는 화면 폭이
                          정합니다).

                          0.59 에 480 으로 뒀다가 0.65 에 390 으로 줄였습니다.
                          480 이면 1080 짜리 화면에서 메인 화면에 스크롤이
                          생겼습니다 — 한 화면에 다 들어오는 쪽이 "한눈에
                          본다" 는 이 화면의 뜻에 맞습니다. 요약이 길면
                          칸 안에서 굴립니다.
                        -->
                        <Border Background="{DynamicResource Brush.Panel}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="5" Padding="16,12" Margin="6" MinHeight="390">
                            <Grid>
                                <StackPanel IsEnabled="{Binding IsUsable}">

                                    <!-- 번호표 · 이름 · (분석 3: 분석) · 이동 화살표 -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource Brush.AccentSoft}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                CornerRadius="3" Padding="7,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" FontSize="11"
                                                       Foreground="{DynamicResource Brush.Accent}"
                                                       FontWeight="SemiBold" />
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource H2}"
                                                   VerticalAlignment="Center" Margin="9,0,6,0"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!--
                                          칸 머리의 [분석] — 1.35 에 분석 3 칸에만, 1.53 부터 칸 셋 모두.
                                          메인 칸에서 고르거나 놓기만 하면 읽지 않고, 이 단추를 눌러야 돕니다.
                                            분석 1 : 창이 기다리던 로그를 읽고 견줌 (ShellWindow.OnMainLogAnalyze)
                                            분석 2 : 분석 2 화면의 [읽기] 와 같음 (DbView.ReadNow)
                                            분석 3 : Common/Analysis3Link 의 AnalyzeRequested 가 울리고, 무엇을 할지는
                                                     분석 3 폴더의 코드가 정합니다 (갈아 끼우는 폴더라 여기서 직접 부르지 않음).

                                          머리 줄에 둔 까닭: 칸 셋의 이전/이후 · 요약 줄이 나란히 놓여야
                                          합니다. 칸 안에 줄을 하나 더 두면 분석 3 칸만 아래로 밀립니다.
                                          그래서 높이를 화살표 단추와 같은 26 으로 맞추고 (기본 단추는
                                          MinHeight 28 · 위아래 여백 3) 머리 줄 높이가 변하지 않게 합니다.
                                        -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                                                    Margin="0,0,6,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:MainTexts.A3Analyze}"
                                                    Click="OnCardAnalyze" Tag="{Binding Number}" ToolTip="{Binding AnalyzeTip}"
                                                    Height="26" MinHeight="0" Padding="10,0" Margin="0" FontSize="12" />
                                        </StackPanel>

                                        <Button Grid.Column="3" Style="{StaticResource ArrowButton}"
                                                Content="{x:Static t:MainTexts.CardClick}" Click="OnCardClick" Tag="{Binding Number}"
                                                VerticalAlignment="Top"
                                                ToolTip="{x:Static t:MainTexts.CardClickTip}" />
                                    </Grid>

                                    <!-- 점수 (또는 판정 낱말) — <b>한 줄, 높이 고정</b> (1.09).

                                         칸 셋이 나란히 있어서, 점수 자리 높이가 칸마다 다르면
                                         그 아래 이전/이후 줄이 칸마다 다른 높이에 놓입니다.
                                         그래서 높이를 정해 두고, 적을 것이 없어도 자리는
                                         남깁니다 (분석 2 는 DB 를 읽기 전에 아무것도 안 적습니다).

                                         1.06 에는 점수 아래 글(ScoreNote)까지 들어가게 54 로
                                         잡았는데, 파일을 넣으면 그 글이 비어 이전/이후 위에
                                         빈 줄 하나가 남았습니다. 이제 그 글은 <b>점수 오른쪽</b>
                                         에 작게 붙고, 높이는 점수 한 줄(30pt)만큼입니다.

                                         글자 크기: 분석 1 점수 = 분석 2 판정 낱말 = 차이 개수 =
                                         30 (ScoreSize). -->
                                    <Grid Height="42">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom"
                                                Visibility="{Binding HasScoreText, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock x:Name="ScoreText" Text="{Binding ScoreText}"
                                                   FontSize="{Binding ScoreSize}" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Muted}"
                                                   VerticalAlignment="Bottom" />
                                        <TextBlock Text="{Binding ScoreOutOf}" FontSize="16" Margin="6,0,0,8"
                                                   Foreground="{DynamicResource Brush.Muted}"
                                                   VerticalAlignment="Bottom" />

                                        <!--
                                          분석 2: 차이 발생 개수를 <b>낱말 오른쪽에</b> (1.03).
                                          FAIL 을 보는 눈이 바로 옆의 수로 이어집니다.
                                        -->
                                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                                                    VerticalAlignment="Bottom"
                                                    Visibility="{Binding VerdictCount, Converter={StaticResource TextToVisibility}}">
                                            <TextBlock Text="{x:Static t:MainTexts.Text}" FontSize="13" VerticalAlignment="Bottom"
                                                       Margin="0,0,8,6" Foreground="{DynamicResource Brush.Muted}" />
                                            <TextBlock x:Name="VerdictCountText" Text="{Binding VerdictCount}"
                                                       FontSize="{Binding ScoreSize}" FontWeight="Bold"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="{DynamicResource Brush.Text}" />
                                            <TextBlock Text="{x:Static t:MainTexts.Text2}" FontSize="13" VerticalAlignment="Bottom"
                                                       Margin="4,0,0,6" Foreground="{DynamicResource Brush.Muted}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 점수 옆 작은 글 ("Log 파일을 비교한 후 점수가 나옵니다" 등).
                                         좁으면 … 로 자르고 마우스를 올리면 다 보입니다. -->
                                    <TextBlock Grid.Column="1" Text="{Binding ScoreNote}" Style="{StaticResource Muted}"
                                               FontSize="11" Margin="12,0,0,9" VerticalAlignment="Bottom"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ScoreNote}"
                                               Visibility="{Binding ScoreNote, Converter={StaticResource TextToVisibility}}" />
                                    </Grid>

                                    <!-- ===== 이 분석이 쓰는 로그 (분석 1) — 점수 바로 아래 (1.04) =====

                                         <b>모양이 둘</b>입니다. 한 자리에 두 Border 를 겹쳐
                                         두고 하나만 보입니다.

                                           열기 전 : 테두리 친 상자 — "여기 놓으라" 는 자리로
                                                     보여야 합니다 (0.99 의 모양)
                                           연 뒤   : 납작한 한 줄 — 이름만 읽히면 됩니다
                                                     (1.02 의 모양)

                                         두 모양을 Border 하나에 바인딩으로 바꿔 끼우지
                                         않은 까닭: 끌기가 끝나면 CardTag 가 Tag 에 적힌
                                         색으로 되돌리는데, Tag 와 색이 바인딩으로 함께
