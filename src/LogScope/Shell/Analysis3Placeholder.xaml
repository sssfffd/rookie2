<UserControl x:Class="LogScope.Shell.Analysis3Placeholder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:LogScope.Common"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="760"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <!--
      분석 3 자리 — Analysis3 폴더에 Analysis3View 가 <b>없을 때</b> 대신 뜨는 화면 (1.30).

      분석 3 은 사용자가 VS 로 src/LogScope/Analysis3 에 직접 만듭니다. 그 폴더는
      저장소에 없습니다 (.gitignore). 그래서 새 버전을 받아 기존 폴더 위에 풀거나
      git pull 해도 그 폴더는 그대로 남습니다. 이 자리 화면이 Analysis3 안에 있으면
      새 버전을 덮을 때마다 사용자의 Analysis3View 를 덮어써 버립니다 — 그래서
      Shell 로 옮겼습니다.

      창은 빌드된 프로그램 안에서 LogScope.Analysis3.Analysis3View 를 찾아 띄우고,
      없거나 만들다 오류가 나면 이 화면을 띄웁니다 (ShellWindow.LoadAnalysis3).
    -->
    <Border Background="{DynamicResource Brush.Window}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
            <TextBlock x:Name="TitleText" Text="분석" Style="{StaticResource H1}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static common:CommonTexts.PlaceholderNote}" Style="{StaticResource Muted}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"
                       TextWrapping="Wrap" TextAlignment="Center" />
            <!-- Analysis3View 를 만들다 오류가 났을 때만 보입니다. -->
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Bad}" FontSize="11"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                       Visibility="Collapsed" />
            <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,14,0,0"
                       Text="{x:Static common:CommonTexts.PlaceholderLogScopeNote}" />
        </StackPanel>
    </Border>
</UserControl>
