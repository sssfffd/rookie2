<UserControl x:Class="LogScope.Analysis1.Align.AlignPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:LogScope.Analysis1.Align"
             xmlns:common="clr-namespace:LogScope.Common"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="760"
             d:DataContext="{x:Static common:DesignData.Align}"
             Background="{DynamicResource Brush.Panel}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <!--
      시간 맞추기. 그래프 화면과 히트맵 화면이 이 판 하나를 똑같이 띄웁니다.
      도구 줄에 늘어놓지 않고 접어 둔 이유는 간단합니다 — 한 번 정해 놓고
      계속 쓰는 값들이라, 늘 펼쳐 두면 도구 줄만 길어집니다.

      0.92 까지는 위에 "가로축" 칸이 하나 더 있었습니다 (로그의 시간 열
      대신 다른 IO 를 가로축으로 놓기). 쓰이지 않아 걷어냈습니다.
    -->
    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
            Background="{DynamicResource Brush.Panel}" Padding="14,12">
        <StackPanel Width="440">

            <TextBlock Text="{x:Static t:AlignTexts.Heading}" Style="{StaticResource H2}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="{x:Static t:AlignTexts.Note}" />

            <TextBlock Text="{x:Static t:AlignTexts.AlignChoicesLabel}" Style="{StaticResource FieldLabel}" Margin="0,4,0,2" />
            <ComboBox ItemsSource="{Binding AlignChoices}"
                      SelectedItem="{Binding AlignIo, Mode=TwoWay}" />

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static t:AlignTexts.Label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static t:AlignTexts.Label2}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                <TextBlock Grid.Row="0" Grid.Column="4" Text="{x:Static t:AlignTexts.LevelIndexLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />

                <!-- 0/1 만이 아니라 그 IO 에 실제로 나온 값을 다 올립니다. -->
                <ComboBox Grid.Row="1" Grid.Column="0"
                          ItemsSource="{Binding LevelChoices}"
                          SelectedIndex="{Binding LevelIndex, Mode=TwoWay}"
                          IsEnabled="{Binding HasLevels}"
                          ToolTip="{x:Static t:AlignTexts.LevelIndexTip}" />

                <ComboBox Grid.Row="1" Grid.Column="2"
                          ItemsSource="{Binding EdgeChoices}"
                          SelectedIndex="{Binding EdgeIndex, Mode=TwoWay}"
                          ToolTip="{x:Static t:AlignTexts.EdgeIndexTip}" />

                <TextBox Grid.Row="1" Grid.Column="4"
                         Text="{Binding OccurrenceText, UpdateSourceTrigger=LostFocus}"
                         ToolTip="{x:Static t:AlignTexts.OccurrenceTextTip}" />
            </Grid>

            <WrapPanel Margin="0,10,0,0">
                <Button Content="{x:Static t:AlignTexts.ClearAlign}" Click="OnClearAlign"
                        ToolTip="{x:Static t:AlignTexts.ClearAlignTip}" />
                <Button Content="{x:Static t:AlignTexts.Close}" Click="OnClose" />
            </WrapPanel>

            <!-- 결과 한 줄. 못 맞췄으면 그 이유가 여기 적힙니다. -->
            <Border Background="{DynamicResource Brush.PanelAlt}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    Padding="8,5" Margin="0,10,0,0"
                    Visibility="{Binding Note, Converter={StaticResource TextToVisibility}}">
                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource Brush.Text}" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
