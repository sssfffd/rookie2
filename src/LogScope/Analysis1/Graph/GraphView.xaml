<UserControl x:Class="LogScope.Analysis1.Graph.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:align="clr-namespace:LogScope.Analysis1.Align"
             xmlns:graph="clr-namespace:LogScope.Analysis1.Graph"
             xmlns:t="clr-namespace:LogScope.Analysis1.Graph"
             xmlns:common="clr-namespace:LogScope.Common"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="760"
             d:DataContext="{x:Static common:DesignData.Graph}"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="Segoe UI" FontSize="12">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" MinWidth="230" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- ================= 왼쪽: IO 목록과 그룹 ================= -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel DataContext="{Binding List}">

                <!-- 검색과 필터. 진짜 컨트롤이라 그래프를 다시 그려도
                     깜빡이지 않습니다. (요구사항 3번) -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="{x:Static t:GraphTexts.Heading}" Style="{StaticResource H2}"
                                       VerticalAlignment="Center" Margin="2,0,10,0" />
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" />
                        </WrapPanel>


                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="{x:Static t:GraphTexts.ClearSearch}" Margin="4,3,0,3"
                                    Click="OnClearSearch" />
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                     ToolTip="{x:Static t:GraphTexts.SearchTip}" />
                        </DockPanel>

                        <!-- 타입(디지털 · 아날로그 · 상태) 고르기 목록과 줄마다 적던
                             타입 글자는 1.20 에서 뺐습니다. -->
                        <WrapPanel Margin="0,4,0,0">
                            <ComboBox MinWidth="130" SelectedIndex="{Binding ScopeFilter, Mode=TwoWay}">
                                <ComboBoxItem Content="{x:Static t:GraphTexts.ScopeAll}" />
                                <ComboBoxItem Content="{x:Static t:GraphTexts.ScopePicked}" />
                                <ComboBoxItem Content="{x:Static t:GraphTexts.ScopeChanged}" />
                            </ComboBox>
                        </WrapPanel>

                        <WrapPanel Margin="0,2,0,0">
                            <Button Content="{x:Static t:GraphTexts.SelectAll}" Click="OnSelectAll" />
                            <Button Content="{x:Static t:GraphTexts.ClearAll}" Click="OnClearAll" />
                        </WrapPanel>

                        <!--
                          그릴 로그. 두 선이 거의 같은 자리에 겹쳐 있으면 뒤에
                          그려진 쪽이 앞의 쪽을 덮습니다. 한쪽을 끄면 가려졌던
                          선이 그대로 보입니다.

                          <b>도구 줄이 아니라 여기</b>입니다. "무엇을 그릴까" 는
                          IO 를 고르는 일과 같은 종류라 이 칸이 제자리이고,
                          위 도구 줄은 두 줄을 넘지 않아야 합니다.

                          이 블록의 DataContext 는 List(IO 목록)이라, 그래프
                          뷰모델의 값은 UserControl 을 거쳐 찾습니다.

                          차이 눈금에서는 선이 하나뿐이고 두 로그가 다 필요한
                          값이라 뜻이 없습니다. 그때는 꺼져 보입니다.
                        -->
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="{x:Static t:GraphTexts.ShowBeforeLabel}" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Margin="2,0,8,0" />
                            <CheckBox Content="{x:Static t:GraphTexts.ShowBefore}" Margin="0,0,10,0" VerticalAlignment="Center"
                                      IsChecked="{Binding DataContext.ShowBefore,
                                                  RelativeSource={RelativeSource AncestorType=UserControl},
                                                  Mode=TwoWay}"
                                      IsEnabled="{Binding DataContext.ScaleRaw,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      ToolTip="{x:Static t:GraphTexts.ShowBeforeTip}" />
                            <CheckBox Content="{x:Static t:GraphTexts.ShowAfter}" VerticalAlignment="Center"
                                      IsChecked="{Binding DataContext.ShowAfter,
                                                  RelativeSource={RelativeSource AncestorType=UserControl},
                                                  Mode=TwoWay}"
                                      IsEnabled="{Binding DataContext.ScaleRaw,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      ToolTip="{x:Static t:GraphTexts.ShowAfterTip}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 그룹 관리. 버튼마다 무슨 기능인지 글자로 적혀 있습니다. -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.PanelAlt}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                        Padding="8,4">
                    <!--
                      그룹 고치는 칸 — <b>낮게</b> (1.22). 단추를 작게(글자 11 · 높이 22 ·
                      여백 좁게) 하고, [위로 옮기기] [아래로 옮기기] 는 ▲ ▼ 로 줄여
                      (이름은 풍선말) 두 줄 안에 들어가게 했습니다. 위 목록이 그만큼
                      길어집니다.
                    -->
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Padding" Value="6,1" />
                                <Setter Property="MinHeight" Value="22" />
                                <Setter Property="Margin" Value="0,1,3,1" />
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="{Binding ActiveGroupText}" Style="{StaticResource Muted}"
                                   FontSize="11" Margin="2,0,0,2" />
                        <WrapPanel>
                            <Button Content="{x:Static t:GraphTexts.AddGroup}" Click="OnAddGroup" />
                            <Button Content="{x:Static t:GraphTexts.RenameGroup}" Click="OnRenameGroup" />
                            <Button Content="{x:Static t:GraphTexts.MoveGroupUp}" Click="OnMoveGroupUp"
                                    ToolTip="{x:Static t:GraphTexts.MoveGroupUpTip}" />
                            <Button Content="{x:Static t:GraphTexts.MoveGroupDown}" Click="OnMoveGroupDown"
                                    ToolTip="{x:Static t:GraphTexts.MoveGroupDownTip}" />
                            <Button Content="{x:Static t:GraphTexts.PutSelected}" Click="OnPutSelected" />
                            <Button Content="{x:Static t:GraphTexts.DeleteGroup}" Click="OnDeleteGroup" />
                            <Button Content="{x:Static t:GraphTexts.CopyGroupFile}" Click="OnCopyGroupFile"
                                    ToolTip="{x:Static t:GraphTexts.CopyGroupFileTip}" />
                        </WrapPanel>

                        <!-- 그룹이 groups.txt 로 정해져 있을 때만 나옵니다. -->
                        <TextBlock Text="{Binding GroupSourceNote}" Style="{StaticResource Muted}"
                                   FontSize="10" TextWrapping="Wrap" Margin="2,2,2,0"
                                   Visibility="{Binding GroupSourceNote,
                                                Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- 목록 본체. 줄이 수천 개여도 보이는 만큼만 만들어집니다. -->
                <ListBox x:Name="RowList" ItemsSource="{Binding Rows}"
                         ItemContainerStyle="{StaticResource PlainRow}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.Resources>

                        <!-- 그룹 이름 줄 -->
                        <DataTemplate DataType="{x:Type graph:GroupRowVm}">
                            <Border x:Name="Row" Background="{DynamicResource Brush.PanelAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                                    Padding="6,4" AllowDrop="True"
                                    MouseLeftButtonDown="OnGroupRowDown"
                                    DragOver="OnGroupDragOver"
                                    DragLeave="OnGroupDragLeave"
                                    Drop="OnGroupDrop"
                                    ToolTip="{x:Static t:GraphTexts.RowTip}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Path x:Name="Arrow" Grid.Column="0" VerticalAlignment="Center"
                                          Margin="2,0,7,0" Width="9" Height="9"
                                          Fill="{DynamicResource Brush.Muted}"
                                          Data="M 0 0 L 9 0 L 4.5 6 Z" />

                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0,0,7,0"
                                              IsChecked="{Binding IsAllSelected, Mode=OneWay}"
                                              Click="OnGroupCheck"
                                              ToolTip="{x:Static t:GraphTexts.IsAllSelectedTip}" />

                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="3" Text="{Binding MemberText}" FontSize="11"
                                               VerticalAlignment="Center" Margin="6,0,2,0"
                                               Foreground="{DynamicResource Brush.Muted}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                    <Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 6 4.5 L 0 9 Z" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                    <Setter TargetName="Row" Property="Background"
                                            Value="{DynamicResource Brush.DropTarget}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>

                        <!-- IO 한 줄 -->
                        <DataTemplate DataType="{x:Type graph:IoRowVm}">
                            <Border x:Name="Row" Background="Transparent" Padding="22,3,6,3"
                                    MouseLeftButtonDown="OnIoRowDown"
                                    MouseMove="OnIoRowMove">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,7,0"
                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Click="OnIoCheck" />

                                    <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.Text}" />

                                    <TextBlock Grid.Column="2" Text="{Binding SideNote}" FontSize="11"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               Foreground="{DynamicResource Brush.Muted}" />

                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Row" Property="Background"
                                            Value="{DynamicResource Brush.AccentSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static graph:IoRowVm.StatusChanged}">
                                    <Setter TargetName="NameText" Property="Foreground"
                                            Value="{DynamicResource Brush.Warn}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static graph:IoRowVm.StatusOnlyBefore}">
                                    <Setter TargetName="NameText" Property="Foreground"
                                            Value="{DynamicResource Brush.Bad}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static graph:IoRowVm.StatusOnlyAfter}">
                                    <Setter TargetName="NameText" Property="Foreground"
                                            Value="{DynamicResource Brush.Good}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>

                    </ListBox.Resources>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="Transparent" />

        <!-- ================= 오른쪽: 도구 줄 + 그래프 ================= -->
        <DockPanel Grid.Column="2">

            <!--
              도구 줄.

              <b>두 줄을 넘지 않습니다.</b> WrapPanel 은 좁아지면 저절로 줄을
              바꾸는데, 단추가 많으면 다섯 줄 여섯 줄로 자라서 정작 그래프가
              들어갈 자리가 없어집니다. 그래서 세 가지를 했습니다.

                1. 글자를 줄였습니다. 무슨 뜻인지는 풍선 도움말에 적습니다.
                2. 한 번 정해 놓고 쓰는 것들(시간 맞추기)은 접어서
                   팝업으로 넘겼습니다.
                3. "무엇을 그릴까" (그릴 로그)는 <b>왼쪽 IO 칸</b>으로 옮겼습니다.
                   IO 를 고르는 일과 같은 종류라 그쪽이 제자리이고, 도구 줄은
                   그만큼 짧아집니다.

              그래도 창이 아주 좁으면 더 접힐 수 있어서, 높이 상한을 걸고
              넘치면 세로로 굴리게 했습니다. 줄 하나가 42 (단추 28 + 위아래
              여백 6 + 묶음 테두리 2) 라 두 줄이면 84 입니다. 여기에 글꼴
              차이만큼 몇 px 만 얹습니다 — 넉넉히 주면 세 번째 줄이 반쯤
              보여서 상한을 건 뜻이 없어집니다. 바깥 Border 의 안쪽 여백은
              이 상한 밖이라 더하지 않습니다.
            -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                    Padding="8,4">
                <ScrollViewer MaxHeight="88" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <!--
                  <b>두 줄로 나눠 둡니다</b> (1.20). 한 WrapPanel 에 다 넣으면 창 폭에
                  따라 접히는 자리가 달라져 묶음이 이 줄 저 줄로 흩어졌습니다.
                    1 줄: 어떻게 보나   — 보기 · 세로 눈금 · Time Scale · Value Scale
                    2 줄: 무엇을 견주나 — 비교 · 정렬(단계) · 시간 맞추기
                  창이 아주 좁으면 그 줄 안에서만 더 접힙니다.
                -->
                <StackPanel>
                <WrapPanel>

                    <!--
                      무엇을 어떻게 늘어놓을지. IO 를 하나만 골랐을 때는 둘이
                      같은 그림이라, 묶음 이름에 "여러 IO 선택시" 를 적어 둡니다.
                    -->
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolGroupCaption}" Text="{x:Static t:GraphTexts.LaneModeCaption}" />
                            <RadioButton GroupName="viewmode" Style="{StaticResource SegmentButton}"
                                         Content="{x:Static t:GraphTexts.LaneMode}" IsChecked="{Binding LaneMode, Mode=TwoWay}"
                                         ToolTip="{x:Static t:GraphTexts.LaneModeTip}" />
                            <RadioButton GroupName="viewmode" Style="{StaticResource SegmentButton}"
                                         Content="{x:Static t:GraphTexts.OverlayMode}" IsChecked="{Binding OverlayMode, Mode=TwoWay}"
                                         ToolTip="{x:Static t:GraphTexts.OverlayModeTip}" />
                            <RadioButton GroupName="viewmode" Style="{StaticResource SegmentButton}"
                                         Content="{x:Static t:GraphTexts.GalleryMode}" IsChecked="{Binding GalleryMode, Mode=TwoWay}"
                                         ToolTip="{x:Static t:GraphTexts.GalleryModeTip}" />
                        </StackPanel>
                    </Border>

                    <!-- 세로축을 무엇으로 읽을지 -->
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolGroupCaption}" Text="{x:Static t:GraphTexts.ScaleRawCaption}" />
                            <RadioButton GroupName="scale" Style="{StaticResource SegmentButton}"
                                         Content="{x:Static t:GraphTexts.ScaleRaw}" IsChecked="{Binding ScaleRaw, Mode=TwoWay}"
                                         ToolTip="{x:Static t:GraphTexts.ScaleRawTip}" />
                            <RadioButton GroupName="scale" Style="{StaticResource SegmentButton}"
                                         Content="{x:Static t:GraphTexts.ScaleDelta}" IsChecked="{Binding ScaleDelta, Mode=TwoWay}"
                                         ToolTip="{x:Static t:GraphTexts.ScaleDeltaTip}" />
                        </StackPanel>
                    </Border>

                    <!--
                      가로(시간) 축.

                      + / − 는 글자가 아니라 기호라 폭이 항상 같습니다. "확대"
                      와 "축소" 처럼 글자 수가 다른 것을 나란히 두면 단추 폭이
                      들쭉날쭉해서 두 묶음이 서로 어긋나 보입니다.
                    -->
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolGroupCaption}" Text="{x:Static t:GraphTexts.ZoomTimeInCaption}" />
                            <Button Content="{x:Static t:GraphTexts.ZoomTimeIn}" Width="30" Click="OnZoomTimeIn"
                                    ToolTip="{x:Static t:GraphTexts.ZoomTimeInTip}" />
                            <Button Content="{x:Static t:GraphTexts.ZoomTimeOut}" Width="30" Click="OnZoomTimeOut"
                                    ToolTip="{x:Static t:GraphTexts.ZoomTimeOutTip}" />
                            <Button Content="{x:Static t:GraphTexts.ResetTime}" Click="OnResetTime"
                                    ToolTip="{x:Static t:GraphTexts.ResetTimeTip}" />
                        </StackPanel>
                    </Border>

                    <!-- 세로(값) 축 -->
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolGroupCaption}" Text="{x:Static t:GraphTexts.ZoomValueInCaption}" />
                            <Button Content="{x:Static t:GraphTexts.ZoomValueIn}" Width="30" Click="OnZoomValueIn"
                                    ToolTip="{x:Static t:GraphTexts.ZoomValueInTip}" />
                            <Button Content="{x:Static t:GraphTexts.ZoomValueOut}" Width="30" Click="OnZoomValueOut"
                                    ToolTip="{x:Static t:GraphTexts.ZoomValueOutTip}" />
                            <Button Content="{x:Static t:GraphTexts.ResetValueZoom}" Click="OnResetValueZoom"
                                    ToolTip="{x:Static t:GraphTexts.ResetValueZoomTip}" />
                            <Button Content="{x:Static t:GraphTexts.FitValueOnce}" Click="OnFitValueOnce"
                                    ToolTip="{x:Static t:GraphTexts.FitValueOnceTip}" />
                            <ToggleButton Style="{StaticResource ToolToggle}" Content="{x:Static t:GraphTexts.FitVisible}"
                                          IsChecked="{Binding FitVisible, Mode=TwoWay}"
                                          ToolTip="{x:Static t:GraphTexts.FitVisibleTip}" />
                        </StackPanel>
                    </Border>

                </WrapPanel>
                <WrapPanel>

                    <!-- 이전 로그와 이후 로그를 견주는 것들 -->
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolGroupCaption}" Text="{x:Static t:GraphTexts.ShadeDifferenceCaption}" />
                            <!--
                              둘은 <b>같이 켜지지 않습니다.</b> 하나를 켜면 다른
                              하나가 꺼집니다 (뷰모델에서 막습니다). 벌려 놓고
                              그 사이를 칠하면, 칠해진 넓이가 "값 차이" 가 아니라
                              "값 차이 + 벌린 간격" 이 되어 눈금을 거짓말하게
                              만들기 때문입니다.

                              둘 다 끌 수는 있습니다. 켜져 있는 것을 다시 누르면
                              꺼집니다.
                            -->
                            <ToggleButton Style="{StaticResource ToolToggle}" Content="{x:Static t:GraphTexts.ShadeDifference}"
                                          IsChecked="{Binding ShadeDifference, Mode=TwoWay}"
                                          ToolTip="{x:Static t:GraphTexts.ShadeDifferenceTip}" />
                            <ToggleButton Style="{StaticResource ToolToggle}" Content="{x:Static t:GraphTexts.SeparateTraces}"
                                          IsChecked="{Binding SeparateTraces, Mode=TwoWay}"
                                          ToolTip="{x:Static t:GraphTexts.SeparateTracesTip}" />
                            <TextBlock Style="{StaticResource ToolGroupCaption}" Text="{x:Static t:GraphTexts.RelativeTolerancePercentTextCaption}" Margin="10,0,6,0" />
                            <TextBox Width="52"
                                     Text="{Binding RelativeTolerancePercentText, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="{Binding ToleranceHintDetail}" />
                            <TextBlock Style="{StaticResource ToolGroupCaption}" Text="{x:Static t:GraphTexts.Caption}" Margin="5,0,2,0"
                                       ToolTip="{Binding ToleranceHintDetail}" />
                        </StackPanel>
                    </Border>

                    <!--
                      ================= 정렬 (단계) (1.16) =================

                      [정렬] [단계마다] [전체 구간 ▼]

                      [단계마다]     켜고 끄는 단추. 켜면 가로가 단계 칸 여러 개로
                                     나뉘고, 칸마다 그 단계의 시작끼리 맞춥니다.
                                     칸 머리(그림 위 단계 이름)를 누르면 그 단계
                                     하나만, 한 번 더 누르면 모든 칸으로.
                      [전체 구간 ▼]  목록: 전체 구간 · 1 · 2 · … 하나를 고르면 그
                                     단계만 봅니다 (두 로그는 그 단계 시작끼리).
                                     [단계마다] 를 켠 채로 고르면 그 칸 하나만.

                      1.15 에 [단계마다][전체 구간] 둘로 줄였다가, 단계 하나씩 보는
                      목록이 다시 필요하다고 하셔서 [전체 구간] 을 목록으로 바꿨습니다.

                      <b>글자는 여기 적지 않습니다.</b> src/LogScope/Analysis1/LogFile/
                      LogSteps.cs (StepText) 한 곳에 있고, 단계 이름 앞뒤에 붙는 글도 거기서
                      고칩니다.
                    -->
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolGroupCaption}"
                                       Text="{x:Static t:GraphTexts.StepCaption}" />
                            <ToggleButton Style="{StaticResource ToolToggle}"
                                          Content="{x:Static t:GraphTexts.StepEach}"
                                          IsChecked="{Binding Step.SplitByStep, Mode=TwoWay}"
                                          IsEnabled="{Binding Step.HasSteps}"
                                          ToolTipService.ShowOnDisabled="True"
                                          ToolTip="{x:Static t:GraphTexts.SplitByStepTip}" />
                            <ComboBox MinWidth="130" Margin="3,0,0,0"
                                      ItemsSource="{Binding Step.Choices}"
                                      SelectedIndex="{Binding Step.PickIndex, Mode=TwoWay}"
                                      IsEnabled="{Binding Step.CanPickNow}"
                                      ToolTipService.ShowOnDisabled="True"
                                      ToolTip="{x:Static t:GraphTexts.PickIndexTip}" />
                        </StackPanel>
                    </Border>

                    <!--
                      시간 맞추기. 콤보 두 개와 입력 칸을 도구 줄에
                      펴면 그것만으로 한 줄을 다 먹습니다. 한 번 정해 놓고
                      계속 쓰는 값들이라 팝업으로 접어 둡니다.
                    -->
                    <Border Style="{StaticResource ToolGroup}">
                        <StackPanel x:Name="AlignAnchor" Orientation="Horizontal">
                            <!--
                              토글이 아니라 그냥 단추입니다. 토글로 두면
                              팝업이 열린 채 그 단추를 눌렀을 때 팝업이 먼저
                              닫히면서 단추는 다시 켜져, 눌러도 안 닫히는
                              것처럼 보입니다. 열기만 맡기고 닫기는 바깥
                              누름과 [닫기] 에 맡깁니다.

                              글자 폭을 고정합니다. 상태에 따라 글이 바뀌는데
                              폭까지 바뀌면 그때마다 도구 줄이 다시 접혀
                              줄 수가 달라집니다.
                            -->
                            <Button Content="{Binding Align.Summary}" Width="130"
                                    Click="OnAlignOpen"
                                    ToolTip="{x:Static t:GraphTexts.AlignOpenTip}" />
                            <Popup x:Name="AlignPopup" PlacementTarget="{Binding ElementName=AlignAnchor}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                   Closed="OnAlignPopupClosed">
                                <align:AlignPanel DataContext="{Binding Align}"
                                                  CloseRequested="OnAlignPanelClose" />
                            </Popup>
                        </StackPanel>
                    </Border>

                </WrapPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 아래 띠: 커서 값과 보이는 구간 -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                    Padding="12,5">
                <StackPanel>
                    <TextBlock Text="{Binding ReadoutText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text}" />
                    <!-- 커서 값 아래에 있던 설명 줄들(시간 맞추기 결과 · 그룹만
                         보는 중 · 단계 맞춘 결과 · 마우스 쓰는 법)은 1.15 에서
                         뺐습니다. 쓰는 법은 README 단축키 표에 있습니다. -->
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <graph:GraphCanvas x:Name="Plot" Grid.Column="0" />

                <ScrollBar Grid.Column="1" Orientation="Vertical" Minimum="0"
                           SmallChange="40" LargeChange="200"
                           Maximum="{Binding ScrollMaximum, ElementName=Plot, Mode=OneWay}"
                           ViewportSize="{Binding ScrollViewport, ElementName=Plot, Mode=OneWay}"
                           Value="{Binding VerticalOffset, ElementName=Plot, Mode=TwoWay}"
                           ToolTip="{x:Static t:GraphTexts.VerticalOffsetTip}" />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
