<?xml version="1.0" encoding="utf-8"?>
<!-- 커밋 해시 · 수정됨 · 빌드 시각을 프로그램 안에 넣습니다 (1.25).

     버전은 여기서 다루지 않습니다 — 저장소 루트 version.txt 를 csproj 가 그대로
     리소스로 넣고, src/LogScope/BuildInfo.cs 가 실행할 때 읽습니다.

     1.24 까지는 여기서 BuildInfo.g.cs (코드)를 만들어 끼워 넣었습니다. WPF 가 XAML 을
     컴파일하며 따로 도는 임시 빌드 · VS 의 IntelliSense 빌드에서 그 파일이 빠져
     "BuildInfo 가 없다" 가 났습니다. 이제 여기서는 <b>글 파일 하나</b>만 obj 에 쓰고
     리소스로 넣습니다. 코드는 아무것도 만들지 않으므로 이 타깃이 안 돌거나 실패해도
     컴파일 오류가 나지 않습니다 (커밋이 "unknown" 으로 보일 뿐). 모든 작업에
     ContinueOnError 를 걸어 빌드를 멈추지 않습니다.

     <b>프로그램 이름은 여기서 다루지 않습니다.</b> 실행할 때 읽는 config.txt 의
     name 줄입니다 (Settings/AppConfig.cs). 설정 파일과 기록 폴더 이름도 이름을
     따라가지 않습니다 (SettingsStore / HistoryStore). -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
    <BuildStampFile>$(IntermediateOutputPath)BuildStamp.txt</BuildStampFile>
  </PropertyGroup>

  <Target Name="WriteBuildStamp" BeforeTargets="BeforeBuild"
          Condition=" '$(AssemblyName)' == 'LogScope' ">
    <Exec Command="git -C &quot;$(RepoRoot).&quot; rev-parse --short=12 HEAD"
          ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitHash" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExit" />
    </Exec>
    <Exec Command="git -C &quot;$(RepoRoot).&quot; status --porcelain --untracked-files=no"
          ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDirty" />
    </Exec>

    <PropertyGroup>
      <_Commit Condition=" '$(_GitExit)' == '0' ">$(_GitHash.Trim())</_Commit>
      <_Commit Condition=" '$(_Commit)' == '' ">unknown</_Commit>
      <_Dirty>false</_Dirty>
      <_Dirty Condition=" '$(_GitDirty)' != '' ">true</_Dirty>
      <_BuiltAt>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm"))</_BuiltAt>
    </PropertyGroup>

    <MakeDir Directories="$(IntermediateOutputPath)" ContinueOnError="true" />
    <WriteLinesToFile File="$(BuildStampFile)" Lines="$(_Commit)|$(_Dirty)|$(_BuiltAt)"
                      Overwrite="true" ContinueOnError="true" />
    <ItemGroup Condition="Exists('$(BuildStampFile)')">
      <EmbeddedResource Include="$(BuildStampFile)">
        <LogicalName>LogScope.BuildStamp.txt</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
