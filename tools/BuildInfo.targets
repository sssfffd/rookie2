<?xml version="1.0" encoding="utf-8"?>
<!-- 버전은 저장소 루트의 version.txt 한 곳에만 있습니다. 빌드할 때마다
     여기서 BuildInfo.g.cs 를 만들어 그 값과 git 커밋 해시를 코드에 넣습니다.
     git 이 없으면 해시는 "unknown" 입니다.

     <b>프로그램 이름은 여기서 다루지 않습니다.</b> 실행할 때 읽는
     config.txt 의 name 줄입니다 (Settings/AppConfig.cs). 버전은 빌드할 때
     박혀야 하는 값이고 이름은 아니라서, 둘을 같은 자리에서 다루지 않습니다.

     설정 파일과 기록 폴더 이름은 이름을 <b>따라가지 않습니다</b>
     (SettingsStore / HistoryStore). 이름을 바꿨다고 그때까지 쌓인 설정과
     기록을 못 찾으면 안 되기 때문입니다. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
    <BuildInfoFile>$(MSBuildThisFileDirectory)..\src\LogScope\BuildInfo.g.cs</BuildInfoFile>
  </PropertyGroup>

  <!-- 1.23: LogScope (WPF) 프로젝트 하나가 됐으므로 <b>빌드 맨 처음(BeforeBuild)</b>에
       만들고, csproj 에는 BuildInfo.g.cs 를 늘 적어 둡니다 (Compile Include).
       WPF 는 XAML 을 컴파일하면서 임시 프로젝트(…_wpftmp)를 한 번 더 빌드하는데,
       그 빌드는 BeforeCompile 을 거치지 않습니다. 전처럼 여기서 Compile 을 더하면
       임시 빌드에는 이 파일이 빠져 "BuildInfo 가 없다" 로 실패합니다.
       조건은 프로젝트 파일 이름이 아니라 AssemblyName 으로 봅니다 — 임시 프로젝트는
       파일 이름이 다릅니다. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeBuild"
          Condition=" '$(AssemblyName)' == 'LogScope' ">
    <ReadLinesFromFile File="$(RepoRoot)version.txt">
      <Output TaskParameter="Lines" ItemName="_VersionLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_RawVersion>@(_VersionLines)</_RawVersion>
      <AppVersion>$(_RawVersion.Trim())</AppVersion>
      <AppVersion Condition=" '$(AppVersion)' == '' ">0.00</AppVersion>
    </PropertyGroup>

    <Exec Command="git -C &quot;$(RepoRoot).&quot; rev-parse --short=12 HEAD"
          ConsoleToMSBuild="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitHash" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExit" />
    </Exec>
    <Exec Command="git -C &quot;$(RepoRoot).&quot; status --porcelain --untracked-files=no"
          ConsoleToMSBuild="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDirty" />
    </Exec>

    <PropertyGroup>
      <CommitHash Condition=" '$(_GitExit)' == '0' ">$(_GitHash.Trim())</CommitHash>
      <CommitHash Condition=" '$(CommitHash)' == '' ">unknown</CommitHash>
      <IsDirty>false</IsDirty>
      <IsDirty Condition=" '$(_GitDirty)' != '' ">true</IsDirty>
      <BuiltAt>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm"))</BuiltAt>
    </PropertyGroup>

    <ItemGroup>
      <_BuildInfoLines Include="// Generated by tools/BuildInfo.targets - do not edit." />
      <_BuildInfoLines Include="// Values come from version.txt at the repo root and from git." />
      <_BuildInfoLines Include="namespace LogScope" />
      <_BuildInfoLines Include="{" />
      <_BuildInfoLines Include="    public static class BuildInfo" />
      <_BuildInfoLines Include="    {" />
      <_BuildInfoLines Include="        public const string Version = &quot;$(AppVersion)&quot;%3B" />
      <_BuildInfoLines Include="        public const string Commit = &quot;$(CommitHash)&quot;%3B" />
      <_BuildInfoLines Include="        public const bool  Modified = $(IsDirty)%3B" />
      <_BuildInfoLines Include="        public const string BuiltAt = &quot;$(BuiltAt)&quot;%3B" />
      <_BuildInfoLines Include="    }" />
      <_BuildInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(BuildInfoFile)" Lines="@(_BuildInfoLines)" Overwrite="true" Encoding="UTF-8" />
  </Target>
</Project>
